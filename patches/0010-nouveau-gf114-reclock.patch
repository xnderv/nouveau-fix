 		drm_hdmi_avi_infoframe_quant_range(&infoframe.avi, &nv_connector->base, mode,
 						   HDMI_QUANTIZATION_RANGE_FULL);
+		/* GF114: the NVIDIA driver flags the picture as IT content
+		 * (ITC=1, content type graphics), which tells the monitor to
+		 * skip its video processing; do the same.
+		 */
+		if (nvkm_gf114_board(nvxx_device(drm)))
+			infoframe.avi.itc = true;
 
 		size = hdmi_infoframe_pack(&infoframe, args->data, data_len);
 	} else {
diff -ruN a/include/nvkm/core/gf114.h b/include/nvkm/core/gf114.h
--- a/include/nvkm/core/gf114.h	1970-01-01 03:00:00.000000000 +0300
+++ b/include/nvkm/core/gf114.h	2026-10-22 14:04:33.143636441 +0300
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef __NVKM_GF114_H__
+#define __NVKM_GF114_H__
+#include <core/device.h>
+
+/* Board-specific reclocking support for GF114 (GeForce GTX 560 Ti).
+ *
+ * The memory reclock sequences, PLL quirks and the PMU load governor were
+ * derived from an mmiotrace of the NVIDIA 390 driver on one particular board
+ * (Gigabyte 1458:3515) and are only enabled on that board unless the user
+ * overrides it with nouveau.gf114_board=1.  Everything else behaves exactly
+ * like upstream nouveau.
+ */
+bool nvkm_gf114_board(struct nvkm_device *);
+#endif
