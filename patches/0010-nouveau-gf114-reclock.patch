  * Authors: Ben Skeggs
  */
 
+/* PERF: учёт загрузки видеокарты, как в прошивке PMU драйвера NVIDIA (Fermi).
+ * ПОСЛЕ ЗАГРУЗКИ ПРОЦЕСС СПИТ: ни счётчиков, ни таймера — прошивка ведёт себя как раньше.
+ * Работать он начинает только по команде драйвера PERF_MSG_START (data0 = период в тактах).
+ * Счётчики простоя/занятости PMU настраиваются так же, как их настраивает драйвер NVIDIA 390
+ * на GF114: счётчик 1 — видео, счётчик 3 — графика + копирование, счётчик 7 — все такты.
+ * Процесс раз в ~100 мс читает счётчики (они 31-битные и переполняются примерно за 10 с,
+ * поэтому разница считается с учётом переполнения) и копит суммы. По запросу драйвера
+ * (PERF_MSG_LOAD) отвечает загрузкой графики и видео в промилле за время с прошлого запроса
+ * и обнуляет суммы. Решение о смене режима принимает драйвер, как у NVIDIA.
+ */
+#define PERF_MSG_LOAD  0x44414f4c
+#define PERF_MSG_START 0x54525453
+
 #ifdef INCLUDE_PROC
 process(PROC_PERF, #perf_init, #perf_recv)
 #endif
@@ -30,6 +43,16 @@
  * PERF data segment
  *****************************************************************************/
 #ifdef INCLUDE_DATA
+// данные лежат далеко (после буферов memx), поэтому обращаемся через базу $r6 = #perf_data
+perf_data:
+.b32 0	// 0x00 last_total
+.b32 0	// 0x04 last_gr
+.b32 0	// 0x08 last_vid
+.b32 0	// 0x0c acc_total
+.b32 0	// 0x10 acc_gr
+.b32 0	// 0x14 acc_vid
+.b32 0	// 0x18 samples
+.b32 0	// 0x1c ticks: период замеров; 0 — процесс спит
 #endif
 
 /******************************************************************************
@@ -37,8 +60,60 @@
  *****************************************************************************/
 #ifdef INCLUDE_CODE
 
-// description
-//
+// прочитать счётчик, прибавить разницу с прошлым чтением (по модулю 2^31) к сумме
+// $r5 - 0x7fffffff, $r6 - #perf_data, портит $r1 $r2
+#define perf_acc(ior,last,acc) /*
+*/	nv_iord($r1, ior) /*
+*/	ld b32 $r2 D[$r6 + last] /*
+*/	st b32 D[$r6 + last] $r1 /*
+*/	sub b32 $r1 $r2 /*
+*/	and $r1 $r5 /*
+*/	ld b32 $r2 D[$r6 + acc] /*
+*/	add b32 $r2 $r1 /*
+*/	st b32 D[$r6 + acc] $r2
+
+// запомнить текущие значения счётчиков, обнулить суммы
+perf_snap:
+	mov $r6 #perf_data
+	nv_iord($r1, 0x578)
+	st b32 D[$r6 + 0x00] $r1
+	nv_iord($r1, 0x538)
+	st b32 D[$r6 + 0x04] $r1
+	nv_iord($r1, 0x518)
+	st b32 D[$r6 + 0x08] $r1
+	st b32 D[$r6 + 0x0c] $r0
+	st b32 D[$r6 + 0x10] $r0
+	st b32 D[$r6 + 0x14] $r0
+	st b32 D[$r6 + 0x18] $r0
+	ret
+
+// один замер: добавить приращения счётчиков к суммам
+perf_sample:
+	mov $r6 #perf_data
+	imm32($r5, 0x7fffffff)
+	perf_acc(0x578, 0x00, 0x0c)
+	perf_acc(0x538, 0x04, 0x10)
+	perf_acc(0x518, 0x08, 0x14)
+	// драйвер давно не спрашивал (сумма > 2^30 тактов, ~5 с) — делим все суммы пополам,
+	// доля загрузки от этого не меняется, а переполнения не будет
+	ld b32 $r1 D[$r6 + 0x0c]
+	imm32($r2, 0x40000000)
+	cmp b32 $r1 $r2
+	bra l #perf_sample_count
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x0c] $r1
+		ld b32 $r1 D[$r6 + 0x10]
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x10] $r1
+		ld b32 $r1 D[$r6 + 0x14]
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x14] $r1
+	perf_sample_count:
+	ld b32 $r1 D[$r6 + 0x18]
+	add b32 $r1 1
+	st b32 D[$r6 + 0x18] $r1
+	ret
+
 // $r15 - current (perf)
 // $r14 - sender process name
 // $r13 - message
@@ -46,10 +121,99 @@
 // $r11 - data1
 // $r0  - zero
 perf_recv:
+	imm32($r1, PROC_KERN)
+	cmp b32 $r14 $r1
+	bra ne #perf_recv_host
+		// таймер: замер и следующий таймер
+		cmp b32 $r13 KMSG_ALARM
+		bra ne #perf_recv_done
+		mov $r6 #perf_data
+		ld b32 $r1 D[$r6 + 0x1c]
+		cmp b32 $r1 0
+		bra e #perf_recv_done
+		call(perf_sample)
+		mov $r6 #perf_data
+		ld b32 $r14 D[$r6 + 0x1c]
+		call(timer)
+		ret
+	perf_recv_host:
+	imm32($r1, PERF_MSG_START)
+	cmp b32 $r13 $r1
+	bra ne #perf_recv_load
+		// уже работает — только сменить период; иначе настроить счётчики и завести таймер
+		mov $r6 #perf_data
+		ld b32 $r1 D[$r6 + 0x1c]
+		st b32 D[$r6 + 0x1c] $r12
+		cmp b32 $r1 0
+		bra ne #perf_recv_done
+		cmp b32 $r12 0
+		bra e #perf_recv_done
+		call(perf_start)
+		ret
+	perf_recv_load:
+	imm32($r1, PERF_MSG_LOAD)
+	cmp b32 $r13 $r1
+	bra ne #perf_recv_done
+		// процесс спит — замер не делаем, ответ будет нулевой (0 замеров)
+		mov $r6 #perf_data
+		ld b32 $r1 D[$r6 + 0x1c]
+		cmp b32 $r1 0
+		bra e #perf_recv_answer
+		push $r14
+		push $r13
+		call(perf_sample)
+		pop $r13
+		pop $r14
+		perf_recv_answer:
+		mov $r6 #perf_data
+		// ответ: data0 = графика, промилле; data1 = видео, промилле | число замеров << 16
+		clear b32 $r12
+		clear b32 $r11
+		ld b32 $r3 D[$r6 + 0x0c]
+		div $r3 $r3 1000
+		cmp b32 $r3 0
+		bra e #perf_recv_reply
+			ld b32 $r12 D[$r6 + 0x10]
+			div $r12 $r12 $r3
+			ld b32 $r11 D[$r6 + 0x14]
+			div $r11 $r11 $r3
+		perf_recv_reply:
+		ld b32 $r4 D[$r6 + 0x18]
+		shl b32 $r4 16
+		or $r11 $r4
+		st b32 D[$r6 + 0x0c] $r0
+		st b32 D[$r6 + 0x10] $r0
+		st b32 D[$r6 + 0x14] $r0
+		st b32 D[$r6 + 0x18] $r0
+		call(send)
+	perf_recv_done:
+	ret
+
+// запуск по команде драйвера: счётчики как у NVIDIA, снимок, таймер
+// $r12 - период в тактах
+perf_start:
+	// счётчики PMU — как у драйвера NVIDIA 390 на GF114
+	imm32($r1, 0x00000070)
+	nv_iowr(0x514, $r1)
+	imm32($r1, 0x00180001)
+	nv_iowr(0x534, $r1)
+	mov $r1 0x80
+	nv_iowr(0x544, $r1)
+	imm32($r1, 0x20000000)
+	nv_iowr(0x554, $r1)
+	mov $r1 2
+	nv_iowr(0x51c, $r1)
+	nv_iowr(0x53c, $r1)
+	nv_iowr(0x54c, $r1)
+	nv_iowr(0x55c, $r1)
+	mov $r1 3
+	nv_iowr(0x57c, $r1)
+	call(perf_snap)
+	mov b32 $r14 $r12
+	call(timer)
 	ret
 
-// description
-//
+// после загрузки процесс спит
 // $r15 - current (perf)
 // $r0  - zero
 perf_init:
