 	case 0x1370e0:
 		sclk = read_div(clk, (pll & 0xff) / 0x20, 0x137120, 0x137140);
+		if (pll == 0x1370e0 && gf114_quirks(clk) && gf114_pll_ref(clk, 7))
+			sclk = gf114_pll_ref(clk, 7);
 		break;
 	default:
 		return 0;
@@ -259,6 +288,8 @@
 		return 0;
 
 	limits.refclk = read_div(clk, idx, 0x137120, 0x137140);
+	if (idx > 2 && gf114_quirks(clk) && gf114_pll_ref(clk, idx))
+		limits.refclk = gf114_pll_ref(clk, idx);
 	if (!limits.refclk)
 		return 0;
 
@@ -351,15 +382,78 @@
 	}
 }
 
+/* PTHERM clock slowdown (FSRM) around a source switch of the GPC (idx 0) and
+ * hubk06 (idx 7) clocks, as the NVIDIA driver does on GF114: engage the
+ * slowdown of that domain with the threshold-driven slowdowns masked, wait
+ * until FSRM_STATUS reports it active, switch the mux, then restore.
+ * Switching a busy GPC between the divider and the PLL without it can wedge
+ * PGRAPH (GPC/ROP busy forever, no traps); observed on 1458:3515 under load.
+ */
+struct gf114_fsrm {
+	bool on;
+	int i;
+	u32 ctrl1, fsrm2, fsrm3, fsrm4;
+};
+
+static void
+gf114_fsrm_enter(struct gf100_clk *clk, int idx, struct gf114_fsrm *f)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 code;
+
+	f->on = false;
+	if (!gf114_quirks(clk) || (idx != 0 && idx != 7))
+		return;
+
+	f->i = (idx == 0) ? 0 : 1;
+	code = (idx == 0) ? 0x0a : 0x02;
+	f->ctrl1 = nvkm_rd32(device, 0x020004);
+	f->fsrm2 = nvkm_rd32(device, 0x020160 + f->i * 4);
+	f->fsrm3 = nvkm_rd32(device, 0x020180 + f->i * 4);
+	f->fsrm4 = nvkm_rd32(device, 0x0201a0 + f->i * 4);
+
+	nvkm_wr32(device, 0x020160 + f->i * 4, (idx == 0) ? 0x000a008a : 0x00020082);
+	nvkm_wr32(device, 0x020180 + f->i * 4, code);
+	nvkm_wr32(device, 0x0201a0 + f->i * 4, 0x00004040);
+	nvkm_wr32(device, 0x020004, f->ctrl1 & ~0x00000068);
+	f->on = true;
+
+	if (nvkm_usec(device, 100,
+		NVKM_DELAY
+		if ((nvkm_rd32(device, 0x0201e0 + f->i * 4) & 0x0002003f) == (0x00020000 | code))
+			break;
+	) < 0)
+		nvkm_warn(&clk->base.subdev, "FSRM %d slowdown not engaged (%08x)\n",
+			  f->i, nvkm_rd32(device, 0x0201e0 + f->i * 4));
+}
+
+static void
+gf114_fsrm_leave(struct gf100_clk *clk, struct gf114_fsrm *f)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+
+	if (!f->on)
+		return;
+	nvkm_wr32(device, 0x020160 + f->i * 4, f->fsrm2);
+	nvkm_wr32(device, 0x020180 + f->i * 4, f->fsrm3);
+	nvkm_wr32(device, 0x0201a0 + f->i * 4, f->fsrm4);
+	nvkm_wr32(device, 0x020004, f->ctrl1);
+	f->on = false;
+}
+
 static void
 gf100_clk_prog_1(struct gf100_clk *clk, int idx)
 {
 	struct nvkm_device *device = clk->base.subdev.device;
+	struct gf114_fsrm fsrm;
+
+	gf114_fsrm_enter(clk, idx, &fsrm);
 	nvkm_mask(device, 0x137100, (1 << idx), 0x00000000);
 	nvkm_msec(device, 2000,
 		if (!(nvkm_rd32(device, 0x137100) & (1 << idx)))
 			break;
 	);
+	gf114_fsrm_leave(clk, &fsrm);
 }
 
 static void
@@ -377,11 +471,17 @@
 
 			/* Test PLL lock */
 			nvkm_mask(device, addr + 0x00, 0x00000010, 0x00000000);
-			nvkm_msec(device, 2000,
+			if (nvkm_msec(device, 2000,
 				if (nvkm_rd32(device, addr + 0x00) & 0x00020000)
 					break;
-			);
-			nvkm_mask(device, addr + 0x00, 0x00000010, 0x00000010);
+			) < 0)
+				nvkm_error(&clk->base.subdev, "PLL %02x not locked (ctrl %08x coef %08x)\n",
+					   idx, nvkm_rd32(device, addr + 0x00), info->coef);
+			/* The NVIDIA driver never sets bit 4 here on GF114; with it set the
+			 * core PLL at 900 MHz hangs the GPU (observed on 1458:3515).
+			 */
+			if (!gf114_quirks(clk))
+				nvkm_mask(device, addr + 0x00, 0x00000010, 0x00000010);
 
 			/* Enable sync mode */
 			nvkm_mask(device, addr + 0x00, 0x00000004, 0x00000004);
@@ -395,12 +495,16 @@
 	struct gf100_clk_info *info = &clk->eng[idx];
 	struct nvkm_device *device = clk->base.subdev.device;
 	if (info->ssel) {
+		struct gf114_fsrm fsrm;
+
+		gf114_fsrm_enter(clk, idx, &fsrm);
 		nvkm_mask(device, 0x137100, (1 << idx), info->ssel);
 		nvkm_msec(device, 2000,
 			u32 tmp = nvkm_rd32(device, 0x137100) & (1 << idx);
 			if (tmp == info->ssel)
 				break;
 		);
+		gf114_fsrm_leave(clk, &fsrm);
 	}
 }
 
@@ -472,10 +576,13 @@
 	      struct nvkm_clk **pclk)
 {
 	struct gf100_clk *clk;
+	int ret;
 
 	if (!(clk = kzalloc_obj(*clk)))
 		return -ENOMEM;
 	*pclk = &clk->base;
 
-	return nvkm_clk_ctor(&gf100_clk, device, type, inst, false, &clk->base);
+	ret = nvkm_clk_ctor(&gf100_clk, device, type, inst, nvkm_gf114_board(device), &clk->base);
+	clk->base.core_first = clk->base.allow_reclock;
+	return ret;
 }
