+/******************************************************************************
+ * GF114 (GTX 560 Ti, Gigabyte 1458:3515): memory reclock by replaying the
+ * PMU scripts the NVIDIA 390 driver uploads on this board.
+ *
+ * The generic gf100 sequence below (gf100_ram_calc) was recorded from a
+ * different board years ago and does not work on this one (VRAM faults at
+ * 2004 MHz, display timeouts at 324 MHz).  Instead, for the known board, we
+ * execute the five PMU scripts the NVIDIA driver loaded (mmiotrace, 2026-10-20),
+ * translated into nouveau's memx commands:
+ *   0x21 register writes      -> WR32          0x2e delay (ns)       -> DELAY
+ *   0x00 value / 0x01 address / 0x15 mask+timeout                   -> WAIT
+ *   0x14 wait for vblank (NVIDIA waits on both heads, we wait once on the
+ *        active head, as memx does)                                  -> VBLANK
+ *   0x20 1 / 0x20 0 (stop/resume VRAM access)                        -> ENTER/LEAVE
+ *   0x34 0x0a (right after the display pause, before stopping VRAM access):
+ *        meaning unknown; gt215 nouveau waits here for 0x611200 & 3 == 0
+ *        (display fetch stopped), so we do the same (2 ms timeout)
+ *   0x34 0x0b, 0x39, 0x3a: unknown, skipped (upstream skips them too)
+ *   0x13 (script E only, argument 1000): treated as a 1 us delay
+ *   0x16 end of script.
+ * Writes to 0x611200 (display pause) are applied relative to the current
+ * value (clear/restore bits 0x30) instead of NVIDIA's absolute 0x3300/0x3330.
+ * Host-side register writes the driver issued around each script are
+ * replayed too, except the core voltage GPIO (0xe104): voltage is set by
+ * nouveau's own volt code from the VBIOS table, which yields the same VIDs.
+ *****************************************************************************/
+
+struct gf114_step {
+	const char *name;
+	const u32 *pre; int npre;	/* host writes before the script, addr/value pairs */
+	const u32 *scr; int nscr;	/* NVIDIA PMU script words */
+	const u32 *post; int npost;	/* host writes after the script */
+};
+enum { GF114_S_A, GF114_S_B, GF114_S_C, GF114_S_DC, GF114_S_D, GF114_S_E };
+static const struct gf114_step gf114_steps[] = {
+	[GF114_S_A]  = { "A 135->324", gf114_nv_preA, ARRAY_SIZE(gf114_nv_preA), gf114_nv_scrA, ARRAY_SIZE(gf114_nv_scrA), NULL, 0 },
+	[GF114_S_B]  = { "B 324->2004", gf114_nv_midAB, ARRAY_SIZE(gf114_nv_midAB), gf114_nv_scrB, ARRAY_SIZE(gf114_nv_scrB), gf114_nv_postB, ARRAY_SIZE(gf114_nv_postB) },
+	[GF114_S_C]  = { "C 2004->324", gf114_nv_preC, ARRAY_SIZE(gf114_nv_preC), gf114_nv_scrC, ARRAY_SIZE(gf114_nv_scrC), NULL, 0 },
+	[GF114_S_DC] = { "D 324 retrain (after C)", gf114_nv_midCD, ARRAY_SIZE(gf114_nv_midCD), gf114_nv_scrD, ARRAY_SIZE(gf114_nv_scrD), gf114_nv_postD, ARRAY_SIZE(gf114_nv_postD) },
+	[GF114_S_D]  = { "D 324 retrain", NULL, 0, gf114_nv_scrD, ARRAY_SIZE(gf114_nv_scrD), NULL, 0 },
+	[GF114_S_E]  = { "E 324->135", NULL, 0, gf114_nv_scrE, ARRAY_SIZE(gf114_nv_scrE), NULL, 0 },
+};
+
+static int
+gf114_cur_mhz(struct nvkm_device *device)
+{
+	if (nvkm_rd32(device, 0x1373f0) & 0x00000002)
+		return 2004;	/* memory PLL selected */
+	return 3240 / (((nvkm_rd32(device, 0x137310) >> 8) & 0x3f) + 2);
+}
+
+/* memx packs consecutive commands of one kind into one packet of <64 words */
+struct gf114_est { u32 m, sz, total; };
+static void
+gf114_est_cmd(struct gf114_est *e, u32 m, u32 size)
+{
+	if (e->sz + size >= 64 || (e->m && e->m != m)) {
+		if (e->m)
+			e->total += 1 + e->sz;
+		e->m = 0;
+		e->sz = 0;
+	}
+	e->sz += size;
+	e->m = m;
+}
+
+/* build=false: validate and count memx words; build=true: emit into memx */
+static int
+gf114_interp(struct gf100_ram *ram, struct nvkm_memx *memx, const struct gf114_step *st,
+	     bool build, u32 *words)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct gf114_est e = {};
+	u32 waddr = 0, wval = 0, i = 0;
+	bool blocked = false;
+
+	while (i < st->nscr) {
+		u32 h = st->scr[i], n = h >> 16, op = h & 0xffff, k;
+		const u32 *a = &st->scr[i + 1];
+
+		if (n == 0 || i + n > st->nscr) {
+			nvkm_error(subdev, "gf114 %s: bad script word %u (%08x)\n", st->name, i, h);
+			return -EINVAL;
+		}
+		switch (op) {
+		case 0x21:
+			for (k = 0; k + 1 < n - 1; k += 2) {
+				u32 addr = a[k], data = a[k + 1];
+
+				if (addr == 0x611200)
+					data = (data & 0x30) ? ram->r611200 : (ram->r611200 & ~0x00000030);
+				if (build)
+					nvkm_memx_wr32(memx, addr, data);
+				gf114_est_cmd(&e, 3, 2);
+			}
+			break;
+		case 0x2e:
+			if (build)
+				nvkm_memx_nsec(memx, a[0]);
+			gf114_est_cmd(&e, 5, 1);
+			break;
+		case 0x13:
+			if (build)
+				nvkm_memx_nsec(memx, a[0]);
+			gf114_est_cmd(&e, 5, 1);
+			break;
+		case 0x00:
+			wval = a[0];
+			break;
+		case 0x01:
+			waddr = a[0];
+			break;
+		case 0x15:
+			if (build)
+				nvkm_memx_wait(memx, waddr, a[0], wval, a[1]);
+			gf114_est_cmd(&e, 4, 4);
+			break;
+		case 0x14:
+			if (a[0] == 0) {
+				if (build)
+					nvkm_memx_wait_vblank(memx);
+				gf114_est_cmd(&e, 6, 1);
+				e.total += 1 + e.sz;
+				e.m = 0;
+				e.sz = 0;
+			}
+			break;
+		case 0x20:
+			if (a[0] == 1 && !blocked) {
+				if (build)
+					nvkm_memx_block(memx);
+				gf114_est_cmd(&e, 1, 0);
+				blocked = true;
+			} else if (a[0] == 0 && blocked) {
+				if (build)
+					nvkm_memx_unblock(memx);
+				gf114_est_cmd(&e, 2, 0);
+				blocked = false;
+			}
+			break;
+		case 0x34:
+			if (a[0] == 0x0a) {
+				if (build)
+					nvkm_memx_wait(memx, 0x611200, 0x00000003, 0x00000000, 2000000);
+				gf114_est_cmd(&e, 4, 4);
+			}
+			break;
+		case 0x16:
+			i = st->nscr;
+			continue;
+		case 0x39:
+		case 0x3a:
+			break;
+		default:
+			nvkm_error(subdev, "gf114 %s: unknown op %04x\n", st->name, op);
+			return -EINVAL;
+		}
+		i += n;
+	}
+	if (blocked) {
+		nvkm_error(subdev, "gf114 %s: script leaves VRAM access blocked\n", st->name);
+		return -EINVAL;
+	}
+	if (e.m)
+		e.total += 1 + e.sz;
+	*words = e.total;
+	return 0;
+}
+
+static int
+gf114_ram_calc(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct gf114_step *st;
+	u32 words;
+	int ret, i;
+
+	if (ram->plan_i >= ram->plan_n) {
+		int cur = gf114_cur_mhz(device), t = freq / 1000, tgt;
+
+		ram->plan_n = ram->plan_i = 0;
+		tgt = (t <= 200) ? 135 : (t < 1000) ? 324 : 2004;
+		if (abs(t - tgt) > 5) {
+			nvkm_error(subdev, "gf114: no recorded sequence for %d MHz\n", t);
+			return -EINVAL;
+		}
+		if (cur == 135 && tgt == 324) {
+			ram->plan[ram->plan_n++] = GF114_S_A;
+		} else if (cur == 324 && tgt == 2004) {
+			ram->plan[ram->plan_n++] = GF114_S_B;
+		} else if (cur == 135 && tgt == 2004) {
+			ram->plan[ram->plan_n++] = GF114_S_A;
+			ram->plan[ram->plan_n++] = GF114_S_B;
+		} else if (cur == 2004 && tgt == 324) {
+			ram->plan[ram->plan_n++] = GF114_S_C;
+			ram->plan[ram->plan_n++] = GF114_S_DC;
+		} else if (cur == 324 && tgt == 135) {
+			ram->plan[ram->plan_n++] = GF114_S_D;
+			ram->plan[ram->plan_n++] = GF114_S_E;
+		} else if (cur == 2004 && tgt == 135) {
+			ram->plan[ram->plan_n++] = GF114_S_C;
+			ram->plan[ram->plan_n++] = GF114_S_DC;
+			ram->plan[ram->plan_n++] = GF114_S_D;
+			ram->plan[ram->plan_n++] = GF114_S_E;
+		} else if (cur != tgt) {
+			nvkm_error(subdev, "gf114: no path %d -> %d MHz\n", cur, tgt);
+			return -EINVAL;
+		}
+		nvkm_debug(subdev, "gf114: memory %d -> %d MHz, %d step(s)\n", cur, tgt, ram->plan_n);
+		for (i = 0; i < ram->plan_n; i++) {
+			ret = gf114_interp(ram, NULL, &gf114_steps[ram->plan[i]], false, &words);
+			if (ret || words > 480) {
+				nvkm_error(subdev, "gf114: step %s unusable (ret %d, %u memx words)\n",
+					   gf114_steps[ram->plan[i]].name, ret, words);
+				ram->plan_n = 0;
+				return ret ? ret : -E2BIG;
+			}
+		}
+		if (!ram->plan_n)
+			return 0;	/* already there: prog does nothing */
+	}
+
+	st = &gf114_steps[ram->plan[ram->plan_i]];
+	ram->r611200 = nvkm_rd32(device, 0x611200);
+	ret = ram_init(&ram->fuc, ram->base.fb);
+	if (ret) {
+		ram->plan_n = ram->plan_i = 0;
+		return ret;
+	}
+	ret = gf114_interp(ram, ram->fuc.base.memx, st, true, &words);
+	if (ret) {
+		ram_exec(&ram->fuc, false);
+		ram->plan_n = ram->plan_i = 0;
+		return ret;
+	}
+	ram->armed = true;
+	return 0;
+}
+
+static void
+gf114_host_writes(struct nvkm_device *device, const u32 *l, int n)
+{
+	int i;
+
+	for (i = 0; i + 1 < n; i += 2) {
+		if (l[i] == 0x00e104)	/* core voltage GPIO: done by nvkm_volt */
+			continue;
+		nvkm_wr32(device, l[i], l[i + 1]);
+	}
+}
+
+static int
+gf114_ram_prog(struct gf100_ram *ram)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct gf114_step *st;
+	int ret;
+
+	if (!ram->armed)
+		return 0;
+	st = &gf114_steps[ram->plan[ram->plan_i]];
+	gf114_host_writes(device, st->pre, st->npre);
+	ret = ram_exec(&ram->fuc, true);
+	ram->armed = false;
+	gf114_host_writes(device, st->post, st->npost);
+	nvkm_debug(subdev, "gf114: %s done, ret %d, 0x137310=%08x 0x1373f0=%08x 0x611200=%08x\n",
+		   st->name, ret, nvkm_rd32(device, 0x137310), nvkm_rd32(device, 0x1373f0),
+		   nvkm_rd32(device, 0x611200));
+	if (ret < 0) {
+		nvkm_error(subdev, "gf114: %s failed: %d\n", st->name, ret);
+		ram->plan_n = ram->plan_i = 0;
+		return ret;
+	}
+	if (++ram->plan_i < ram->plan_n)
+		return 1;	/* more steps: nvkm_pstate_mem calls calc/prog again */
+	ram->plan_n = ram->plan_i = 0;
+	return 0;
+}
+
+static void
+gf114_ram_tidy(struct gf100_ram *ram)
+{
+	if (ram->armed) {	/* calc without prog: drop the plan */
+		ram->armed = false;
+		ram->plan_n = ram->plan_i = 0;
+	}
+}
