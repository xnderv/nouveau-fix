@@ -55,6 +60,28 @@
 	return nvkm_clk_read(&clk->base, nv_clk_src_sppll1);
 }
 
+/* Reference clock of PLL idx taking the source divider into account.
+ * Upstream only does that for idx 0..2; on GF114 the NVIDIA driver programs
+ * hubk06 (idx 7) from 405 MHz (divided), not from the raw 1620 MHz VCO.
+ */
+static u32
+gf114_pll_ref(struct gf100_clk *clk, int idx)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 ssrc = nvkm_rd32(device, 0x137120 + idx * 4);
+	u32 sctl, sdiv = 2;
+
+	if ((ssrc & 0x00000003) != 3)
+		return 0;
+	sctl = nvkm_rd32(device, 0x137140 + idx * 4);
+	if (sctl & 0x80000000) {
+		if (ssrc & 0x100)
+			sctl >>= 8;
+		sdiv = (sctl & 0x3f) + 2;
+	}
+	return (read_vco(clk, 0x137120 + idx * 4) * 2) / sdiv;
+}
+
 static u32
 read_pll(struct gf100_clk *clk, u32 pll)
 {
@@ -86,6 +113,8 @@
