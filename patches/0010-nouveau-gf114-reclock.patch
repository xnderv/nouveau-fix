-	.init = gt215_pmu_init,
-	.fini = gt215_pmu_fini,
+	.init = gf114_pmu_init,
+	.fini = gf114_pmu_fini,
 	.intr = gt215_pmu_intr,
 	.send = gt215_pmu_send,
 	.recv = gt215_pmu_recv,
