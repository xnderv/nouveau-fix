--- a/nvkm/core/gf114.c	1970-01-01 03:00:00.000000000 +0300
+++ b/nvkm/core/gf114.c	2026-10-22 14:04:33.160647688 +0300
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+#include <core/gf114.h>
+#include <core/pci.h>
+
+#include <linux/moduleparam.h>
+
+/* 0 = auto (only the board the sequences were recorded on), 1 = any GF114, -1 = off */
+static int nvkm_gf114_board_mode;
+module_param_named(gf114_board, nvkm_gf114_board_mode, int, 0444);
+MODULE_PARM_DESC(gf114_board, "GF114 reclocking: 0 = only Gigabyte 1458:3515 (default), 1 = any GF114 board, -1 = off");
+
+bool
+nvkm_gf114_board(struct nvkm_device *device)
+{
+	struct nvkm_device_pci *pci;
+
+	if (device->chipset != 0xce || nvkm_gf114_board_mode < 0)
+		return false;
+	if (nvkm_gf114_board_mode > 0)
+		return true;
+	if (!device->func->pci)
+		return false;
+	pci = device->func->pci(device);
+	return pci && pci->pdev &&
+	       pci->pdev->subsystem_vendor == 0x1458 &&
+	       pci->pdev->subsystem_device == 0x3515;
+}
diff -ruN a/nvkm/subdev/clk/base.c b/nvkm/subdev/clk/base.c
--- a/nvkm/subdev/clk/base.c	2026-10-22 14:02:34.821502994 +0300
+++ b/nvkm/subdev/clk/base.c	2026-10-22 14:04:33.240056688 +0300
@@ -263,14 +263,32 @@
 /******************************************************************************
  * P-States
  *****************************************************************************/
+static void
+nvkm_pstate_mem(struct nvkm_clk *clk, struct nvkm_pstate *pstate)
+{
+	struct nvkm_fb *fb = clk->subdev.device->fb;
+	int ret;
+
+	if (fb && fb->ram && fb->ram->func->calc) {
+		struct nvkm_ram *ram = fb->ram;
+		int khz = pstate->base.domain[nv_clk_src_mem];
+		do {
+			ret = ram->func->calc(ram, khz);
+			if (ret == 0)
+				ret = ram->func->prog(ram);
+		} while (ret > 0);
+		ram->func->tidy(ram);
+	}
+}
+
 static int
 nvkm_pstate_prog(struct nvkm_clk *clk, int pstatei)
 {
 	struct nvkm_subdev *subdev = &clk->subdev;
-	struct nvkm_fb *fb = subdev->device->fb;
 	struct nvkm_pci *pci = subdev->device->pci;
 	struct nvkm_pstate *pstate;
 	int ret, idx = 0;
+	bool up;
 
 	list_for_each_entry(pstate, &clk->states, head) {
 		if (idx++ == pstatei)
@@ -278,21 +296,21 @@
 	}
 
 	nvkm_debug(subdev, "setting performance state %d\n", pstatei);
+	up = pstatei > clk->pstate;
 	clk->pstate = pstatei;
 
 	nvkm_pcie_set_link(pci, pstate->pcie_speed, pstate->pcie_width);
 
-	if (fb && fb->ram && fb->ram->func->calc) {
-		struct nvkm_ram *ram = fb->ram;
-		int khz = pstate->base.domain[nv_clk_src_mem];
-		do {
-			ret = ram->func->calc(ram, khz);
-			if (ret == 0)
-				ret = ram->func->prog(ram);
-		} while (ret > 0);
-		ram->func->tidy(ram);
+	/* Like the NVIDIA driver: going up, raise voltage and core clocks
+	 * first and reclock memory last; going down, memory first.
+	 */
+	if (clk->core_first && up) {
+		ret = nvkm_cstate_prog(clk, pstate, NVKM_CLK_CSTATE_HIGHEST);
+		nvkm_pstate_mem(clk, pstate);
+		return ret;
 	}
 
+	nvkm_pstate_mem(clk, pstate);
 	return nvkm_cstate_prog(clk, pstate, NVKM_CLK_CSTATE_HIGHEST);
 }
 
