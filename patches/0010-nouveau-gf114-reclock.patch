--- a/nvkm/subdev/pmu/gf100.c	2026-10-22 14:02:34.831079345 +0300
+++ b/nvkm/subdev/pmu/gf100.c	2026-10-22 14:04:33.276559745 +0300
@@ -25,6 +25,218 @@
 #include "fuc/gf100.fuc3.h"
 
 #include <subdev/mc.h>
+#include <subdev/clk.h>
+#include <subdev/therm.h>
+#include <core/gf114.h>
+
+#include <linux/moduleparam.h>
+#include <linux/workqueue.h>
+
+/******************************************************************************
+ * GF114: GPU load accounting in the PMU firmware + performance-level governor
+ *
+ * Like the NVIDIA driver on Fermi: the PMU firmware (process PERF, see
+ * fuc/perf.fuc) programs the PMU busy counters the way NVIDIA 390 does
+ * (1 = video, 3 = graphics + copy, 7 = all cycles), samples them every
+ * ~100 ms and accumulates; the driver asks for the totals once a second and
+ * decides on the performance level itself.  Only active on boards where
+ * reclocking is enabled (core/gf114.h).
+ *
+ * Rules (load = max(graphics, video), one sample per second):
+ *   -> 0f : load >= 50 % for 2 samples
+ *   03 -> 07 : load >= 15 % for 2 samples
+ *   0f -> 07 : load < 15 % for 15 s        07 -> 03 : load < 5 % for 30 s
+ *   at least 5 s in a level after a switch.
+ * Thermal brake (upstream nouveau never lowers clocks on heat):
+ *   >= 90 C : never 0f (leave it for 07);  >= 95 C : 03 and stay;
+ *   released 5 C below the threshold.
+ *****************************************************************************/
+#define GF114_PROC_PERF      0x46524550	/* "PERF" */
+#define GF114_PERF_MSG_LOAD  0x44414f4c	/* "LOAD" */
+#define GF114_PERF_MSG_START 0x54525453	/* "STRT" */
+#define GF114_PERF_TICKS     20300000	/* ~100 ms of PMU clock */
+#define GF114_GOV_PERIOD_MS  1000
+
+/* 1 = on (default on supported boards), 0 = off: leave the level as it is */
+static int gf114_gov = 1;
+module_param(gf114_gov, int, 0644);
+MODULE_PARM_DESC(gf114_gov, "GF114: in-driver performance level governor on PMU load (1 on, 0 off)");
+static int gf114_load_gr, gf114_load_vid, gf114_temp;
+module_param(gf114_load_gr, int, 0444);
+MODULE_PARM_DESC(gf114_load_gr, "GF114: last graphics load reported by the PMU, permille");
+module_param(gf114_load_vid, int, 0444);
+MODULE_PARM_DESC(gf114_load_vid, "GF114: last video load reported by the PMU, permille");
+module_param(gf114_temp, int, 0444);
+MODULE_PARM_DESC(gf114_temp, "GF114: last temperature seen by the governor, C");
+
+struct gf114_gov {
+	struct delayed_work work;
+	struct nvkm_pmu *pmu;
+	bool inited, on, started;
+	unsigned long next;		/* jiffies of the next scheduled poll */
+	bool active;			/* governor state valid */
+	int cur;			/* level id by the governor's book */
+	int hi, mid, low;		/* consecutive samples above/below thresholds */
+	int brake;			/* 0 none, 1 hot (<= 07), 2 very hot (03) */
+	unsigned long last;		/* jiffies of the last switch */
+};
+static struct gf114_gov gov;
+
+static int
+gf114_cur_pstate(struct nvkm_clk *clk)
+{
+	struct nvkm_pstate *pstate;
+	int i = 0;
+
+	list_for_each_entry(pstate, &clk->states, head) {
+		if (i++ == clk->pstate)
+			return pstate->pstate;
+	}
+	return -1;
+}
+
+static int
+gf114_brake(struct nvkm_pmu *pmu)
+{
+	struct nvkm_therm *therm = pmu->subdev.device->therm;
+	int temp, b = gov.brake;
+
+	if (!therm)
+		return 0;
+	temp = nvkm_therm_temp_get(therm);
+	if (temp < 0)
+		return 0;
+	WRITE_ONCE(gf114_temp, temp);
+	if (temp >= 95)
+		b = 2;
+	else if (temp >= 90 && b < 1)
+		b = 1;
+	if (b == 2 && temp < 90)
+		b = 1;
+	if (b == 1 && temp < 85)
+		b = 0;
+	if (b != gov.brake)
+		nvkm_info(&pmu->subdev, "GF114: %d C, thermal brake %s\n", temp,
+			  b == 2 ? "VERY HOT: level 03 only" : b == 1 ? "hot: no 0f" : "released");
+	gov.brake = b;
+	return b;
+}
+
+static void
+gf114_gov_step(struct nvkm_pmu *pmu, u32 gr, u32 vid)
+{
+	struct nvkm_clk *clk = pmu->subdev.device->clk;
+	u32 load = max(gr, vid);
+	int nxt = -1, brake, ret;
+	const char *why = "";
+
+	if (!clk || !READ_ONCE(gf114_gov)) {
+		gov.active = false;
+		return;
+	}
+	if (!gov.active) {
+		gov.active = true;
+		gov.hi = gov.mid = gov.low = gov.brake = 0;
+		gov.last = jiffies;
+		nvkm_debug(&pmu->subdev, "GF114: governor on, level %02x\n", gf114_cur_pstate(clk));
+	}
+	gov.cur = gf114_cur_pstate(clk);	/* someone else may have switched */
+	if (gov.cur < 0) {			/* still on boot clocks: start from 07 */
+		nxt = 0x07, why = "start";
+		goto do_switch;
+	}
+
+	gov.hi  = load >= 500 ? gov.hi + 1 : 0;
+	gov.mid = load >= 150 ? gov.mid + 1 : 0;
+	gov.low = load < (gov.cur == 0x0f ? 150 : 50) ? gov.low + 1 : 0;
+	brake = gf114_brake(pmu);
+	if (time_before(jiffies, gov.last + msecs_to_jiffies(5000)))
+		return;
+
+	if (brake == 2 && gov.cur != 0x03)
+		nxt = 0x03, why = "very hot";
+	else if (brake == 1 && gov.cur == 0x0f)
+		nxt = 0x07, why = "hot";
+	else if (brake == 0 && gov.cur != 0x0f && gov.hi >= 2)
+		nxt = 0x0f, why = "load >= 50 %";
+	else if (brake <= 1 && gov.cur == 0x03 && gov.mid >= 2)
+		nxt = 0x07, why = "load >= 15 %";
+	else if (gov.cur == 0x0f && gov.low >= 15)
+		nxt = 0x07, why = "load < 15 % for 15 s";
+	else if (gov.cur == 0x07 && gov.low >= 30)
+		nxt = 0x03, why = "load < 5 % for 30 s";
+	if (nxt < 0)
+		return;
+
+do_switch:
+	ret = nvkm_clk_ustate(clk, nxt, 0);
+	if (!ret)
+		ret = nvkm_clk_ustate(clk, nxt, 1);
+	nvkm_debug(&pmu->subdev, "GF114: -> %02x (%s, load %u permille) ret %d\n", nxt, why, load, ret);
+	if (ret)
+		nvkm_error(&pmu->subdev, "GF114: switch to %02x failed: %d\n", nxt, ret);
+	gov.cur = nxt;
+	gov.hi = gov.mid = gov.low = 0;
+	gov.last = jiffies;
+}
+
+static void
+gf114_gov_work(struct work_struct *w)
+{
+	struct nvkm_pmu *pmu = gov.pmu;
+	u32 reply[2];
+	long delay;
+
+	if (!gov.started &&
+	    !nvkm_pmu_send(pmu, NULL, GF114_PROC_PERF, GF114_PERF_MSG_START, GF114_PERF_TICKS, 0))
+		gov.started = true;
+	if (gov.started &&
+	    !nvkm_pmu_send(pmu, reply, GF114_PROC_PERF, GF114_PERF_MSG_LOAD, 0, 0)) {
+		WRITE_ONCE(gf114_load_gr, reply[0]);
+		WRITE_ONCE(gf114_load_vid, reply[1] & 0xffff);
+		gf114_gov_step(pmu, reply[0], reply[1] & 0xffff);
+	}
+	if (READ_ONCE(gov.on)) {
+		/* keep a steady 1 s cadence regardless of how long the poll took */
+		gov.next += msecs_to_jiffies(GF114_GOV_PERIOD_MS);
+		delay = (long)gov.next - (long)jiffies;
+		if (delay < 1) {
+			gov.next = jiffies + msecs_to_jiffies(GF114_GOV_PERIOD_MS);
+			delay = msecs_to_jiffies(GF114_GOV_PERIOD_MS);
+		}
+		schedule_delayed_work(&gov.work, delay);
+	}
+}
+
+static int
+gf114_pmu_init(struct nvkm_pmu *pmu)
+{
+	int ret = gt215_pmu_init(pmu);
+
+	if (ret || !nvkm_gf114_board(pmu->subdev.device))
+		return ret;
+	if (!gov.inited) {
+		INIT_DELAYED_WORK(&gov.work, gf114_gov_work);
+		gov.inited = true;
+	}
+	gov.pmu = pmu;
+	gov.started = false;	/* firmware just (re)loaded: PERF is asleep */
+	gov.active = false;
+	WRITE_ONCE(gov.on, true);
+	gov.next = jiffies + msecs_to_jiffies(GF114_GOV_PERIOD_MS);
+	schedule_delayed_work(&gov.work, msecs_to_jiffies(GF114_GOV_PERIOD_MS));
+	return 0;
+}
+
+static void
+gf114_pmu_fini(struct nvkm_pmu *pmu)
+{
+	if (gov.inited) {
+		WRITE_ONCE(gov.on, false);
+		cancel_delayed_work_sync(&gov.work);
+	}
+	gt215_pmu_fini(pmu);
+}
 
