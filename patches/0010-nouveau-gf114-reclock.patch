@@ -102,6 +102,7 @@
 	u8  temp;
 
 	bool allow_reclock;
+	bool core_first;	/* going up: core clocks before memory (NVIDIA order) */
 #define NVKM_CLK_BOOST_NONE 0x0
 #define NVKM_CLK_BOOST_BIOS 0x1
 #define NVKM_CLK_BOOST_FULL 0x2
