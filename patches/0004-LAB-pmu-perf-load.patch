 #ifdef INCLUDE_CODE
 
-// description
-//
+// прочитать счётчик, прибавить разницу с прошлым чтением (по модулю 2^31) к сумме
+// $r5 - 0x7fffffff, $r6 - #perf_data, портит $r1 $r2
+#define perf_acc(ior,last,acc) /*
+*/	nv_iord($r1, ior) /*
+*/	ld b32 $r2 D[$r6 + last] /*
+*/	st b32 D[$r6 + last] $r1 /*
+*/	sub b32 $r1 $r2 /*
+*/	and $r1 $r5 /*
+*/	ld b32 $r2 D[$r6 + acc] /*
+*/	add b32 $r2 $r1 /*
+*/	st b32 D[$r6 + acc] $r2
+
+// запомнить текущие значения счётчиков, обнулить суммы
+perf_snap:
+	mov $r6 #perf_data
+	nv_iord($r1, 0x578)
+	st b32 D[$r6 + 0x00] $r1
+	nv_iord($r1, 0x538)
+	st b32 D[$r6 + 0x04] $r1
+	nv_iord($r1, 0x518)
+	st b32 D[$r6 + 0x08] $r1
+	st b32 D[$r6 + 0x0c] $r0
+	st b32 D[$r6 + 0x10] $r0
+	st b32 D[$r6 + 0x14] $r0
+	st b32 D[$r6 + 0x18] $r0
+	ret
+
+// один замер: добавить приращения счётчиков к суммам
+perf_sample:
+	mov $r6 #perf_data
+	imm32($r5, 0x7fffffff)
+	perf_acc(0x578, 0x00, 0x0c)
+	perf_acc(0x538, 0x04, 0x10)
+	perf_acc(0x518, 0x08, 0x14)
+	// драйвер давно не спрашивал (сумма > 2^30 тактов, ~5 с) — делим все суммы пополам,
+	// доля загрузки от этого не меняется, а переполнения не будет
+	ld b32 $r1 D[$r6 + 0x0c]
+	imm32($r2, 0x40000000)
+	cmp b32 $r1 $r2
+	bra l #perf_sample_count
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x0c] $r1
+		ld b32 $r1 D[$r6 + 0x10]
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x10] $r1
+		ld b32 $r1 D[$r6 + 0x14]
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x14] $r1
+	perf_sample_count:
+	ld b32 $r1 D[$r6 + 0x18]
+	add b32 $r1 1
+	st b32 D[$r6 + 0x18] $r1
+	ret
+
