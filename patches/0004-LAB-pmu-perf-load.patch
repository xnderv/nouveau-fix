--- a/nvkm/subdev/pmu/gf100.c
+++ b/nvkm/subdev/pmu/gf100.c
@@ -25,6 +25,400 @@
 #include "fuc/gf100.fuc3.h"
 
 #include <subdev/mc.h>
+#include <subdev/clk.h>
+#include <subdev/therm.h>
