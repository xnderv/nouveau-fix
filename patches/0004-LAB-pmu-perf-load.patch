+		clear b32 $r12
+		clear b32 $r11
+		ld b32 $r3 D[$r6 + 0x0c]
+		div $r3 $r3 1000
+		cmp b32 $r3 0
+		bra e #perf_recv_reply
+			ld b32 $r12 D[$r6 + 0x10]
+			div $r12 $r12 $r3
+			ld b32 $r11 D[$r6 + 0x14]
+			div $r11 $r11 $r3
+		perf_recv_reply:
+		ld b32 $r4 D[$r6 + 0x18]
+		shl b32 $r4 16
+		or $r11 $r4
+		st b32 D[$r6 + 0x0c] $r0
+		st b32 D[$r6 + 0x10] $r0
+		st b32 D[$r6 + 0x14] $r0
+		st b32 D[$r6 + 0x18] $r0
+		call(send)
+	perf_recv_done:
+	ret
+
+// запуск по команде драйвера: счётчики как у NVIDIA, снимок, таймер
+// $r12 - период в тактах
+perf_start:
+	// счётчики PMU — как у драйвера NVIDIA 390 на GF114
+	imm32($r1, 0x00000070)
+	nv_iowr(0x514, $r1)
+	imm32($r1, 0x00180001)
+	nv_iowr(0x534, $r1)
+	mov $r1 0x80
+	nv_iowr(0x544, $r1)
+	imm32($r1, 0x20000000)
+	nv_iowr(0x554, $r1)
+	mov $r1 2
+	nv_iowr(0x51c, $r1)
+	nv_iowr(0x53c, $r1)
+	nv_iowr(0x54c, $r1)
+	nv_iowr(0x55c, $r1)
+	mov $r1 3
+	nv_iowr(0x57c, $r1)
+	call(perf_snap)
+	mov b32 $r14 $r12
+	call(timer)
 	ret
 
-// description
-//
+// после загрузки процесс спит
 // $r15 - current (perf)
 // $r0  - zero
