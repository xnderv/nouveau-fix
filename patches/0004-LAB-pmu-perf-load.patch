diff -ruN a/nvkm/subdev/pmu/fuc/perf.fuc b/nvkm/subdev/pmu/fuc/perf.fuc
--- a/nvkm/subdev/pmu/fuc/perf.fuc	2026-10-22 13:29:18.538247309 +0300
+++ b/nvkm/subdev/pmu/fuc/perf.fuc	2026-10-22 13:28:49.070332420 +0300
@@ -22,6 +22,19 @@
  * Authors: Ben Skeggs
  */
 
+/* PERF: учёт загрузки видеокарты, как в прошивке PMU драйвера NVIDIA (Fermi).
+ * ПОСЛЕ ЗАГРУЗКИ ПРОЦЕСС СПИТ: ни счётчиков, ни таймера — прошивка ведёт себя как раньше.
+ * Работать он начинает только по команде драйвера PERF_MSG_START (data0 = период в тактах).
+ * Счётчики простоя/занятости PMU настраиваются так же, как их настраивает драйвер NVIDIA 390
+ * на GF114: счётчик 1 — видео, счётчик 3 — графика + копирование, счётчик 7 — все такты.
+ * Процесс раз в ~100 мс читает счётчики (они 31-битные и переполняются примерно за 10 с,
+ * поэтому разница считается с учётом переполнения) и копит суммы. По запросу драйвера
+ * (PERF_MSG_LOAD) отвечает загрузкой графики и видео в промилле за время с прошлого запроса
+ * и обнуляет суммы. Решение о смене режима принимает драйвер, как у NVIDIA.
+ */
+#define PERF_MSG_LOAD  0x44414f4c
+#define PERF_MSG_START 0x54525453
+
 #ifdef INCLUDE_PROC
 process(PROC_PERF, #perf_init, #perf_recv)
 #endif
@@ -30,6 +43,16 @@
  * PERF data segment
  *****************************************************************************/
 #ifdef INCLUDE_DATA
+// данные лежат далеко (после буферов memx), поэтому обращаемся через базу $r6 = #perf_data
+perf_data:
+.b32 0	// 0x00 last_total
+.b32 0	// 0x04 last_gr
+.b32 0	// 0x08 last_vid
+.b32 0	// 0x0c acc_total
+.b32 0	// 0x10 acc_gr
+.b32 0	// 0x14 acc_vid
+.b32 0	// 0x18 samples
+.b32 0	// 0x1c ticks: период замеров; 0 — процесс спит
 #endif
 
 /******************************************************************************
@@ -37,8 +60,60 @@
  *****************************************************************************/
 #ifdef INCLUDE_CODE
 
-// description
-//
+// прочитать счётчик, прибавить разницу с прошлым чтением (по модулю 2^31) к сумме
+// $r5 - 0x7fffffff, $r6 - #perf_data, портит $r1 $r2
+#define perf_acc(ior,last,acc) /*
+*/	nv_iord($r1, ior) /*
+*/	ld b32 $r2 D[$r6 + last] /*
+*/	st b32 D[$r6 + last] $r1 /*
+*/	sub b32 $r1 $r2 /*
+*/	and $r1 $r5 /*
+*/	ld b32 $r2 D[$r6 + acc] /*
+*/	add b32 $r2 $r1 /*
+*/	st b32 D[$r6 + acc] $r2
+
+// запомнить текущие значения счётчиков, обнулить суммы
+perf_snap:
+	mov $r6 #perf_data
+	nv_iord($r1, 0x578)
+	st b32 D[$r6 + 0x00] $r1
+	nv_iord($r1, 0x538)
+	st b32 D[$r6 + 0x04] $r1
+	nv_iord($r1, 0x518)
+	st b32 D[$r6 + 0x08] $r1
+	st b32 D[$r6 + 0x0c] $r0
+	st b32 D[$r6 + 0x10] $r0
+	st b32 D[$r6 + 0x14] $r0
+	st b32 D[$r6 + 0x18] $r0
+	ret
+
+// один замер: добавить приращения счётчиков к суммам
+perf_sample:
+	mov $r6 #perf_data
+	imm32($r5, 0x7fffffff)
+	perf_acc(0x578, 0x00, 0x0c)
+	perf_acc(0x538, 0x04, 0x10)
+	perf_acc(0x518, 0x08, 0x14)
+	// драйвер давно не спрашивал (сумма > 2^30 тактов, ~5 с) — делим все суммы пополам,
+	// доля загрузки от этого не меняется, а переполнения не будет
+	ld b32 $r1 D[$r6 + 0x0c]
+	imm32($r2, 0x40000000)
+	cmp b32 $r1 $r2
+	bra l #perf_sample_count
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x0c] $r1
+		ld b32 $r1 D[$r6 + 0x10]
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x10] $r1
+		ld b32 $r1 D[$r6 + 0x14]
+		shr b32 $r1 1
+		st b32 D[$r6 + 0x14] $r1
+	perf_sample_count:
+	ld b32 $r1 D[$r6 + 0x18]
+	add b32 $r1 1
+	st b32 D[$r6 + 0x18] $r1
+	ret
+
 // $r15 - current (perf)
 // $r14 - sender process name
 // $r13 - message
@@ -46,10 +121,99 @@
 // $r11 - data1
 // $r0  - zero
 perf_recv:
+	imm32($r1, PROC_KERN)
+	cmp b32 $r14 $r1
+	bra ne #perf_recv_host
+		// таймер: замер и следующий таймер
+		cmp b32 $r13 KMSG_ALARM
+		bra ne #perf_recv_done
+		mov $r6 #perf_data
+		ld b32 $r1 D[$r6 + 0x1c]
+		cmp b32 $r1 0
+		bra e #perf_recv_done
+		call(perf_sample)
+		mov $r6 #perf_data
+		ld b32 $r14 D[$r6 + 0x1c]
+		call(timer)
+		ret
+	perf_recv_host:
+	imm32($r1, PERF_MSG_START)
+	cmp b32 $r13 $r1
+	bra ne #perf_recv_load
+		// уже работает — только сменить период; иначе настроить счётчики и завести таймер
+		mov $r6 #perf_data
+		ld b32 $r1 D[$r6 + 0x1c]
+		st b32 D[$r6 + 0x1c] $r12
+		cmp b32 $r1 0
+		bra ne #perf_recv_done
+		cmp b32 $r12 0
+		bra e #perf_recv_done
+		call(perf_start)
+		ret
+	perf_recv_load:
+	imm32($r1, PERF_MSG_LOAD)
+	cmp b32 $r13 $r1
+	bra ne #perf_recv_done
+		// процесс спит — замер не делаем, ответ будет нулевой (0 замеров)
+		mov $r6 #perf_data
+		ld b32 $r1 D[$r6 + 0x1c]
+		cmp b32 $r1 0
+		bra e #perf_recv_answer
+		push $r14
+		push $r13
+		call(perf_sample)
+		pop $r13
+		pop $r14
+		perf_recv_answer:
+		mov $r6 #perf_data
+		// ответ: data0 = графика, промилле; data1 = видео, промилле | число замеров << 16
+		clear b32 $r12
+		clear b32 $r11
+		ld b32 $r3 D[$r6 + 0x0c]
+		div $r3 $r3 1000
+		cmp b32 $r3 0
+		bra e #perf_recv_reply
+			ld b32 $r12 D[$r6 + 0x10]
+			div $r12 $r12 $r3
+			ld b32 $r11 D[$r6 + 0x14]
+			div $r11 $r11 $r3
+		perf_recv_reply:
+		ld b32 $r4 D[$r6 + 0x18]
+		shl b32 $r4 16
+		or $r11 $r4
+		st b32 D[$r6 + 0x0c] $r0
+		st b32 D[$r6 + 0x10] $r0
+		st b32 D[$r6 + 0x14] $r0
+		st b32 D[$r6 + 0x18] $r0
+		call(send)
+	perf_recv_done:
+	ret
+
+// запуск по команде драйвера: счётчики как у NVIDIA, снимок, таймер
+// $r12 - период в тактах
+perf_start:
+	// счётчики PMU — как у драйвера NVIDIA 390 на GF114
+	imm32($r1, 0x00000070)
+	nv_iowr(0x514, $r1)
+	imm32($r1, 0x00180001)
+	nv_iowr(0x534, $r1)
+	mov $r1 0x80
+	nv_iowr(0x544, $r1)
+	imm32($r1, 0x20000000)
+	nv_iowr(0x554, $r1)
+	mov $r1 2
+	nv_iowr(0x51c, $r1)
+	nv_iowr(0x53c, $r1)
+	nv_iowr(0x54c, $r1)
+	nv_iowr(0x55c, $r1)
+	mov $r1 3
+	nv_iowr(0x57c, $r1)
+	call(perf_snap)
+	mov b32 $r14 $r12
+	call(timer)
 	ret
 
-// description
-//
+// после загрузки процесс спит
 // $r15 - current (perf)
 // $r0  - zero
 perf_init:
diff -ruN a/nvkm/subdev/pmu/gf100.c b/nvkm/subdev/pmu/gf100.c
--- a/nvkm/subdev/pmu/gf100.c	2026-10-22 13:29:18.538274487 +0300
+++ b/nvkm/subdev/pmu/gf100.c	2026-10-22 13:29:02.567432488 +0300
@@ -25,6 +25,250 @@
 #include "fuc/gf100.fuc3.h"
 
 #include <subdev/mc.h>
+#include <subdev/clk.h>
+#include <subdev/therm.h>
+
+#include <linux/moduleparam.h>
+#include <linux/workqueue.h>
+
+/* LAB: учёт загрузки в прошивке PMU (процесс PERF, fuc/perf.fuc), как у драйвера NVIDIA.
+ * Прошивка сама раз в ~100 мс читает счётчики занятости и копит суммы; драйвер раз в
+ * lab_perf_ms спрашивает итог (PERF_MSG_LOAD) и получает загрузку графики и видео в промилле.
+ * После загрузки процесс в прошивке СПИТ. Включается по шагам, по одному за раз:
+ *   lab_perf_ticks > 0 — драйвер командует прошивке начать замеры с этим периодом (такты PMU,
+ *                        20300000 ~ 100 мс); 0 — остановить замеры (после перезагрузки/сна прошивка спит сама);
+ *   lab_perf_ms > 0    — драйвер раз в N мс спрашивает итог; значения в lab_perf_{gr,vid,samples},
+ *                        при lab_perf_log=1 — в журнал.
+ * Режимы этот код НЕ переключает. */
+static int lab_perf_ticks;
+module_param(lab_perf_ticks, int, 0644);
+MODULE_PARM_DESC(lab_perf_ticks, "LAB: start PMU PERF sampling with this period in PMU ticks (0 = leave it asleep)");
+static int lab_perf_ms;
+module_param(lab_perf_ms, int, 0644);
+MODULE_PARM_DESC(lab_perf_ms, "LAB: query PMU PERF load every N ms (0 = off)");
+static bool lab_perf_log;
+module_param(lab_perf_log, bool, 0644);
+MODULE_PARM_DESC(lab_perf_log, "LAB: log each PMU PERF load reply");
+static int lab_perf_gr, lab_perf_vid, lab_perf_samples;
+module_param(lab_perf_gr, int, 0444);
+MODULE_PARM_DESC(lab_perf_gr, "LAB: last graphics+copy load from PMU, permille");
+module_param(lab_perf_vid, int, 0444);
+MODULE_PARM_DESC(lab_perf_vid, "LAB: last video load from PMU, permille");
+module_param(lab_perf_samples, int, 0444);
+MODULE_PARM_DESC(lab_perf_samples, "LAB: PMU samples behind the last reply");
+
+/* LAB, ступень 2: решение о режиме в драйвере (как у NVIDIA: прошивка считает, драйвер решает).
+ * Правила — те же, что у службы gpu-autoclock (обкатаны 21.10), загрузка = max(графика, видео):
+ *   в 0f:     >= 50 % два замера подряд (из 03 или 07);   03 -> 07: >= 15 % два замера подряд;
+ *   0f -> 07: < 15 % в течение 15 с;                       07 -> 03: < 5 % в течение 30 с;
+ *   после любого переключения — не меньше 5 с в новом режиме.
+ * lab_gov: 0 — выключено; 1 — ТЕНЬ: драйвер ведёт свой воображаемый режим и только пишет в журнал,
+ *          куда бы переключил (переключает служба); 2 — драйвер переключает сам (ступень 2б).
+ * Работает только при включённых замерах и опросе (lab_perf_ticks > 0, lab_perf_ms > 0). */
+static int lab_gov;
+module_param(lab_gov, int, 0644);
+MODULE_PARM_DESC(lab_gov, "LAB: in-driver pstate governor on PMU PERF load (0 off, 1 shadow/log only, 2 act)");
+/* LAB 22.10: температурный тормоз (у nouveau его нет: до 135 °C он только крутит вентилятор; у NVIDIA
+ * частоты при перегреве снижаются). lab_gov_hot: при температуре >= hot не подниматься в 0f, а из 0f уйти
+ * в 07; lab_gov_crit: >= crit — уйти в 03 и сидеть; отпускает, когда остынет на lab_gov_hyst градусов
+ * ниже порога. 0 — тормоз выключен. Термодатчик тот же, что у вентилятора (nvkm_therm_temp_get). */
+static int lab_gov_hot;
+module_param(lab_gov_hot, int, 0644);
+MODULE_PARM_DESC(lab_gov_hot, "LAB: temperature (C) above which the governor stays out of 0f (0 = off)");
+static int lab_gov_crit;
+module_param(lab_gov_crit, int, 0644);
+MODULE_PARM_DESC(lab_gov_crit, "LAB: temperature (C) above which the governor drops to 03 (0 = off)");
+static int lab_gov_hyst = 5;
+module_param(lab_gov_hyst, int, 0644);
+MODULE_PARM_DESC(lab_gov_hyst, "LAB: hysteresis (C) for the temperature brake");
+static int lab_gov_temp;
+module_param(lab_gov_temp, int, 0444);
+MODULE_PARM_DESC(lab_gov_temp, "LAB: last temperature seen by the governor (C)");
+
+static struct {
+	int mode;		/* с каким lab_gov работали в прошлый раз */
+	int cur;		/* режим (id pstate) по мнению регулятора */
+	int hi, mid, low;	/* замеров подряд выше/ниже порогов */
+	unsigned long last;	/* jiffies последнего переключения */
+	int brake;		/* температурный тормоз: 0 нет, 1 «горячо» (не выше 07), 2 «очень горячо» (03) */
+} lab_gov_st;
+
+/* ступень тормоза по температуре с гистерезисом; -1 — датчика нет */
+static int
+lab_gov_brake(struct nvkm_pmu *pmu)
+{
+	struct nvkm_therm *therm = pmu->subdev.device->therm;
+	int hot = READ_ONCE(lab_gov_hot), crit = READ_ONCE(lab_gov_crit), hyst = READ_ONCE(lab_gov_hyst);
+	int temp, b = lab_gov_st.brake;
+
+	if (!therm || (hot <= 0 && crit <= 0))
+		return 0;
+	temp = nvkm_therm_temp_get(therm);
+	if (temp < 0)
+		return -1;
+	WRITE_ONCE(lab_gov_temp, temp);
+	if (crit > 0 && temp >= crit)
+		b = 2;
+	else if (hot > 0 && temp >= hot && b < 1)
+		b = 1;
+	if (b == 2 && (crit <= 0 || temp < crit - hyst))
+		b = 1;
+	if (b == 1 && (hot <= 0 || temp < hot - hyst))
+		b = 0;
+	if (b != lab_gov_st.brake)
+		nvkm_info(&pmu->subdev, "LAB gov: температура %d °C — тормоз %s\n", temp,
+			  b == 2 ? "ОЧЕНЬ ГОРЯЧО: только 03" : b == 1 ? "горячо: не выше 07" : "снят");
+	lab_gov_st.brake = b;
+	return b;
+}
+
+static int
+lab_gov_cur_pstate(struct nvkm_clk *clk)
+{
+	struct nvkm_pstate *pstate;
+	int i = 0;
+
+	list_for_each_entry(pstate, &clk->states, head) {
+		if (i++ == clk->pstate)
+			return pstate->pstate;
+	}
+	return -1;
+}
+
+static void
+lab_gov_step(struct nvkm_pmu *pmu, u32 gr, u32 vid, int ms)
+{
+	struct nvkm_clk *clk = pmu->subdev.device->clk;
+	int mode = READ_ONCE(lab_gov);
+	u32 load = max(gr, vid);
+	int per_s = 1000 / max(ms, 1), nxt = -1, ret, brake;
+	const char *why = "";
+
+	if (!clk || (mode != 1 && mode != 2)) {
+		lab_gov_st.mode = 0;
+		return;
+	}
+	if (lab_gov_st.mode != mode) {	/* только что включили: начинаем с текущего режима карты */
+		lab_gov_st.mode = mode;
+		lab_gov_st.cur = lab_gov_cur_pstate(clk);
+		lab_gov_st.hi = lab_gov_st.mid = lab_gov_st.low = 0;
+		lab_gov_st.brake = 0;
+		lab_gov_st.last = jiffies;
+		nvkm_info(&pmu->subdev, "LAB gov: включён (%s), режим сейчас %02x\n",
+			  mode == 1 ? "тень — только журнал" : "переключает сам", lab_gov_st.cur);
+	}
+	if (mode == 2)	/* сам переключает — сверяемся с картой (режим мог сменить кто-то ещё) */
+		lab_gov_st.cur = lab_gov_cur_pstate(clk);
+
+	lab_gov_st.hi  = load >= 500 ? lab_gov_st.hi + 1 : 0;
+	lab_gov_st.mid = load >= 150 ? lab_gov_st.mid + 1 : 0;
+	if (lab_gov_st.cur == 0x0f)
+		lab_gov_st.low = load < 150 ? lab_gov_st.low + 1 : 0;
+	else
+		lab_gov_st.low = load < 50 ? lab_gov_st.low + 1 : 0;
+	if (time_before(jiffies, lab_gov_st.last + msecs_to_jiffies(5000)))
+		return;
+
+	brake = lab_gov_brake(pmu);
+	if (brake == 2 && lab_gov_st.cur != 0x03)
+		nxt = 0x03, why = "температура: очень горячо";
+	else if (brake == 1 && lab_gov_st.cur == 0x0f)
+		nxt = 0x07, why = "температура: горячо";
+	else if (brake <= 0 && lab_gov_st.cur != 0x0f && lab_gov_st.hi >= 2)
+		nxt = 0x0f, why = "загрузка >= 50 % два замера";
+	else if (brake <= 1 && lab_gov_st.cur == 0x03 && lab_gov_st.mid >= 2)
+		nxt = 0x07, why = "загрузка >= 15 % два замера";
+	else if (lab_gov_st.cur == 0x0f && lab_gov_st.low >= 15 * per_s)
+		nxt = 0x07, why = "загрузка < 15 % 15 с";
+	else if (lab_gov_st.cur == 0x07 && lab_gov_st.low >= 30 * per_s)
+		nxt = 0x03, why = "загрузка < 5 % 30 с";
+	if (nxt < 0)
+		return;
+
+	if (mode == 1) {
+		nvkm_info(&pmu->subdev, "LAB gov: ТЕНЬ -> %02x (%s, загрузка %u‰)\n", nxt, why, load);
+	} else {
+		ret = nvkm_clk_ustate(clk, nxt, 0);
+		ret |= nvkm_clk_ustate(clk, nxt, 1);
+		nvkm_info(&pmu->subdev, "LAB gov: -> %02x (%s, загрузка %u‰), ret %d, режим теперь %02x\n",
+			  nxt, why, load, ret, lab_gov_cur_pstate(clk));
+	}
+	lab_gov_st.cur = nxt;
+	lab_gov_st.hi = lab_gov_st.mid = lab_gov_st.low = 0;
+	lab_gov_st.last = jiffies;
+}
+
+#define LAB_PROC_PERF     0x46524550
+#define LAB_PERF_MSG_LOAD 0x44414f4c
+#define LAB_PERF_MSG_START 0x54525453
+
+static struct {
+	struct delayed_work work;
+	struct nvkm_pmu *pmu;
+	bool inited, on;
+	int started;	/* какой период уже отправлен прошивке после её загрузки (0 — спит) */
+} lab_perf;
+
+static void
+lab_perf_work(struct work_struct *w)
+{
+	struct nvkm_pmu *pmu = lab_perf.pmu;
+	int ms = READ_ONCE(lab_perf_ms);
+	int ticks = READ_ONCE(lab_perf_ticks);
+	u32 reply[2];
+
+	if (pmu && ticks > 0 && ticks != lab_perf.started &&
+	    !nvkm_pmu_send(pmu, NULL, LAB_PROC_PERF, LAB_PERF_MSG_START, ticks, 0)) {
+		nvkm_info(&pmu->subdev, "LAB perf: прошивке дана команда начать замеры, период %d тактов\n", ticks);
+		lab_perf.started = ticks;
+	}
+	if (pmu && ticks <= 0 && lab_perf.started &&
+	    !nvkm_pmu_send(pmu, NULL, LAB_PROC_PERF, LAB_PERF_MSG_START, 0, 0)) {
+		nvkm_info(&pmu->subdev, "LAB perf: прошивке дана команда прекратить замеры\n");
+		lab_perf.started = 0;
+	}
+	if (ms > 0 && pmu &&
+	    !nvkm_pmu_send(pmu, reply, LAB_PROC_PERF, LAB_PERF_MSG_LOAD, 0, 0)) {
+		WRITE_ONCE(lab_perf_gr, reply[0]);
+		WRITE_ONCE(lab_perf_vid, reply[1] & 0xffff);
+		WRITE_ONCE(lab_perf_samples, reply[1] >> 16);
+		if (READ_ONCE(lab_perf_log))
+			nvkm_info(&pmu->subdev, "LAB perf: графика %u‰, видео %u‰, замеров %u\n",
+				  reply[0], reply[1] & 0xffff, reply[1] >> 16);
+		lab_gov_step(pmu, reply[0], reply[1] & 0xffff, ms);
+	}
+	if (READ_ONCE(lab_perf.on))
+		schedule_delayed_work(&lab_perf.work, msecs_to_jiffies(ms > 0 ? ms : 1000));
+}
+
+static int
+gf100_pmu_init_lab(struct nvkm_pmu *pmu)
+{
+	int ret = gt215_pmu_init(pmu);
+
+	if (ret)
+		return ret;
+	if (!lab_perf.inited) {
+		INIT_DELAYED_WORK(&lab_perf.work, lab_perf_work);
+		lab_perf.inited = true;
+	}
+	lab_perf.pmu = pmu;
+	lab_perf.started = 0;	/* прошивка только что загружена — процесс PERF спит */
+	lab_gov_st.mode = 0;	/* регулятор начнёт заново с текущего режима */
+	WRITE_ONCE(lab_perf.on, true);
+	schedule_delayed_work(&lab_perf.work, msecs_to_jiffies(1000));
+	return 0;
+}
+
+static void
+gf100_pmu_fini_lab(struct nvkm_pmu *pmu)
+{
+	if (lab_perf.inited) {
+		WRITE_ONCE(lab_perf.on, false);
+		cancel_delayed_work_sync(&lab_perf.work);
+	}
+	gt215_pmu_fini(pmu);
+}
 
