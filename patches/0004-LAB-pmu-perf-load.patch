+/* LAB: учёт загрузки в прошивке PMU (процесс PERF, fuc/perf.fuc), как у драйвера NVIDIA.
+ * Прошивка сама раз в ~100 мс читает счётчики занятости и копит суммы; драйвер раз в
+ * lab_perf_ms спрашивает итог (PERF_MSG_LOAD) и получает загрузку графики и видео в промилле.
+ * После загрузки процесс в прошивке СПИТ. Включается по шагам, по одному за раз:
+ *   lab_perf_ticks > 0 — драйвер командует прошивке начать замеры с этим периодом (такты PMU,
+ *                        20300000 ~ 100 мс); 0 — остановить замеры (после перезагрузки/сна прошивка спит сама);
+ *   lab_perf_ms > 0    — драйвер раз в N мс спрашивает итог; значения в lab_perf_{gr,vid,samples},
+ *                        при lab_perf_log=1 — в журнал.
+ * Режимы этот код НЕ переключает. */
+static int lab_perf_ticks = -1;	/* 19.11: -1 — период 100 мс, пересчитанный из такта PMU этой карты (у нас 202,5 МГц -> 20 250 000) */
+module_param(lab_perf_ticks, int, 0644);
+MODULE_PARM_DESC(lab_perf_ticks, "LAB: start PMU PERF sampling with this period in PMU ticks (-1 = 100 ms from this card's PMU clock, 0 = leave it asleep)");
+static int lab_perf_ms = 1000;	/* 19.11: по умолчанию как служба (набор 18.11) */
+module_param(lab_perf_ms, int, 0644);
+MODULE_PARM_DESC(lab_perf_ms, "LAB: query PMU PERF load every N ms (0 = off)");
+static bool lab_perf_log;
+module_param(lab_perf_log, bool, 0644);
+MODULE_PARM_DESC(lab_perf_log, "LAB: log each PMU PERF load reply");
+static int lab_perf_gr, lab_perf_vid, lab_perf_samples;
+module_param(lab_perf_gr, int, 0444);
+MODULE_PARM_DESC(lab_perf_gr, "LAB: last graphics+copy load from PMU, permille");
+module_param(lab_perf_vid, int, 0444);
+MODULE_PARM_DESC(lab_perf_vid, "LAB: last video load from PMU, permille");
+module_param(lab_perf_samples, int, 0444);
+MODULE_PARM_DESC(lab_perf_samples, "LAB: PMU samples behind the last reply");
+
+/* LAB, ступень 2: решение о режиме в драйвере (как у NVIDIA: прошивка считает, драйвер решает).
+ * Правила — те же, что у службы gpu-autoclock (обкатаны 21.10), загрузка = max(графика, видео):
+ *   в 0f:     >= 50 % два замера подряд (из 03 или 07);   03 -> 07: >= 15 % два замера подряд;
+ *   0f -> 07: < 15 % в течение 15 с;                       07 -> 03: < 5 % в течение 30 с;
+ *   после любого переключения — не меньше 5 с в новом режиме.
+ * lab_gov: 0 — выключено; 1 — ТЕНЬ: драйвер ведёт свой воображаемый режим и только пишет в журнал,
+ *          куда бы переключил (переключает служба); 2 — драйвер переключает сам (ступень 2б).
+ * Работает только при включённых замерах и опросе (lab_perf_ticks > 0, lab_perf_ms > 0). */
+static int lab_gov = 2;	/* 19.11: по умолчанию как служба (набор 18.11) */
+module_param(lab_gov, int, 0644);
+MODULE_PARM_DESC(lab_gov, "LAB: in-driver pstate governor on PMU PERF load (0 off, 1 shadow/log only, 2 act)");
+/* LAB 22.10: температурный тормоз (у nouveau его нет: до 135 °C он только крутит вентилятор; у NVIDIA
+ * частоты при перегреве снижаются). lab_gov_hot: при температуре >= hot не подниматься в 0f, а из 0f уйти
+ * в 07; lab_gov_crit: >= crit — уйти в 03 и сидеть; отпускает, когда остынет на lab_gov_hyst градусов
+ * ниже порога. 0 — тормоз выключен. Термодатчик тот же, что у вентилятора (nvkm_therm_temp_get). */
+static int lab_gov_hot = -1;	/* 19.11: -1 — порог VBIOS «вентилятор на максимум» (у нас 90, как ставила служба) */
+module_param(lab_gov_hot, int, 0644);
+MODULE_PARM_DESC(lab_gov_hot, "LAB: temperature (C) above which the governor stays out of 0f (0 = off)");
+static int lab_gov_crit = -1;	/* 19.11: -1 — порог VBIOS «снижать частоты» (у нас 95, как ставила служба) */
+module_param(lab_gov_crit, int, 0644);
+MODULE_PARM_DESC(lab_gov_crit, "LAB: temperature (C) above which the governor drops to 03 (0 = off)");
+static int lab_gov_hyst = 5;
+module_param(lab_gov_hyst, int, 0644);
+MODULE_PARM_DESC(lab_gov_hyst, "LAB: hysteresis (C) for the temperature brake");
+static int lab_gov_temp;
+module_param(lab_gov_temp, int, 0444);
+MODULE_PARM_DESC(lab_gov_temp, "LAB: last temperature seen by the governor (C)");
+/* LAB 24.10: lab_gov_nv — правила как у регулятора NVIDIA в записи 7: вверх — сразу на 0f по первому замеру >= 50 %
+ * (через ~0,25 с после появления нагрузки; подъёма 03 -> 07 у NVIDIA не было ни разу), вниз — по ступени после 8 с низкой
+ * нагрузки (0f -> 07 при < 15 %, 07 -> 03 при < 5 %), без 5-секундной выдержки после переключения. Пороги загрузки свои. */
+static int lab_gov_nv;
+module_param(lab_gov_nv, int, 0644);
+MODULE_PARM_DESC(lab_gov_nv, "LAB: governor timing as NVIDIA: up straight to 0f on the first sample >= 50%, down one level after 8 s low load, no 03->07 upshift");
+
+static struct {
+	int mode;		/* с каким lab_gov работали в прошлый раз */
+	int cur;		/* режим (id pstate) по мнению регулятора */
+	int hi, mid, low;	/* замеров подряд выше/ниже порогов */
+	unsigned long last;	/* jiffies последнего переключения */
+	int brake;		/* температурный тормоз: 0 нет, 1 «горячо» (не выше 07), 2 «очень горячо» (03) */
+} lab_gov_st;
+
+/* ступень тормоза по температуре с гистерезисом; -1 — датчика нет */
+static int
+lab_gov_brake(struct nvkm_pmu *pmu)
+{
+	struct nvkm_therm *therm = pmu->subdev.device->therm;
+	int hot = READ_ONCE(lab_gov_hot), crit = READ_ONCE(lab_gov_crit), hyst = READ_ONCE(lab_gov_hyst);
+	int temp, b = lab_gov_st.brake;
+
+	if (therm && hot < 0)	/* 19.11: пороги из VBIOS (nouveau читает их в bios_sensor) */
+		hot = therm->bios_sensor.thrs_fan_boost.temp;
+	if (therm && crit < 0)
+		crit = therm->bios_sensor.thrs_down_clock.temp;
+	if (!therm || (hot <= 0 && crit <= 0))
+		return 0;
+	temp = nvkm_therm_temp_get(therm);
+	if (temp < 0)
+		return -1;
+	WRITE_ONCE(lab_gov_temp, temp);
+	if (crit > 0 && temp >= crit)
+		b = 2;
+	else if (hot > 0 && temp >= hot && b < 1)
+		b = 1;
+	if (b == 2 && (crit <= 0 || temp < crit - hyst))
+		b = 1;
+	if (b == 1 && (hot <= 0 || temp < hot - hyst))
+		b = 0;
+	if (b != lab_gov_st.brake)
+		nvkm_info(&pmu->subdev, "LAB gov: температура %d °C — тормоз %s\n", temp,
+			  b == 2 ? "ОЧЕНЬ ГОРЯЧО: только 03" : b == 1 ? "горячо: не выше 07" : "снят");
+	lab_gov_st.brake = b;
+	return b;
+}
+
+static int
+lab_gov_cur_pstate(struct nvkm_clk *clk)
+{
+	struct nvkm_pstate *pstate;
+	int i = 0;
+
+	list_for_each_entry(pstate, &clk->states, head) {
+		if (i++ == clk->pstate)
+			return pstate->pstate;
+	}
+	return -1;
+}
+
+/* LAB 21.11: уровни регулятора — из таблицы уровней карты, а не числа 03/07/0f: нижний, средний и верхний по возрастанию
+ * id. У карт с двумя уровнями (GF119 jfouquart: 07 и 0f) среднего нет: подъём сразу на верхний, спуск с верхнего — на
+ * нижний. У карт с тремя уровнями (все наши) — те же 03, 07, 0f, поведение не меняется. */
+/* LAB 21.11 (опыт 113): lab_gov_two=1 — регулятор не пользуется самым нижним уровнем карты, как будто уровней два (как у GF119:
+ * 07 и 0f). Проверка двухуровневого пути регулятора на нашем железе; меняется на ходу. */
+static uint lab_gov_two;
+module_param(lab_gov_two, uint, 0644);
+MODULE_PARM_DESC(lab_gov_two, "LAB experiment: governor ignores the lowest performance level (two-level path, as GF119)");
+
+static void
+lab_gov_levels(struct nvkm_clk *clk, int *lo, int *mid, int *hi)
+{
+	struct nvkm_pstate *pstate;
+	int ids[8], n = 0, i, j, t;
+
+	list_for_each_entry(pstate, &clk->states, head)
+		if (n < ARRAY_SIZE(ids))
+			ids[n++] = pstate->pstate;
+	for (i = 1; i < n; i++)		/* по возрастанию */
+		for (j = i; j > 0 && ids[j - 1] > ids[j]; j--)
+			t = ids[j], ids[j] = ids[j - 1], ids[j - 1] = t;
+	if (READ_ONCE(lab_gov_two) && n >= 3) {	/* опыт: жить как GF119 — без самого нижнего уровня */
+		for (i = 1; i < n; i++)
+			ids[i - 1] = ids[i];
+		n--;
+	}
+	*lo = n ? ids[0] : -1;
+	*hi = n ? ids[n - 1] : -1;
+	*mid = n >= 3 ? ids[n - 2] : -1;	/* ступень под верхним; при двух уровнях её нет */
+}
+
+extern void lab_volt_cold_poll(struct nvkm_clk *);	/* clk/base.c */
+
+static void
+lab_gov_step(struct nvkm_pmu *pmu, u32 gr, u32 vid, int ms)
+{
+	struct nvkm_clk *clk = pmu->subdev.device->clk;
+	int mode = READ_ONCE(lab_gov);
+	u32 load = max(gr, vid);
+	int per_s = 1000 / max(ms, 1), nxt = -1, ret, brake, nv;
+	int lo, mid, hi, below;
+	const char *why = "";
+
+	if (!clk || (mode != 1 && mode != 2)) {
+		lab_gov_st.mode = 0;
+		return;
+	}
+	if (mode == 2)	/* 25.11: напряжение холодного чипа из VBIOS (clk/base.c) — проверка порога раз в замер */
+		lab_volt_cold_poll(clk);
+	if (lab_gov_st.mode != mode) {	/* только что включили: начинаем с текущего режима карты */
+		lab_gov_st.mode = mode;
+		lab_gov_st.cur = lab_gov_cur_pstate(clk);
+		lab_gov_st.hi = lab_gov_st.mid = lab_gov_st.low = 0;
+		lab_gov_st.brake = 0;
+		lab_gov_st.last = jiffies;
+		nvkm_info(&pmu->subdev, "LAB gov: включён (%s), режим сейчас %02x\n",
+			  mode == 1 ? "тень — только журнал" : "переключает сам", lab_gov_st.cur);
+	}
+	if (mode == 2)	/* сам переключает — сверяемся с картой (режим мог сменить кто-то ещё) */
+		lab_gov_st.cur = lab_gov_cur_pstate(clk);
+	lab_gov_levels(clk, &lo, &mid, &hi);
+	if (lo < 0)
+		return;
+	below = mid >= 0 ? mid : lo;	/* куда спускаться с верхнего */
+	if (lab_gov_st.cur < 0)	/* 19.11: загрузочные частоты VBIOS (уровень ещё не ставили) — считаем за средний (07), как служба;
+				 * 21.11: если среднего нет — за нижний */
+		lab_gov_st.cur = below;
+
+	lab_gov_st.hi  = load >= 500 ? lab_gov_st.hi + 1 : 0;
+	lab_gov_st.mid = load >= 150 ? lab_gov_st.mid + 1 : 0;
+	if (lab_gov_st.cur == hi)
+		lab_gov_st.low = load < 150 ? lab_gov_st.low + 1 : 0;
+	else
+		lab_gov_st.low = load < 50 ? lab_gov_st.low + 1 : 0;
+	nv = READ_ONCE(lab_gov_nv);
+	if (!nv && time_before(jiffies, lab_gov_st.last + msecs_to_jiffies(5000)))
+		return;
+
+	brake = lab_gov_brake(pmu);
+	if (brake == 2 && lab_gov_st.cur != lo)
+		nxt = lo, why = "температура: очень горячо";
+	else if (brake == 1 && lab_gov_st.cur == hi && hi != lo)
+		nxt = below, why = "температура: горячо";
+	else if (brake <= 0 && lab_gov_st.cur != hi && lab_gov_st.hi >= (nv ? 1 : 2))
+		nxt = hi, why = nv ? "загрузка >= 50 % (как NVIDIA: сразу на верхний)" : "загрузка >= 50 % два замера";
+	else if (!nv && mid >= 0 && brake <= 1 && lab_gov_st.cur == lo && lab_gov_st.mid >= 2)
+		nxt = mid, why = "загрузка >= 15 % два замера";
+	else if (lab_gov_st.cur == hi && hi != lo && lab_gov_st.low >= (nv ? 8 : 15) * per_s)
+		nxt = below, why = nv ? "загрузка < 15 % 8 с (как NVIDIA)" : "загрузка < 15 % 15 с";
+	else if (mid >= 0 && lab_gov_st.cur == mid && lab_gov_st.low >= (nv ? 8 : 30) * per_s)
+		nxt = lo, why = nv ? "загрузка < 5 % 8 с (как NVIDIA)" : "загрузка < 5 % 30 с";
+	if (nxt < 0)
+		return;
+
+	if (mode == 1) {
+		nvkm_info(&pmu->subdev, "LAB gov: ТЕНЬ -> %02x (%s, загрузка %u‰)\n", nxt, why, load);
+	} else {
+		ret = nvkm_clk_ustate(clk, nxt, 0);
+		ret |= nvkm_clk_ustate(clk, nxt, 1);
+		nvkm_info(&pmu->subdev, "LAB gov: -> %02x (%s, загрузка %u‰), ret %d, режим теперь %02x\n",
+			  nxt, why, load, ret, lab_gov_cur_pstate(clk));
+	}
+	lab_gov_st.cur = nxt;
+	lab_gov_st.hi = lab_gov_st.mid = lab_gov_st.low = 0;
+	lab_gov_st.last = jiffies;
+}
+
+#define LAB_PROC_PERF     0x46524550
+#define LAB_PERF_MSG_LOAD 0x44414f4c
+#define LAB_PERF_MSG_START 0x54525453
+
+static struct {
+	struct delayed_work work;
+	struct nvkm_pmu *pmu;
+	bool inited, on;
+	int started;	/* какой период уже отправлен прошивке после её загрузки (0 — спит) */
+} lab_perf;
+
+/* LAB 22.11 (опыт 114): запрос итога у прошивки PMU — как gt215_pmu_send, но ответ ждём не дольше lab_perf_wait_ms.
+ * Прошивка nouveau молча выбрасывает сообщение, если очередь процесса полна (kernel.fuc send_proc -> send_done; host.fuc
+ * пересылает очередь хоста процессу через тот же send): запрос принят, ответа нет. gt215_pmu_send ждёт ответа без предела —
+ * 21.11 в 15:31 так повис поток регулятора (регистры: обе очереди пусты, микроконтроллер работает). При тайм-ауте снимаем
+ * ожидание (recv.process = 0): если ответ всё же придёт позже, nouveau сам напишет о «неожиданном» сообщении PERF — так
+ * отличается «потерян» от «опоздал». Смену памяти (memx) это не трогает — у неё свой запрос.
+ * lab_perf_drop=N — опыт: следующие N запросов отправить несуществующему процессу (прошивка выбросит их так же молча). */
+static int lab_perf_wait_ms = 1000;
+module_param(lab_perf_wait_ms, int, 0644);
+MODULE_PARM_DESC(lab_perf_wait_ms, "LAB: wait at most N ms for the PMU PERF reply (0 = forever, as nouveau)");
+static int lab_perf_timeouts;
+module_param(lab_perf_timeouts, int, 0444);
+MODULE_PARM_DESC(lab_perf_timeouts, "LAB: PMU PERF replies not received in time (since load)");
+static uint lab_perf_flood;	/* опыт 116: перед следующим запросом итога — N сообщений «начать замеры» подряд (без ответа) */
+module_param(lab_perf_flood, uint, 0644);
+MODULE_PARM_DESC(lab_perf_flood, "LAB experiment 116: before the next load request send N extra START messages to PERF (its queue holds 4: the request gets dropped)");
+static uint lab_perf_drop;
+module_param(lab_perf_drop, uint, 0644);
+MODULE_PARM_DESC(lab_perf_drop, "LAB experiment: send the next N PERF load requests to a non-existent process (they get dropped)");
+
+static int
+lab_pmu_ask(struct nvkm_pmu *pmu, u32 process, u32 message, u32 reply[2])
+{
+	struct nvkm_device *device = pmu->subdev.device;
+	int wait = READ_ONCE(lab_perf_wait_ms);
+	uint drop = READ_ONCE(lab_perf_drop);
+	u32 addr, proc = process;
+	long left;
+
+	if (drop) {
+		WRITE_ONCE(lab_perf_drop, drop - 1);
+		proc = 0x58585858;	/* «XXXX» — такого процесса в прошивке нет */
+	}
+	mutex_lock(&pmu->send.mutex);
+	addr = nvkm_rd32(device, 0x10a4a0);
+	if (nvkm_msec(device, 2000,
+		if (nvkm_rd32(device, 0x10a4b0) != (addr ^ 8))
+			break;
+	) < 0) {
+		mutex_unlock(&pmu->send.mutex);
+		return -EBUSY;
+	}
+	pmu->recv.message = message;
+	pmu->recv.process = process;
+	do {
+		nvkm_wr32(device, 0x10a580, 0x00000001);
+	} while (nvkm_rd32(device, 0x10a580) != 0x00000001);
+	nvkm_wr32(device, 0x10a1c0, 0x01000000 | (((addr & 0x07) << 4) + pmu->send.base));
+	nvkm_wr32(device, 0x10a1c4, proc);
+	nvkm_wr32(device, 0x10a1c4, message);
+	nvkm_wr32(device, 0x10a1c4, 0);
+	nvkm_wr32(device, 0x10a1c4, 0);
+	nvkm_wr32(device, 0x10a4a0, (addr + 1) & 0x0f);
+	nvkm_wr32(device, 0x10a580, 0x00000000);
+
+	if (wait > 0)
+		left = wait_event_timeout(pmu->recv.wait, pmu->recv.process == 0, msecs_to_jiffies(wait));
+	else {
+		wait_event(pmu->recv.wait, pmu->recv.process == 0);
+		left = 1;
+	}
+	if (!left && pmu->recv.process) {
+		pmu->recv.process = 0;
+		lab_perf_timeouts++;
+		mutex_unlock(&pmu->send.mutex);
+		nvkm_warn(&pmu->subdev, "LAB perf: PMU не ответил на запрос итога за %d мс (%d-й раз с загрузки)%s; очереди: в PMU %x/%x, из PMU %x/%x — замер пропускаю\n",
+			  wait, lab_perf_timeouts, proc != process ? " — опыт lab_perf_drop" : "",
+			  nvkm_rd32(device, 0x10a4a0), nvkm_rd32(device, 0x10a4b0),
+			  nvkm_rd32(device, 0x10a4c8), nvkm_rd32(device, 0x10a4cc));
+		return -ETIMEDOUT;
+	}
+	reply[0] = pmu->recv.data[0];
+	reply[1] = pmu->recv.data[1];
+	mutex_unlock(&pmu->send.mutex);
+	return 0;
+}
+
+static void
+lab_perf_work(struct work_struct *w)
+{
+	struct nvkm_pmu *pmu = lab_perf.pmu;
+	int ms = READ_ONCE(lab_perf_ms);
+	int ticks = READ_ONCE(lab_perf_ticks);
+	u32 reply[2];
+
+	if (ticks < 0 && pmu) {	/* 19.11: 100 мс по такту PMU этой карты (кГц · 100) */
+		struct nvkm_clk *clk = pmu->subdev.device->clk;
+		int khz = clk ? nvkm_clk_read(clk, nv_clk_src_pmu) : 0;
+
+		ticks = khz > 0 ? khz * 100 : 0;
+	}
+
+	if (pmu && ticks > 0 && ticks != lab_perf.started &&
+	    !nvkm_pmu_send(pmu, NULL, LAB_PROC_PERF, LAB_PERF_MSG_START, ticks, 0)) {
+		nvkm_info(&pmu->subdev, "LAB perf: прошивке дана команда начать замеры, период %d тактов\n", ticks);
+		lab_perf.started = ticks;
+	}
+	if (pmu && ticks <= 0 && lab_perf.started &&
+	    !nvkm_pmu_send(pmu, NULL, LAB_PROC_PERF, LAB_PERF_MSG_START, 0, 0)) {
+		nvkm_info(&pmu->subdev, "LAB perf: прошивке дана команда прекратить замеры\n");
+		lab_perf.started = 0;
+	}
+	if (ms > 0 && pmu && READ_ONCE(lab_perf_flood) && lab_perf.started) {
+		/* опыт 116: прошивка (host.fuc) забирает очередь драйвера целиком и раскладывает по процессам; у процесса
+		 * очередь на 4 сообщения, лишние выбрасываются молча (kernel.fuc send_proc). START с тем же периодом безвреден:
+		 * замеры уже идут, процесс его проглатывает. Запрос итога придёт следом — и должен пропасть. */
+		uint n = READ_ONCE(lab_perf_flood), k;
+
+		WRITE_ONCE(lab_perf_flood, 0);
+		for (k = 0; k < n; k++)
+			nvkm_pmu_send(pmu, NULL, LAB_PROC_PERF, LAB_PERF_MSG_START, lab_perf.started, 0);
+		nvkm_warn(&pmu->subdev, "LAB perf: опыт 116 — %u сообщений START подряд, следом запрос итога (ожидание %d мс%s)\n",
+			  n, READ_ONCE(lab_perf_wait_ms), READ_ONCE(lab_perf_wait_ms) > 0 ? "" : " — БЕЗ защиты, как nouveau");
+	}
+	if (ms > 0 && pmu &&
+	    !lab_pmu_ask(pmu, LAB_PROC_PERF, LAB_PERF_MSG_LOAD, reply)) {
+		WRITE_ONCE(lab_perf_gr, reply[0]);
+		WRITE_ONCE(lab_perf_vid, reply[1] & 0xffff);
+		WRITE_ONCE(lab_perf_samples, reply[1] >> 16);
+		if (READ_ONCE(lab_perf_log))
+			nvkm_info(&pmu->subdev, "LAB perf: графика %u‰, видео %u‰, замеров %u\n",
+				  reply[0], reply[1] & 0xffff, reply[1] >> 16);
+		lab_gov_step(pmu, reply[0], reply[1] & 0xffff, ms);
+	}
+	if (READ_ONCE(lab_perf.on))
+		schedule_delayed_work(&lab_perf.work, msecs_to_jiffies(ms > 0 ? ms : 1000));
+}
+
+int
+gf100_pmu_init_lab(struct nvkm_pmu *pmu)
+{
+	int ret = gt215_pmu_init(pmu);
+
+	if (ret)
+		return ret;
+	if (!lab_perf.inited) {
+		INIT_DELAYED_WORK(&lab_perf.work, lab_perf_work);
+		lab_perf.inited = true;
+	}
+	lab_perf.pmu = pmu;
+	lab_perf.started = 0;	/* прошивка только что загружена — процесс PERF спит */
+	lab_gov_st.mode = 0;	/* регулятор начнёт заново с текущего режима */
+	WRITE_ONCE(lab_perf.on, true);
+	schedule_delayed_work(&lab_perf.work, msecs_to_jiffies(1000));
+	return 0;
+}
+
+void
+gf100_pmu_fini_lab(struct nvkm_pmu *pmu)
+{
+	if (lab_perf.inited) {
+		WRITE_ONCE(lab_perf.on, false);
+		cancel_delayed_work_sync(&lab_perf.work);
+	}
+	gt215_pmu_fini(pmu);
+}
 
