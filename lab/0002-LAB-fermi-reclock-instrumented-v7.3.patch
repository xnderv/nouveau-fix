+ * SYS2CLK, 0x1373c0/c4 — с источником XBAR2CLK (поле источника — биты 28–30). Драйвер NVIDIA на Fermi (трассы GF104/GF108/GF114)
+ * пользуется 0x1373c0 в том же формате, что счётчик GPC (сброс 0x01010000, затем 0x00110000 | N), источник всегда 0.
+ * lab_cntr_sys — маска: бит 0 — 0x1373b0, бит 1 — 0x1373c0; после каждой смены уровня для каждого счётчика перебрать
+ * источник 0…7, N = 8191 тактов кварца (≈ 303 мкс), записать частоту и частоты узлов по расчёту драйвера.
+ * lab_sys_r1 (−1 — выкл.): в том же замере сначала как есть, потом записать в 0x020164 (главный регистр замедления SYS2CLK)
+ * это значение, повторить замер и вернуть прежнее — замедляет ли SYS2CLK пара «поле B + бит 7» (0x82 после снятия скобки). */
+static uint lab_cntr_sys;
+module_param(lab_cntr_sys, uint, 0644);
+MODULE_PARM_DESC(lab_cntr_sys, "LAB: after each pstate change measure hub-side clock counters, mask: 1 = 0x1373b0, 2 = 0x1373c0; source field (bits 28-30) 0..7 each");
+/* LAB 17.11 (тест 88): контроль и разделение. lab_cntr_split — маска отдельных проходов после прохода «как есть», каждый
+ * отличается от него ОДНИМ и сразу возвращается: 1 — пост-делитель XBAR2CLK (0x137258, поле BYPDIV) вдвое глубже, только если
+ * узел на делителе (03/07) — какой источник 0x1373c0 упадёт вдвое, тот XBAR2CLK; 2 — команда замедления SYS2CLK /2
+ * (0x020184 = 2) — видит ли 0x1373b0 замедление; 4 — команда замедления GPC /2 (0x020180 = 2) — видит ли его 0x1373c0. */
+static uint lab_cntr_split;
+module_param(lab_cntr_split, uint, 0644);
+MODULE_PARM_DESC(lab_cntr_split, "LAB: with lab_cntr_sys, extra passes each restored: 1 = XBAR2CLK post-divider x2, 2 = SYS2CLK command slowdown /2, 4 = GPC command slowdown /2, 8 = copy post-divider x2, 16 = LTC main divider x2, 32 = copy divider source -> 2 (100 MHz?), 64 = LTC PLL reference divider x2 (only while LTC on divider)");
+/* LAB 17.11 (тест 89): неопознанные источники. Драйвер считает узлы copy (idx 9) и MSDCLK (idx 0xe) одинаково: 135 / 405 /
+ * 540 МГц на 03 / 07 / 0f — как 0x1373b0 источники 2 и 3. 8 — пост-делитель copy (0x137274) вдвое глубже: какой из 2/3 упадёт.
+ * 16 — основной делитель LTC2CLK (0x1371d4, поле A) вдвое глубже: на 0f путь простаивает — упадёт ли 0x1373c0 источник 7.
+ * 32 — источник делителя copy (0x137184, SRC) = 2 («100 МГц» у ET): совпадёт ли с 0x1373b0 источник 4 (~100,9 МГц).
+ * 64 — делитель опоры PLL LTC2CLK (0x137144, поля A и B) вдвое глубже, только пока LTC на делителе: упадёт ли один из
+ *      0x1373c0 источников 3–5 (постоянные 405). PLL на это время перезахватывается на половину частоты и возвращается. */
+static int lab_sys_r1 = -1;
+module_param(lab_sys_r1, int, 0644);
+MODULE_PARM_DESC(lab_sys_r1, "LAB: with lab_cntr_sys: measure as is, then with 0x020164 = this value, then restore (-1 = off)");
+
+static void
+lab_cntr_sys_pass(struct gf100_clk *clk, u32 mask, const char *tag)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	static const u32 base[2] = { 0x1373b0, 0x1373c0 };
+	const u32 n = 8191;
+	char buf[220];
+	int r, src, o;
+
+	for (r = 0; r < 2; r++) {
+		u32 save;
+
+		if (!(mask & (1u << r)))
+			continue;
+		save = nvkm_rd32(device, base[r]);
+		o = 0;
+		for (src = 0; src < 8; src++) {
+			u32 c1, c2;
+
+			nvkm_wr32(device, base[r], 0x01010000);
+			nvkm_wr32(device, base[r], ((u32)src << 28) | 0x00110000 | n);
+			nvkm_rd32(device, base[r]);
+			udelay(400);
+			c1 = nvkm_rd32(device, base[r] + 4) & 0xfffff;
+			udelay(100);
+			c2 = nvkm_rd32(device, base[r] + 4) & 0xfffff;
+			o += scnprintf(buf + o, sizeof(buf) - o, " %d:%u%s", src, (u32)div_u64((u64)c2 * 27000, n + 4),
+				       c1 == c2 ? "" : "?");
+		}
+		nvkm_wr32(device, base[r], 0x01010000);
+		nvkm_wr32(device, base[r], save);
+		nvkm_info(&clk->base.subdev, "LAB счётчик %06x (%s; 0x020164 %08x), источник:кГц —%s\n",
+			  base[r], tag, nvkm_rd32(device, 0x020164), buf);
+	}
+}
+
+/* LAB 20.11 (опыт 103): что за «источник 2» у HUB2CLK (hubk01, 0x137180). На GF108 NVIDIA на 0f ставит 0x07000102 / 0x07000002
+ * (код 2, подвыбор 7 в битах 24–26), когда делитель не даёт частоту таблицы; envytools знает у кода 2 только подвыборы
+ * 0 (100 МГц) и 1 (277 МГц). lab_hub01_probe=1: на уровне, где HUB2CLK не на PLL (бит 8 0x137100 = 0), по очереди
+ * ставит код 2 с подвыбором 0..7, без и с битом 8, ~20 мкс, меряет HUB2CLK счётчиком 0x1373b0 (источник 1, окно
+ * 8191 тактов кварца ≈ 0,3 мс) и сразу возвращает исходное значение. Пост-делитель 0x137270 не трогается (пишется в журнал).
+ * Ключ сам сбрасывается в 0 после одного прохода. */
+static uint lab_hub01_probe;
+module_param(lab_hub01_probe, uint, 0644);
+MODULE_PARM_DESC(lab_hub01_probe, "LAB: probe HUB2CLK (0x137180) source code 2 with sub-select 0..7 (bits 24-26), with/without bit 8, and measure it with counter 0x1373b0 source 1; one pass, then resets to 0");
+
+static u32
+lab_hub2_khz(struct nvkm_device *device)
+{
+	const u32 n = 8191;
+	u32 c1, c2;
+
+	nvkm_wr32(device, 0x1373b0, 0x01010000);
+	nvkm_wr32(device, 0x1373b0, (1u << 28) | 0x00110000 | n);
+	nvkm_rd32(device, 0x1373b0);
+	udelay(400);
+	c1 = nvkm_rd32(device, 0x1373b4) & 0xfffff;
+	udelay(50);
+	c2 = nvkm_rd32(device, 0x1373b4) & 0xfffff;
+	return c1 == c2 ? (u32)div_u64((u64)c2 * 27000, n + 4) : 0;
+}
+
+static void
+lab_hub01_probe_run(struct gf100_clk *clk)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 orig, save, post, base_khz, sub, b8;
+	char buf[400];
+	int o = 0;
+
+	if (!READ_ONCE(lab_hub01_probe) || (nvkm_rd32(device, 0x137100) & 0x100))
+		return;
+	WRITE_ONCE(lab_hub01_probe, 0);
+	orig = nvkm_rd32(device, 0x137180);
+	post = nvkm_rd32(device, 0x137270);
+	save = nvkm_rd32(device, 0x1373b0);
+	base_khz = lab_hub2_khz(device);
+	for (b8 = 0; b8 < 2; b8++) {
+		for (sub = 0; sub < 8; sub++) {
+			u32 khz;
+
+			nvkm_wr32(device, 0x137180, (orig & ~0x07000103) | (sub << 24) | (b8 << 8) | 0x2);
+			udelay(20);
+			khz = lab_hub2_khz(device);
+			nvkm_wr32(device, 0x137180, orig);
+			udelay(20);
+			o += scnprintf(buf + o, sizeof(buf) - o, " %s%u:%u", b8 ? "b8/" : "", sub, khz);
+		}
+	}
+	nvkm_wr32(device, 0x1373b0, 0x01010000);
+	nvkm_wr32(device, 0x1373b0, save);
+	nvkm_info(&clk->base.subdev, "LAB hub01-проба: 0x137180 %08x, пост 0x137270 %08x, 0x137100 %08x; PLL: GPC %08x/%08x LTC %08x/%08x XBAR %08x/%08x SYS2 %08x/%08x; HUB2CLK как есть %u кГц, после %u кГц; код 2, подвыбор:кГц —%s\n",
+		  orig, post, nvkm_rd32(device, 0x137100),
+		  nvkm_rd32(device, 0x137000), nvkm_rd32(device, 0x137004), nvkm_rd32(device, 0x137020), nvkm_rd32(device, 0x137024),
+		  nvkm_rd32(device, 0x137040), nvkm_rd32(device, 0x137044), nvkm_rd32(device, 0x1370e0), nvkm_rd32(device, 0x1370e4),
+		  base_khz, lab_hub2_khz(device), buf);
+}
+
+/* LAB 20.11 (опыт 104): карта полей регистров источника — перебор полей с замером счётчиками тактов. lab_src_probe — маска
+ * этапов (каждый бит сбрасывается после своего прохода; этап идёт только на подходящем уровне):
+ *   1 — на 0f (GPC и LTC на PLL): источник делителя GPC 0x137160 и LTC 0x137164; меряем делительный путь (0x1373c0, 6 и 7);
+ *   2 — на 07 (GPC/LTC/XBAR и HUB2CLK не на PLL): опора PLL GPC 0x137120, LTC 0x137124, XBAR 0x137128 (0x1373c0, 3/4/5);
+ *       источник делителя HUB2CLK 0x137180 (0x1373b0, 1) и copy 0x137184 (0x1373b0, 2);
+ *   4 — на 03/07: РАБОЧИЙ источник XBAR2CLK 0x137168 (0x1373c0, 2) — узел под трафиком, риск недогруза/зависания;
+ *   8 — на 03/07: РАБОЧИЙ источник SYS2CLK 0x13717c (0x1373b0, 0) — самый рискованный.
+ * Варианты (от исходного значения): код 0 с кварцем 16–17 = 0…3; код 1; код 2 с подвыбором 0…7; код 3 с переключённым
+ * битом 8, битом 12, битом 31. Каждый ~0,5 мс, затем исходное значение. Для опор PLL после прохода — ждём захват PLL. */
+static uint lab_src_probe;
+module_param(lab_src_probe, uint, 0644);
+MODULE_PARM_DESC(lab_src_probe, "LAB: source-register field probe with clock counters, stage mask: 1 div src GPC/LTC at 0f, 2 PLL ref src GPC/LTC/XBAR + div src HUB2/copy at 07, 4 working src XBAR2CLK at 03/07 (risky), 8 working src SYS2CLK (riskiest); each bit resets after its pass");
+
+static u32
+lab_meas_khz(struct nvkm_device *device, u32 base, u32 src)
+{
+	const u32 n = 8191;
+	u32 c1, c2;
+
+	nvkm_wr32(device, base, 0x01010000);
+	nvkm_wr32(device, base, (src << 28) | 0x00110000 | n);
+	nvkm_rd32(device, base);
+	udelay(400);
+	c1 = nvkm_rd32(device, base + 4) & 0xfffff;
+	udelay(50);
+	c2 = nvkm_rd32(device, base + 4) & 0xfffff;
+	return c1 == c2 ? (u32)div_u64((u64)c2 * 27000, n + 4) : 0;
+}
+
+static void
+lab_src_probe_reg(struct gf100_clk *clk, u32 reg, const char *name, u32 cbase, u32 csrc, u32 pll)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 orig = nvkm_rd32(device, reg), csave = nvkm_rd32(device, cbase), v, k;
+	static char buf[700];	/* 25.11: не в кадре стека (кадр был 1216 байт при пределе 1024); функция не вызывается параллельно */
+	int o = 0;
+	struct { const char *t; u32 val; } var[24];
+	int nv = 0, i;
+
+	for (k = 0; k < 4; k++) {
+		var[nv].t = k == 0 ? "к0/27" : k == 1 ? "к0/s1" : k == 2 ? "к0/s2" : "к0/s3";
+		var[nv++].val = (orig & ~0x07030003) | (k << 16);
+	}
+	var[nv].t = "к1"; var[nv++].val = (orig & ~0x07000003) | 1;
+	for (k = 0; k < 8; k++) {
+		static const char *t[8] = { "к2/0", "к2/1", "к2/2", "к2/3", "к2/4", "к2/5", "к2/6", "к2/7" };
+		var[nv].t = t[k];
+		var[nv++].val = (orig & ~0x07000003) | (k << 24) | 2;
+	}
+	var[nv].t = "^б8";  var[nv++].val = orig ^ 0x00000100;
+	var[nv].t = "^б12"; var[nv++].val = orig ^ 0x00001000;
+	var[nv].t = "^б31"; var[nv++].val = orig ^ 0x80000000;
+
+	o += scnprintf(buf + o, sizeof(buf) - o, " исх:%u", lab_meas_khz(device, cbase, csrc));
+	for (i = 0; i < nv; i++) {
+		nvkm_wr32(device, reg, var[i].val);
+		udelay(20);
+		v = lab_meas_khz(device, cbase, csrc);
+		nvkm_wr32(device, reg, orig);
+		udelay(20);
+		o += scnprintf(buf + o, sizeof(buf) - o, " %s:%u", var[i].t, v);
+	}
+	if (pll) {	/* опора PLL менялась — ждём захват (бит 17), до 2 мс */
+		nvkm_msec(device, 2, if (nvkm_rd32(device, pll) & 0x00020000) break;);
+	}
+	nvkm_wr32(device, cbase, 0x01010000);
+	nvkm_wr32(device, cbase, csave);
+	nvkm_info(&clk->base.subdev, "LAB src-проба %06x (%s; счётчик %06x/%u; исходно %08x%s%s), вариант:кГц —%s\n",
+		  reg, name, cbase, csrc, orig, pll ? ", PLL " : "",
+		  pll ? ((nvkm_rd32(device, pll) & 0x00020000) ? "захвачена" : "НЕ ЗАХВАЧЕНА") : "", buf);
+}
+
+/* LAB 20.11 (опыт 105): РАБОЧИЙ источник SYS2CLK 0x13717c — только «живые» варианты, по ОДНОМУ за запуск, внутри скобки
+ * замедления SYS2CLK (как NVIDIA переключает этот узел). Этап 3 опыта 104 (все варианты без скобки) повесил машину.
+ * lab_sys2_probe = 1: бит 8 (SPPLL1, ~269); 2: код 2/подвыбор 1 (280); 3: код 0/кварц 108; 4: код 2/подвыбор 0 (100,9);
+ * 5: код 0/кварц 27. На 03/07; перед сменой — строка в журнал (если встанет, видно, на чём). Сбрасывается в 0. */
+static uint lab_sys2_probe;
+module_param(lab_sys2_probe, uint, 0644);
+/* LAB 20.11: lab_sys2_post=1 — вместе с источником менять и пост-делитель SYS2CLK 0x13726c (поле A, биты 0–5), чтобы частота
+ * была наибольшей, не выше исходной: источник × 2 / (A + 2) ≤ исходной. Порядок без выброса вверх: туда — источник, потом
+ * делитель; обратно — делитель, потом источник. */
+static uint lab_sys2_post;
+module_param(lab_sys2_post, uint, 0644);
+MODULE_PARM_DESC(lab_sys2_post, "LAB: with lab_sys2_probe also set the SYS2CLK post-divider so the clock stays as close as possible to (never above) the original");
+MODULE_PARM_DESC(lab_sys2_probe, "LAB: one live variant of the WORKING SYS2CLK source 0x13717c inside the SYS2CLK slowdown bracket: 1 bit8/SPPLL1, 2 code2/sub1 (280), 3 code0/108, 4 code2/sub0 (100.9), 5 code0/27; resets to 0");
+
+static void
+lab_sys2_probe_run(struct gf100_clk *clk)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	struct lab_therm_save th = { .on = false };
+	u32 k = READ_ONCE(lab_sys2_probe), orig, val, before, during, after;
+	static const char *name[6] = { "", "бит 8 (SPPLL1)", "код 2/подвыбор 1 (280)", "код 0/кварц 108",
+				       "код 2/подвыбор 0 (100,9)", "код 0/кварц 27" };
+
+	if (!k || k > 5 || (nvkm_rd32(device, 0x137100) & 0x187))
+		return;
+	WRITE_ONCE(lab_sys2_probe, 0);
+	orig = nvkm_rd32(device, 0x13717c);
+	switch (k) {
+	case 1: val = orig ^ 0x00000100; break;
+	case 2: val = (orig & ~0x07030003) | (1 << 24) | 2; break;
+	case 3: val = (orig & ~0x07030003) | (3 << 16); break;
+	case 4: val = (orig & ~0x07030003) | 2; break;
+	default: val = orig & ~0x07030003; break;
+	}
+	{
+		static const u32 src_khz[6] = { 0, 1616700, 280300, 108000, 100900, 27000 };
+		u32 p0 = nvkm_rd32(device, 0x13726c), a0 = p0 & 0x3f, a = a0, fo;
+
+		fo = (p0 & 0x80000000) ? 1620000 * 2 / (a0 + 2) : 1620000;
+		if (READ_ONCE(lab_sys2_post)) {
+			for (a = 0; a < 63 && src_khz[k] * 2 / (a + 2) > fo; a++)
+				;
+		}
+		nvkm_info(&clk->base.subdev, "LAB sys2-проба: НАЧИНАЮ вариант %u — %s: 0x13717c %08x -> %08x; пост-делитель A %u -> %u (ожидаем %u кГц, в скобке вдвое меньше)\n",
+			  k, name[k], orig, val, a0, a, src_khz[k] * 2 / (a + 2));
+		before = lab_meas_khz(device, 0x1373b0, 0);
+		lab_therm_enter(clk, 7, &th);
+		nvkm_wr32(device, 0x13717c, val);			/* туда: сначала источник (частота вниз) */
+		udelay(5);
+		if (a != a0)
+			nvkm_wr32(device, 0x13726c, (p0 & ~0x3f) | 0x80000000 | a);	/* потом делитель (вверх до цели) */
+		udelay(20);
+		during = lab_meas_khz(device, 0x1373b0, 0);
+		if (a != a0)
+			nvkm_wr32(device, 0x13726c, p0);		/* обратно: сначала делитель (вниз) */
+		udelay(5);
+		nvkm_wr32(device, 0x13717c, orig);			/* потом источник */
+		udelay(20);
+		lab_therm_leave(clk, 7, &th);
+	}
+	after = lab_meas_khz(device, 0x1373b0, 0);
+	nvkm_info(&clk->base.subdev, "LAB sys2-проба: вариант %u — %s: SYS2CLK до %u кГц, в скобке с новым источником %u кГц, после %u кГц\n",
+		  k, name[k], before, during, after);
+}
+
+static void
+lab_src_probe_run(struct gf100_clk *clk)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 m = READ_ONCE(lab_src_probe), mux = nvkm_rd32(device, 0x137100);
+
+	if (!m)
+		return;
+	if ((m & 1) && (mux & 0x3) == 0x3) {
+		WRITE_ONCE(lab_src_probe, READ_ONCE(lab_src_probe) & ~1u);
+		lab_src_probe_reg(clk, 0x137160, "делитель GPC", 0x1373c0, 6, 0);
+		lab_src_probe_reg(clk, 0x137164, "делитель LTC", 0x1373c0, 7, 0);
+	}
+	if ((m & 2) && !(mux & 0x107)) {
+		WRITE_ONCE(lab_src_probe, READ_ONCE(lab_src_probe) & ~2u);
+		lab_src_probe_reg(clk, 0x137120, "опора PLL GPC", 0x1373c0, 3, (nvkm_rd32(device, 0x137000) & 1) ? 0x137000 : 0);
+		lab_src_probe_reg(clk, 0x137124, "опора PLL LTC", 0x1373c0, 4, (nvkm_rd32(device, 0x137020) & 1) ? 0x137020 : 0);
+		lab_src_probe_reg(clk, 0x137128, "опора PLL XBAR", 0x1373c0, 5, (nvkm_rd32(device, 0x137040) & 1) ? 0x137040 : 0);
+		lab_src_probe_reg(clk, 0x137180, "делитель HUB2CLK", 0x1373b0, 1, 0);
+		lab_src_probe_reg(clk, 0x137184, "делитель copy", 0x1373b0, 2, 0);
+	}
+	if ((m & 4) && !(mux & 0x187)) {
+		WRITE_ONCE(lab_src_probe, READ_ONCE(lab_src_probe) & ~4u);
+		lab_src_probe_reg(clk, 0x137168, "РАБОЧИЙ XBAR2CLK", 0x1373c0, 2, 0);
+	}
+	if ((m & 8) && !(mux & 0x187)) {
+		WRITE_ONCE(lab_src_probe, READ_ONCE(lab_src_probe) & ~8u);
+		lab_src_probe_reg(clk, 0x13717c, "РАБОЧИЙ SYS2CLK", 0x1373b0, 0, 0);
+	}
+}
+
+static void
+lab_cntr_sys_measure(struct gf100_clk *clk)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 mask = READ_ONCE(lab_cntr_sys) & 3;
+	int v = READ_ONCE(lab_sys_r1);
+
+	if (!mask)
+		return;
+	nvkm_info(&clk->base.subdev, "LAB узлы по расчёту драйвера, кГц: GPC2CLK %u LTC2CLK %u XBAR2CLK %u SYS2CLK %u HUB2CLK %u; "
