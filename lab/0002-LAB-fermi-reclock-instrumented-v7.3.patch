+/* LAB 18.11 (аудит): на выходе из скобки NVIDIA пишет в 0x020160/164, 0x020180/184, 0x0201a0/1a4 то, что было там до первой
+ * скобки, — состояние после init-скрипта VBIOS (9 чипов Fermi). Снимается при инициализации тактов (lab_boot_snapshot), до
+ * первой скобки. У нас это 0 / 0x82, 0 / 0, 0x4040 / 0x4040 — те же числа, что раньше были вписаны в код. */
+static u32 lab_fs_boot[2][3];		/* [i: 0 GPC, 1 hub][0x020160, 0x020180, 0x0201a0] */
+static bool lab_fs_boot_ok;
+
+struct lab_therm_save {
+	bool on; int i; u32 ctrl1, f2, f3, f4;
+	uint us; int np; u32 st0; u32 pv[8]; u32 pt[8]; u32 nrd;
+	bool w; bool wok; u32 wns, wv, wrd;
+	bool fx; bool fxok; u32 fxset, fxns, fxflag;	/* 29.10: фиксированное ожидание от входа */
+	u32 ns;						/* 29.10 Е18: скобка без замедления */
+};
