+/* LAB 16.11, тест 72: когда замедление реально снижает такт GPC — по счётчику тактов (0x134124/0x134128, см. lab_cntr_n,
+ * docs/2026-11-16/gpc-counter.md). lab_cntr_win = N тактов кварца 27 МГц: окно счёта открывается записью прямо перед
+ * запросом замедления в скобке GPC и закрывается само через (N + ~4) тактов кварца по часам карты. Отсчёт читается при
+ * выходе из скобки; окно должно закончиться до переключателя (N·37 нс заметно меньше ожидания). Если такт до момента te
+ * идёт полностью (F = GPC2CLK/2), а после — замедленным (F/s), то te = T·(C − Cs)/(Cf − Cs). Пишется рядом с моментом
+ * признака 0x0201e0 (тот отсчитан по часам процессора от отправки записей — опоры разные, сравнение приблизительное). */
+static uint lab_cntr_win;
+module_param(lab_cntr_win, uint, 0644);
+MODULE_PARM_DESC(lab_cntr_win, "LAB: in the GPC bracket open a GPC clock counter window of N 27 MHz cycles right before the slowdown request and log when the clock actually slowed (0 = off, max 16383; keep N*37ns below the bracket wait)");
+static u32 lab_cw_n, lab_cw_half, lab_cw_code;
+
+static void
+lab_therm_enter(struct gf100_clk *clk, int idx, struct lab_therm_save *sv)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 e2, e3;
+
+	sv->on = false;
+	if (!lab_therm || (idx != 0 && idx != 7))
+		return;
+	/* LAB 21.11: GF119 и GF117 — у NVIDIA скобка в 1 записи из 9 (2012–2017, обе эпохи драйвера; скобки хаба — ни разу).
+	 * Эпохой драйвера не объясняется (на GF114 скобка есть с 270.x, 2011). Ставим (вреда от неё на GF114 не было);
+	 * lab_therm_gf119=0 — без скобки, как NVIDIA в остальных записях. */
+	if ((device->chipset == 0xd9 || device->chipset == 0xd7) && !READ_ONCE(lab_therm_gf119))
+		return;
+	sv->i = (idx == 0) ? 0 : 1;
+	/* LAB 17.11: глубина в ОБА поля, как NVIDIA во всех записях (биты 16–21 «в простое» и 0–5 «по команде») + флаг 7;
+	 * при коде по умолчанию значение прежнее (0x000a008a / 0x00020082). До 17.11 ключ глубины менял только биты 16–21. */
+	e2 = (idx == 0) ? ((lab_therm_gpc_code(device) << 16) | 0x80 | lab_therm_gpc_code(device))
+			: ((lab_therm_hub_code(device) << 16) | 0x80 | lab_therm_hub_code(device));
+	e3 = (idx == 0) ? lab_therm_gpc_code(device) : lab_therm_hub_code(device);
+	sv->ctrl1 = nvkm_rd32(device, 0x020004);
+	sv->f2 = nvkm_rd32(device, 0x020160 + sv->i * 4);
+	sv->f3 = nvkm_rd32(device, 0x020180 + sv->i * 4);
+	sv->f4 = nvkm_rd32(device, 0x0201a0 + sv->i * 4);
+	sv->ns = READ_ONCE(lab_therm_noslow);
+	lab_cw_n = 0;
+	if (idx == 0 && READ_ONCE(lab_cntr_win)) {
+		/* LAB 16.11: окно счётчика GPC открывается прямо перед запросом замедления (записи идут по порядку) */
+		lab_cw_half = (u32)max(read_clk(clk, 0x00), 0) / 2;
+		lab_cw_code = e3 & 0x3f;
+		lab_cw_n = min_t(u32, READ_ONCE(lab_cntr_win), 0x3fff);
+		nvkm_wr32(device, 0x134124, 0x01000000);
+		nvkm_wr32(device, 0x134124, 0x00110000 | lab_cw_n);
+	}
+	if (!sv->ns) {
+		nvkm_wr32(device, 0x020160 + sv->i * 4, e2);
+		nvkm_wr32(device, 0x020180 + sv->i * 4, e3);
+		nvkm_wr32(device, 0x0201a0 + sv->i * 4, 0x00004040);
+	}
+	nvkm_wr32(device, 0x020004, sv->ctrl1 & ~READ_ONCE(lab_therm_ctrl1_clr));
+	sv->on = true;
+	sv->us = (idx == 0 && lab_therm_us_gpc) ? lab_therm_us_gpc :
+		 (idx == 7 && lab_therm_us_hub) ? lab_therm_us_hub : lab_therm_us;
+	sv->np = 0;
+	sv->nrd = 0;
+	sv->w = false;
+	sv->fx = false;
+	if ((idx == 0 && lab_therm_fixed_ns) || (idx == 7 && lab_therm_fixed_hub_ns) || READ_ONCE(lab_therm_wait_nv)) {
+		u32 want = 0x00020000 | (e3 & 0x3f);
+		u32 fixed = idx == 0 ? READ_ONCE(lab_therm_fixed_ns) : READ_ONCE(lab_therm_fixed_hub_ns);
+		u32 set = fixed ? clamp_t(u32, fixed, min_t(u32, READ_ONCE(lab_therm_fixed_floor_ns), 50000), 50000)
+				: max_t(u32, lab_therm_nv_ns(device, e3 & 0x3f, idx == 0), 2000);
+		u64 t0 = ktime_get_ns(), dt;
+		u32 v;
+
+		sv->fx = true;
+		sv->fxok = false;
+		sv->fxset = set;
+		sv->fxflag = 0;
+		do {
+			v = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+			dt = ktime_get_ns() - t0;
+			if (!sv->fxok && (v & 0x0002003f) == want) {
+				sv->fxok = true;
+				sv->fxflag = (u32)dt;
+			}
+		} while (dt < set);
+		sv->fxns = (u32)dt;
+	} else if (lab_therm_wait) {
+		u32 want = 0x00020000 | (e3 & 0x3f);
+		u64 t0 = ktime_get_ns(), dt;
+		u32 v;
+
+		sv->w = true;
+		sv->wok = false;
+		sv->wrd = 0;
+		do {
+			v = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+			sv->wrd++;
+			dt = ktime_get_ns() - t0;
+			if ((v & 0x0002003f) == want) {
+				sv->wok = true;
+				break;
+			}
+		} while (dt < 100000ULL);
+		sv->wns = (u32)dt;
+		sv->wv = v;
+		if (lab_therm_wait_us)
+			udelay(lab_therm_wait_us);
+	} else if (lab_therm_probe) {
+		u64 t0 = ktime_get_ns(), lim = (u64)sv->us * 1000ULL, dt;
+		u32 last, v;
+
+		sv->st0 = last = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+		do {
+			v = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+			sv->nrd++;
+			dt = ktime_get_ns() - t0;
+			if (v != last && sv->np < 8) {
+				sv->pv[sv->np] = v;
+				sv->pt[sv->np] = (u32)dt;
+				sv->np++;
+				last = v;
+			}
+		} while (dt < lim);
+	} else if (sv->us) {
+		udelay(sv->us);
+	}
+}
+
+static void
+lab_therm_leave(struct gf100_clk *clk, int idx, struct lab_therm_save *sv)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 x2 = (idx == 0) ? 0x00000000 : 0x00000082, x3 = 0, x4 = 0x00004040;
+
+	if (!sv->on)
+		return;
+	if (lab_fs_boot_ok) {		/* 18.11: как NVIDIA — состояние до первой скобки (VBIOS) */
+		x2 = lab_fs_boot[sv->i][0];
+		x3 = lab_fs_boot[sv->i][1];
+		x4 = lab_fs_boot[sv->i][2];
+	}
+	if (!sv->ns) {
+		nvkm_wr32(device, 0x020160 + sv->i * 4, lab_therm >= 2 ? sv->f2 : x2);
+		nvkm_wr32(device, 0x020180 + sv->i * 4, lab_therm >= 2 ? sv->f3 : x3);
+		nvkm_wr32(device, 0x0201a0 + sv->i * 4, lab_therm >= 2 ? sv->f4 : x4);
+	}
+	nvkm_wr32(device, 0x020004, sv->ctrl1);
+	nvkm_info(&clk->base.subdev, "LAB therm %s (FSRM %d): %s%u мкс; до FSRM2 %08x FSRM3 %08x FSRM4 %08x CTRL1 %08x; после %08x %08x %08x %08x; статус %08x\n",
+		  lab_nn(idx), sv->i, sv->w ? "по признаку, запас " : "выдержка ", sv->w ? lab_therm_wait_us : sv->us,
+		  sv->f2, sv->f3, sv->f4, sv->ctrl1,
+		  nvkm_rd32(device, 0x020160 + sv->i * 4), nvkm_rd32(device, 0x020180 + sv->i * 4),
+		  nvkm_rd32(device, 0x0201a0 + sv->i * 4), nvkm_rd32(device, 0x020004), nvkm_rd32(device, 0x0201e0 + sv->i * 4));
+	if (sv->w)
+		nvkm_info(&clk->base.subdev, "LAB therm wait %s: %s через %u нс (чтений %u, статус %08x), запас %u мкс\n",
+			  lab_nn(idx), sv->wok ? "признак" : "ТАЙМАУТ 100 мкс, признака нет,", sv->wns, sv->wrd, sv->wv, lab_therm_wait_us);
+	if (sv->fx)
+		nvkm_info(&clk->base.subdev, "LAB therm fixed %s: ждал %u нс от входа (задано %u), признак %s%u нс\n",
+			  lab_nn(idx), sv->fxns, sv->fxset, sv->fxok ? "через " : "НЕ поднялся до переключения, ждали ", sv->fxok ? sv->fxflag : sv->fxns);
+	if (idx == 0 && lab_cw_n) {
+		u32 c = nvkm_rd32(device, 0x134128) & 0xfffff, s2 = lab_cw_code + 2;	/* делитель s = s2/2 */
+		u64 cf = div_u64((u64)lab_cw_half * (lab_cw_n + 4), 27000);		/* отсчёт без замедления */
+		u64 cs = div_u64(cf * 2, s2);						/* отсчёт с полным замедлением */
+		u32 tw = (u32)div_u64((u64)(lab_cw_n + 4) * 1000000, 27000);		/* окно, нс */
+		u32 te = c >= cf ? tw : c <= cs ? 0 : (u32)div_u64((u64)tw * (c - cs), (u32)(cf - cs));
+
+		nvkm_wr32(device, 0x134124, 0x00000000);
+		nvkm_info(&clk->base.subdev, "LAB счётчик в скобке GPC: окно %u нс (N %u), отсчёт %u, без замедления было бы %llu, "
+			  "с полным /%u.%u — %llu; такт снижен через ≈ %u нс от начала окна%s; признак %s%u нс (часы процессора)\n",
+			  tw, lab_cw_n, c, cf, s2 / 2, (s2 & 1) ? 5 : 0, cs, te,
+			  c >= cf ? " (НЕ снижен в окне)" : c <= cs ? " (снижен сразу)" : "",
+			  !sv->fx ? "не мерили " : sv->fxok ? "через " : "не поднялся, ждали ", sv->fx ? (sv->fxok ? sv->fxflag : sv->fxns) : 0);
+		lab_cw_n = 0;
+	}
+	if (lab_therm_probe && !sv->w) {
+		char buf[200];
+		int k, o = 0;
+
+		for (k = 0; k < sv->np && o < (int)sizeof(buf) - 24; k++)
+			o += scnprintf(buf + o, sizeof(buf) - o, " %u нс:%08x", sv->pt[k], sv->pv[k]);
+		nvkm_info(&clk->base.subdev, "LAB therm probe %s: статус сразу после записи %08x, чтений %u, изменений %d:%s\n",
+			  lab_nn(idx), sv->st0, sv->nrd, sv->np, sv->np ? buf : " нет");
+	}
+	sv->on = false;
+}
