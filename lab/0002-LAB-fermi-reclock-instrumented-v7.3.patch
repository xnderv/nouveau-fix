+static uint lab_therm_div = 1;
+module_param(lab_therm_div, uint, 0644);
+MODULE_PARM_DESC(lab_therm_div, "LAB: PTHERM bracket around GPC/hubk06 post-divider writes (stage 4): 0 off, 1 when it changes, 2 always");
