+/* LAB 16.11, шаг 1 «скобка на карте»: время включения замедления GPC без PCIe и процессора. После смены уровня драйвер
+ * lab_pmu_slow раз собирает сценарий memx и отдаёт его PMU (как скрипты памяти): сброс и включение счётчика тактов GPC на
+ * lab_pmu_slow_win тактов кварца → запрос замедления GPC (те же три записи FSRM, что в скобке, без CTRL_1) → пауза 8000 нс
+ * по часам PMU → снять замедление (вернуть прежние значения). Переключатель НЕ трогается: частота узла не меняется, только
+ * замедляется и возвращается. Отсчёт читается после сценария; момент снижения такта — как в lab_cntr_win (te от открытия
+ * окна; между открытием окна и приходом запроса — две записи PMU по внутренней шине). */
+static uint lab_pmu_slow;
+module_param(lab_pmu_slow, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_slow, "LAB: after each pstate change run N PMU (memx) scripts: GPC counter window + GPC slowdown request + 8 us + release, no clock switch; log when the clock actually slowed (0 = off, max 20)");
+/* LAB 16.11 вечер: lab_pmu_slow_rel=1 — мерить не включение, а ОТПУСКАНИЕ замедления: запрос → 8000 нс → окно счётчика
+ * открывается → снять замедление; отсчёт показывает, через сколько после снятия такт возвращается к полному. */
+static uint lab_pmu_slow_rel;
+module_param(lab_pmu_slow_rel, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_slow_rel, "LAB: lab_pmu_slow mode: 0 engagement, 1 RELEASE, 2 STEADY (window opens 8 us after the request, closes before the release: the fully slowed clock)");
+/* LAB 17.11: lab_pmu_slow_val — своё значение регистра замедления GPC 0x020160 для замера (0 — как обычно: код глубины в оба
+ * поля + бит 7). 0x020180 пишется полем B (биты 0–5) этого значения, как NVIDIA. Вопрос автора: бит 7 выбирает, какое поле
+ * действует (B «по команде» или A «в простое»)? */
+static uint lab_pmu_slow_val;
+module_param(lab_pmu_slow_val, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_slow_val, "LAB: raw value for the GPC slowdown register 0x020160 in lab_pmu_slow probes (0 = depth code in both fields + bit 7); 0x020180 gets bits 0-5 of it");
+/* LAB 17.11 (тест 84): какой регистр задаёт глубину. Часть 0б теста 83: поле A 0x020160 не действует, глубина = поле B, но
+ * 0x020180 там всегда равнялся B. lab_pmu_slow_f3 — своё значение 0x020180 (−1 — как раньше: B), lab_pmu_slow_f4 — своё
+ * значение 0x0201a0 (−1 — 0x4040, как NVIDIA). В режиме 2 после сценария процессор повторяет те же три записи, через 20 мкс
+ * читает признак 0x0201e0 (какую глубину показывает карта) и возвращает регистры. */
+static int lab_pmu_slow_f3 = -1;
+module_param(lab_pmu_slow_f3, int, 0644);
+MODULE_PARM_DESC(lab_pmu_slow_f3, "LAB: lab_pmu_slow probes: value for 0x020180 (-1 = field B of the 0x020160 value, as NVIDIA)");
+static int lab_pmu_slow_f4 = -1;
+module_param(lab_pmu_slow_f4, int, 0644);
+MODULE_PARM_DESC(lab_pmu_slow_f4, "LAB: lab_pmu_slow probes: value for 0x0201a0 (-1 = 0x4040, as NVIDIA)");
+static uint lab_pmu_slow_win = 189;
+module_param(lab_pmu_slow_win, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_slow_win, "LAB: counter window for lab_pmu_slow, 27 MHz cycles (default 189 = 7.15 us, must end before the 8 us release)");
+
+static void
+lab_pmu_slow_probe(struct gf100_clk *clk)
+{
+	struct nvkm_subdev *subdev = &clk->base.subdev;
+	struct nvkm_device *device = subdev->device;
+	u32 reps = min_t(u32, READ_ONCE(lab_pmu_slow), 20), n = min_t(u32, READ_ONCE(lab_pmu_slow_win), 0x3fff);
+	u32 code = lab_therm_gpc_code(device), s2 = code + 2;
+	u32 half = (u32)max(read_clk(clk, 0x00), 0) / 2;
+	u64 cf = div_u64((u64)half * (n + 4), 27000), cs = div_u64(cf * 2, s2);
+	u32 tw = (u32)div_u64((u64)(n + 4) * 1000000, 27000);
+	u32 rel = READ_ONCE(lab_pmu_slow_rel), rv = READ_ONCE(lab_pmu_slow_val);
+	int k3 = READ_ONCE(lab_pmu_slow_f3), k4 = READ_ONCE(lab_pmu_slow_f4);
+	u32 v2 = rv ? rv : ((code << 16) | 0x80 | code);
+	u32 v3 = k3 >= 0 ? (u32)k3 : (v2 & 0x3f), v4 = k4 >= 0 ? (u32)k4 : 0x00004040;
+	u32 r;
+
+	if (!reps || !n || !device->pmu)
+		return;
+	for (r = 0; r < reps; r++) {
+		struct nvkm_memx *memx;
+		u32 f2 = nvkm_rd32(device, 0x020160), f3 = nvkm_rd32(device, 0x020180), f4 = nvkm_rd32(device, 0x0201a0);
+		u32 c, te;
+		u64 t0;
+		int ret = nvkm_memx_init(device->pmu, &memx);
+
+		if (ret) {
+			nvkm_info(subdev, "LAB PMU-замедление: memx недоступен (%d)\n", ret);
+			return;
+		}
+		if (!rel) {
+			nvkm_memx_wr32(memx, 0x134124, 0x01000000);
+			nvkm_memx_wr32(memx, 0x134124, 0x00110000 | n);
+		}
+		nvkm_memx_wr32(memx, 0x020160, v2);	/* по умолчанию оба поля + бит 7, как NVIDIA (17.11) */
+		nvkm_memx_wr32(memx, 0x020180, v3);
+		nvkm_memx_wr32(memx, 0x0201a0, v4);
+		nvkm_memx_nsec(memx, 8000);
+		if (rel) {
+			nvkm_memx_wr32(memx, 0x134124, 0x01000000);
+			nvkm_memx_wr32(memx, 0x134124, 0x00110000 | n);
+		}
+		if (rel == 2)
+			nvkm_memx_nsec(memx, tw + 500);	/* устоявшееся: окно целиком под замедлением */
+		nvkm_memx_wr32(memx, 0x020160, f2);
+		nvkm_memx_wr32(memx, 0x020180, f3);
+		nvkm_memx_wr32(memx, 0x0201a0, f4);
+		if (rel == 1)
+			nvkm_memx_nsec(memx, tw + 500);	/* окно успевает закончиться до конца сценария */
+		t0 = ktime_get_ns();
+		nvkm_memx_fini(&memx, true);
+		c = nvkm_rd32(device, 0x134128) & 0xfffff;
+		nvkm_wr32(device, 0x134124, 0x00000000);
+		/* страховка: вернуть замедление в прежнее состояние и с процессора (если сценарий не дошёл до конца) */
+		nvkm_wr32(device, 0x020160, f2);
+		nvkm_wr32(device, 0x020180, f3);
+		nvkm_wr32(device, 0x0201a0, f4);
+		if (!rel) {
+			te = c >= cf ? tw : c <= cs ? 0 : (u32)div_u64((u64)tw * (c - cs), (u32)(cf - cs));
+			nvkm_info(subdev, "LAB PMU-замедление %u/%u: GPC %u кГц, /%u.%u, окно %u нс, отсчёт %u (без замедления %llu, с полным %llu); "
+				  "такт снижен через ≈ %u нс от начала окна%s; сценарий с ожиданием ответа %llu нс\n",
+				  r + 1, reps, half, s2 / 2, (s2 & 1) ? 5 : 0, tw, c, cf, cs, te,
+				  c >= cf ? " (НЕ снижен в окне)" : c <= cs ? " (снижен сразу)" : "", ktime_get_ns() - t0);
+		} else if (rel == 2) {
+			u32 st;
+
+			nvkm_wr32(device, 0x020160, v2);
+			nvkm_wr32(device, 0x020180, v3);
+			nvkm_wr32(device, 0x0201a0, v4);
+			udelay(20);
+			st = nvkm_rd32(device, 0x0201e0);
+			nvkm_wr32(device, 0x020160, f2);
+			nvkm_wr32(device, 0x020180, f3);
+			nvkm_wr32(device, 0x0201a0, f4);
+			nvkm_info(subdev, "LAB PMU-устоявшееся %u/%u: GPC %u кГц, 0x020160 = %08x, 0x020180 = %08x, 0x0201a0 = %08x, окно %u нс, "
+				  "отсчёт %u (полный %llu): такт замедлен в %u.%02u раза; признак 0x0201e0 = %08x (делитель %u, действует %u)\n",
+				  r + 1, reps, half, v2, v3, v4, tw, c, cf,
+				  c ? (u32)div_u64(cf, c) : 0, c ? (u32)(div_u64(cf * 100, c) % 100) : 0,
+				  st, st & 0x3f, (st >> 17) & 1);
+		} else {
+			/* до момента tr такт замедлен, после — полный: c = cs·tr/T + cf·(T − tr)/T */
+			te = c <= cs ? tw : c >= cf ? 0 : (u32)div_u64((u64)tw * (cf - c), (u32)(cf - cs));
+			nvkm_info(subdev, "LAB PMU-отпускание %u/%u: GPC %u кГц, /%u.%u, окно %u нс, отсчёт %u (полный %llu, замедленный %llu); "
+				  "такт вернулся к полному через ≈ %u нс от начала окна%s; сценарий с ожиданием ответа %llu нс\n",
+				  r + 1, reps, half, s2 / 2, (s2 & 1) ? 5 : 0, tw, c, cf, cs, te,
+				  c <= cs ? " (НЕ вернулся в окне)" : c >= cf ? " (вернулся сразу)" : "", ktime_get_ns() - t0);
+		}
+	}
+}
