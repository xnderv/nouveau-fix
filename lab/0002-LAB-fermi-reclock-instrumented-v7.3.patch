+/* LAB 16.11 вечер: как вытащить застрявший переключатель GPC (PLL -> делитель). Применяется в mux_guard перед каждым
+ * повтором, внутри скобки. lab_mux_recover — по одному способу за опыт: 1 — вернуть бит переключателя на PLL и тут же снова
+ * на делитель (повтор ниже); 2 — перезапустить основной делитель (бит 31 0x1371d0 снять и вернуть); 4 — заново записать
+ * источник делителя 0x137160 тем же значением. 0 — как было (только повтор). */
+static uint lab_mux_recover;
+module_param(lab_mux_recover, uint, 0644);
+MODULE_PARM_DESC(lab_mux_recover, "LAB: GPC mux stuck on PLL: before each mux_guard retry 1 = set the mux bit back to PLL first, 2 = restart the main divider (toggle bit 31 of 0x1371d0), 4 = rewrite the divider source 0x137160 (0 = plain retry)");
+
+static void
+lab_mux_try_recover(struct gf100_clk *clk, int t)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 m = READ_ONCE(lab_mux_recover);
+
+	if (m & 1) {
+		nvkm_mask(device, 0x137100, 0x00000001, 0x00000001);
+		udelay(1);
+		nvkm_error(&clk->base.subdev, "LAB mux_recover попытка %d: бит GPC снова на PLL (137100 %08x)\n", t, nvkm_rd32(device, 0x137100));
+	}
+	if (m & 2) {
+		u32 d = nvkm_rd32(device, 0x1371d0);
+
+		nvkm_wr32(device, 0x1371d0, d & ~0x80000000);
+		udelay(1);
+		nvkm_wr32(device, 0x1371d0, d);
+		nvkm_error(&clk->base.subdev, "LAB mux_recover попытка %d: делитель перезапущен (1371d0 %08x)\n", t, nvkm_rd32(device, 0x1371d0));
+	}
+	if (m & 4) {
+		u32 v = nvkm_rd32(device, 0x137160);
+
+		nvkm_wr32(device, 0x137160, v);
+		nvkm_error(&clk->base.subdev, "LAB mux_recover попытка %d: источник делителя записан заново (137160 %08x)\n", t, v);
+	}
+}
