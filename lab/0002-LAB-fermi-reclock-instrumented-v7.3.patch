+/* LAB 02.11, Е17: ожидание в скобке, как его СЧИТАЕТ NVIDIA 390, — из 0x020130 (пишет init-скрипт VBIOS) и 0x020144
+ * (docs/2026-11-01/didt-evolution.md, §6). Два пути кода у NVIDIA:
+ *   GF100/GF104/GF106/GF108 (0x020144 не читает): T = 2^(b1 + 6) тактов 27 МГц (GF106 030a — 18,96 мкс, GF108M 060c — 151,7);
+ *   GF110/GF114/GF116/GF117/GF119: T = код · 2^b1 тактов 27 МГц + C, C = 2,5 мкс при бите 7 в 0x020144, иначе 1,0 мкс
+ *   (наша GF114 040a: GPC 8,2, hub 3,7; измерено 7,3–8,5 и 3,6–5,1);
+ * b1 — байт 1 (биты 8–11) 0x020130, код — код замедления домена. GF104 в разных записях шёл обоими путями — берётся больший.
+ * Сверху запас lab_therm_wait_nv_margin_ns. Ожидание — от входа в скобку, признак только пишется в журнал (как lab_therm_fixed_ns).
+ * lab_therm_wait_nv=1 действует, если lab_therm_fixed_ns / lab_therm_fixed_hub_ns не заданы. */
+static uint lab_therm_wait_nv = 2;	/* 19.11: по умолчанию как служба (набор 18.11) */
+module_param(lab_therm_wait_nv, uint, 0644);
+MODULE_PARM_DESC(lab_therm_wait_nv, "LAB: bracket wait computed as NVIDIA 390 from 0x020130/0x020144 (0 off, 1 = 27 MHz tick formula of 02.11, 2 = whole-microsecond model of 13.11)");
+static uint lab_therm_wait_nv_margin_ns = 0;	/* 19.11: по умолчанию как служба (набор 18.11) */
+module_param(lab_therm_wait_nv_margin_ns, uint, 0644);
+MODULE_PARM_DESC(lab_therm_wait_nv_margin_ns, "LAB: margin added to the computed NVIDIA wait, ns (default 500)");
+/* LAB 13.11: lab_therm_wait_nv=2 — путь GF11x в целых микросекундах (docs/2026-11-01/didt-evolution.md, §9; 30 интервалов
+ * из 30 по записям NVIDIA 390): GPC T = 1 + bit7 + ceil(s · 2^b1 / 16) мкс, hub T = 2 + bit7 + floor(2^b1 / 16) мкс,
+ * s — делитель замедления домена (код = 2s − 2), bit7 — бит 7 в 0x020144. Наша GF114 040a: 8 и 4 мкс ровно, как у NVIDIA.
+ * Путь GF10x (GF100/GF106/GF108) не меняется. Запас lab_therm_wait_nv_margin_ns добавляется как раньше. */
+static u32
+lab_therm_nv_ns(struct nvkm_device *device, u32 code, bool gpc)
+{
+	u32 b1 = (nvkm_rd32(device, 0x020130) >> 8) & 0xf;
+	u32 bit7 = (nvkm_rd32(device, 0x020144) & 0x80) ? 1 : 0;
+	u32 c = bit7 ? 2500 : 1000;
+	u32 t10 = (u32)(((1ULL << (b1 + 6)) * 1000) / 27);		/* GF10x */
+	u32 t11 = (u32)(((u64)code * (1ULL << b1) * 1000) / 27) + c;	/* GF11x, формула 02.11 */
+	u32 t;
+
+	if (READ_ONCE(lab_therm_wait_nv) == 2) {			/* GF11x, модель 13.11 */
+		u32 s = (code + 2) / 2;
+
+		t11 = gpc ? 1000 * (1 + bit7 + DIV_ROUND_UP(s << b1, 16))
+			  : 1000 * (2 + bit7 + ((1u << b1) >> 4));
+	}
+	switch (device->chipset) {
+	case 0xc0: case 0xc1: case 0xc3: t = t10; break;
+	case 0xc4: t = max(t10, t11); break;
+	default: t = t11; break;
+	}
+	return min_t(u32, t + READ_ONCE(lab_therm_wait_nv_margin_ns), 300000);
+}
