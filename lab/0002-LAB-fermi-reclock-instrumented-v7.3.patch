+/* LAB 24.11 (нашёл тестировщик GT 630M; сверено по записям трёх плат GF108): у DDR3 источник такта памяти переключает
+ * регистр 0x137360 (2 — PLL, 3 — делитель), а бит 1 регистра 0x1373f0 скрипты DDR3 не ставят вовсе. По одному 0x1373f0 память
+ * на PLL читалась как «на делителе»: после подъёма следующий спуск был бы отклонён. Частота на PLL — из коэффициентов
+ * 0x132004 и делителя опоры 0x137330 (405 МГц × N / M / P), с привязкой к ближайшему уровню платы в пределах 2 % (в VBIOS 900,
+ * NVIDIA ставит 896). У GDDR5 в 0x137360 стоит 1 (или 3 после POST) — там всё по-прежнему. */
+static int
+lab_cur_mhz(struct nvkm_device *device)
+{
+	if ((nvkm_rd32(device, 0x137360) & 0x00000003) == 0x00000002) {
+		u32 c = nvkm_rd32(device, 0x132004), r = nvkm_rd32(device, 0x137330);
+		u32 P = (c >> 16) & 0x3f, N = (c >> 8) & 0xff, M = c & 0xff, ref = 1620000;	/* кГц */
+		int mhz, lv[3], i;
+
+		if (r & 0x80000000) {
+			if (nvkm_rd32(device, 0x137320) & 0x00000100)
+				r >>= 8;
+			ref = 3240000 / ((r & 0x3f) + 2);
+		}
+		mhz = (M && P) ? ref * N / M / P / 1000 : 0;
+		if (lab_board) {
+			lv[0] = lab_board->lo; lv[1] = lab_board->mid; lv[2] = lab_board->hi;
+			for (i = 0; i < 3; i++)
+				if (abs(mhz - lv[i]) * 50 <= lv[i])
+					return lv[i];
+		}
+		return mhz;
+	}
+	if (nvkm_rd32(device, 0x1373f0) & 0x00000002)
+		return lab_board ? lab_board->hi : 2004;
+	return 3240 / (((nvkm_rd32(device, 0x137310) >> 8) & 0x3f) + 2);
