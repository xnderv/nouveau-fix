+		   "GR 400700 %08x 400500 %08x; 002640 %08x; SPPLL0 %08x/%08x SPPLL1 %08x/%08x\n", what, lab_nn(idx),
+		   nvkm_rd32(device, 0x137100), nvkm_rd32(device, pll), nvkm_rd32(device, pll + 4),
+		   nvkm_rd32(device, 0x137120 + (idx & 7) * 4), nvkm_rd32(device, 0x137140 + (idx & 7) * 4),
+		   nvkm_rd32(device, 0x137160 + idx * 4), idx <= 2 ? nvkm_rd32(device, 0x1371d0 + idx * 4) : 0,
+		   nvkm_rd32(device, 0x137250 + idx * 4),
