+		if (tgt != b->hi) p[n++] = LAB_G6_C1;
+		if (tgt == b->lo) { p[n++] = LAB_G6_E1; p[n++] = LAB_G6_E2; }
+		break;
+	case G6_HI_BBOOT:
+	case G6_HI_B:
+		p[n++] = (st == G6_HI_BBOOT) ? LAB_G6_C1 : LAB_G6_C;
+		if (tgt == b->lo) { p[n++] = LAB_G6_E1; p[n++] = LAB_G6_E2; }
+		break;
+	case G6_MID_C:
+		p[n++] = LAB_G6_E1; p[n++] = LAB_G6_E2;
+		if (tgt == b->hi) p[n++] = LAB_G6_B;
+		break;
+	case G6_LO:
+		p[n++] = LAB_G6_B;
+		if (tgt == b->mid) p[n++] = LAB_G6_C;
+		break;
+	default:
+		nvkm_error(subdev, "LAB replay: память %d МГц, состояние после шагов неизвестно (0x132000=%08x) — память не трогаю\n",
+			   cur, nvkm_rd32(subdev->device, 0x132000));
+		return -EINVAL;
+	}
+	return n;
+}
+
+/* LAB 21.11: состояние памяти GF108 — какой шаг выполнен последним; после загрузки модуля — «после POST» (324 МГц,
+ * 0x132000 = 0x18000000; первый подъём — A). Переходы — только записанные: 324->896 A/C, 135->896 E, 896->324 B/F (по тому,
+ * откуда пришли на 896), 324->135 D; 135->324 = E, F; после POST на 135 = A, B, D. Неизвестное состояние — память не трогаем. */
+enum { G8_UNKNOWN, G8_POST, G8_HI_M, G8_HI_L, G8_MID, G8_LO };
+static int lab_g8_state = G8_POST;
+static void
+lab_g8_after(int step)
+{
+	switch (step) {
+	case LAB_G8_A:
+	case LAB_G8_C: lab_g8_state = G8_HI_M; break;
+	case LAB_G8_E: lab_g8_state = G8_HI_L; break;
+	case LAB_G8_B:
+	case LAB_G8_F: lab_g8_state = G8_MID; break;
+	case LAB_G8_D: lab_g8_state = G8_LO; break;
+	default:       lab_g8_state = G8_UNKNOWN; break;
+	}
+}
+static int
+lab_plan_gf108(struct nvkm_subdev *subdev, const struct lab_board *b, int cur, int tgt, int *p)
+{
+	int n = 0, st = lab_g8_state;
+
+	if (cur == tgt)
+		return 0;
+	if ((st == G8_POST || st == G8_MID) && cur != b->mid) st = G8_UNKNOWN;
+	if ((st == G8_HI_M || st == G8_HI_L) && cur != b->hi) st = G8_UNKNOWN;
+	if (st == G8_LO && cur != b->lo) st = G8_UNKNOWN;
+	switch (st) {
+	case G8_POST:
+		p[n++] = LAB_G8_A;
+		if (tgt == b->lo) { p[n++] = LAB_G8_B; p[n++] = LAB_G8_D; }
+		break;
+	case G8_MID:
+		p[n++] = (tgt == b->hi) ? LAB_G8_C : LAB_G8_D;
+		break;
+	case G8_HI_M:
+	case G8_HI_L:
+		p[n++] = (st == G8_HI_M) ? LAB_G8_B : LAB_G8_F;
+		if (tgt == b->lo) p[n++] = LAB_G8_D;
+		break;
+	case G8_LO:
+		p[n++] = LAB_G8_E;
+		if (tgt == b->mid) p[n++] = LAB_G8_F;
+		break;
+	default:
+		nvkm_error(subdev, "LAB replay: память %d МГц, состояние после шагов неизвестно (0x132000=%08x) — память не трогаю\n",
+			   cur, nvkm_rd32(subdev->device, 0x132000));
+		return -EINVAL;
+	}
+	return n;
+}
+
+/* LAB 23.11: состояние памяти Quadro 600 — после загрузки 324 на делителе (POST); после A/C — верх (PLL); после B — 324 на PLL.
+ * Уровень 135 не записан: цель 135 считается 324 (память остаётся). Неизвестное состояние — память не трогаем.
+ * 26.11: the state is read from the registers at every plan (0x137360: 2 PLL, 3 divider; frequency from lab_cur_mhz).
+ * Until then it was a software copy that started at "POST" on module load: after a module reload at the top level or a
+ * suspend/resume it no longer matched the card, the wrong script ran and the GPU hung (found by the board's tester). */
+enum { Q6_UNKNOWN, Q6_POST, Q6_HI, Q6_MID };
+static int
+lab_plan_q600(struct nvkm_subdev *subdev, const struct lab_board *b, int cur, int tgt, int *p)
+{
+	bool pll = (nvkm_rd32(subdev->device, 0x137360) & 0x00000003) == 0x00000002;
+	int lab_q6_state = (!pll && cur == b->mid) ? Q6_POST : (pll && cur == b->mid) ? Q6_MID :
+			   (pll && cur == b->hi) ? Q6_HI : Q6_UNKNOWN;
+
+	if (tgt == b->lo) {
+		nvkm_info(subdev, "LAB replay: уровня памяти %d МГц в записи этой платы нет — цель %d МГц\n", b->lo, b->mid);
+		tgt = b->mid;
+	}
+	switch (lab_q6_state) {
+	case Q6_POST: if (tgt == b->hi) { p[0] = LAB_Q6_A; return 1; } return 0;
+	case Q6_MID:  if (tgt == b->hi) { p[0] = LAB_Q6_C; return 1; } return 0;
+	case Q6_HI:   if (tgt != b->hi) { p[0] = LAB_Q6_B; return 1; } return 0;
+	default:
+		nvkm_error(subdev, "LAB replay: память %d МГц (%s; 0x137360=%08x 0x132004=%08x) — такого состояния в записи нет, память не трогаю\n",
+			   cur, pll ? "PLL" : "делитель", nvkm_rd32(subdev->device, 0x137360), nvkm_rd32(subdev->device, 0x132004));
+		return -EINVAL;
+	}
+}
+
+/* 26.11: plan for the Palit GTX 550 Ti (GF116, GDDR5). Two recorded memory states: 324 MHz on the divider and 2052 MHz
+ * on the PLL. Level 03 (135 MHz) is not in the recording: its target counts as 324 (memory stays there).
+ * The state is read from the registers at every plan, as for the Quadro 600 (a software copy does not survive a module
+ * reload or a suspend/resume): 0x1373f0 bit 1 - memory runs on the PLL. On the divider, 0x132000 bit 1 tells whether the
+ * memory PLL is still as the VBIOS left it: after the BIOS the register reads 0x18010002 on this card (snapshot of the
+ * recording kit); NVIDIA clears the bit right before its first rise (0x18000002 -> 0x18000000, part of the host writes
+ * of Bboot) and reads 0x18010000 before each later rise. Bit set - the first-rise script with NVIDIA's writes before it
+ * (Bboot); bit clear - the run-time rise (B). A suspend/resume re-POSTs the memory and sets the bit again. The descent is
+ * one script after either rise (recorded after both, word for word). Unknown state - memory is left alone. */
+enum { G16_UNKNOWN, G16_VBIOS, G16_MID, G16_HI };
+static int
+lab_plan_gf116(struct nvkm_subdev *subdev, const struct lab_board *b, int cur, int tgt, int *p)
+{
+	struct nvkm_device *device = subdev->device;
+	u32 sel = nvkm_rd32(device, 0x1373f0), pll = nvkm_rd32(device, 0x132000);
+	int st = (sel & 0x00000002) ? (cur == b->hi ? G16_HI : G16_UNKNOWN) :
+		 (cur != b->mid) ? G16_UNKNOWN : (pll & 0x00000002) ? G16_VBIOS : G16_MID;
+
+	if (tgt == b->lo) {
+		nvkm_info(subdev, "LAB replay: memory level %d MHz is not in the recording of this board - target %d MHz\n", b->lo, b->mid);
+		tgt = b->mid;
+	}
+	switch (st) {
+	case G16_VBIOS:
+		if (tgt != b->hi)
+			return 0;
+		/* for the record: what NVIDIA wrote once at its start and the replay leaves as the VBIOS set it */
+		nvkm_info(subdev, "LAB replay GF116: first rise from the VBIOS state (0x132000=%08x); left as they are: 0x10f440=%08x (NVIDIA 22f84f10) 0x100b44=%08x (NVIDIA 00010001) 0x10f000=%08x (NVIDIA 00000042)\n",
+			  pll, nvkm_rd32(device, 0x10f440), nvkm_rd32(device, 0x100b44), nvkm_rd32(device, 0x10f000));
+		p[0] = LAB_G16_BBOOT;
+		return 1;
+	case G16_MID:
+		if (tgt != b->hi)
+			return 0;
+		p[0] = LAB_G16_B;
+		return 1;
+	case G16_HI:
+		if (tgt == b->hi)
+			return 0;
+		p[0] = LAB_G16_C;
+		return 1;
+	default:
+		nvkm_error(subdev, "LAB replay: memory at %d MHz (0x1373f0=%08x 0x137310=%08x 0x132000=%08x) - no such state in the recording of this board, memory is left alone\n",
+			   cur, sel, nvkm_rd32(device, 0x137310), pll);
+		return -EINVAL;
+	}
+}
+
+/* 24.11: memory state of the GT 630M (Medion) from the hardware. 0x1373f0 does not help here: the DDR3 scripts of
+ * NVIDIA never write it, so it keeps its devinit value (1) on the PLL too. 0x137360 selects the source (3 divider,
+ * 2 PLL); on the PLL only the three recorded coefficients are accepted (lab_cur_mhz would round any coefficient to the
+ * nearest level). -1 — unknown state. */
+static int
+lab_medion_state(struct nvkm_device *device)
+{
+	u32 sel = nvkm_rd32(device, 0x137360) & 3, coef = nvkm_rd32(device, 0x132004);
+
+	if (sel == 3)
+		return (((nvkm_rd32(device, 0x137310) >> 8) & 0x3f) == 8) ? 324 : -1;	/* POST divider */
+	if (sel != 2)
+		return -1;
+	switch (coef) {
+	case 0x00021f07: return 900;	/* NVIDIA 896; the VBIOS level says 900 */
+	case 0x00051806: return 324;
+	case 0x00122406: return 135;
+	default:         return -1;
+	}
+}
+
+/* 24.11: memory-controller state that NVIDIA set once at its init and kept at every level, but that no script writes:
+ * under nouveau (devinit) 0x10f440 = 0x22442410 (NVIDIA 0x22f84f10) and 0x10f160 bit 4 clear (NVIDIA set). NVIDIA wrote
+ * them while the memory ran at 324, and the scripts were recorded in this state. Written before the first step from
+ * POST (U). 0 — do not write. */
+static uint lab_medion_init = 1;
+module_param(lab_medion_init, uint, 0644);
+MODULE_PARM_DESC(lab_medion_init, "LAB: GT 630M (Medion 1b0a:20c8): before step U write NVIDIA's init state 0x10f440=0x22f84f10 and 0x10f160 bit 4 (1 on, 0 off)");
+
+static int
+lab_plan_medion(struct nvkm_subdev *subdev, const struct lab_board *b, int cur, int tgt, int *p)
+{
+	struct nvkm_device *device = subdev->device;
+	bool pll = (nvkm_rd32(device, 0x137360) & 3) == 2;
+	int hw = lab_medion_state(device), n = 0;
+
+	if (hw < 0 || hw != cur) {
+		nvkm_error(subdev, "LAB replay GT 630M: memory state not recorded (0x137360=%08x 0x132004=%08x 0x137310=%08x, %d MHz) — memory untouched\n",
+			   nvkm_rd32(device, 0x137360), nvkm_rd32(device, 0x132004), nvkm_rd32(device, 0x137310), cur);
+		return -EINVAL;
+	}
+	if (cur == tgt)
+		return 0;
+	if (cur == b->mid && !pll) {		/* POST, divider 324 */
+		p[n++] = LAB_MD_U;
+		if (tgt == b->lo) { p[n++] = LAB_MD_D; p[n++] = LAB_MD_L; }
+	} else if (cur == b->hi) {		/* PLL 896 */
+		p[n++] = LAB_MD_D;
+		if (tgt == b->lo) p[n++] = LAB_MD_L;
+	} else if (cur == b->mid) {		/* PLL 324 */
+		p[n++] = LAB_MD_L;
+		if (tgt == b->hi) p[n++] = LAB_MD_H;
+	} else if (cur == b->lo) {		/* PLL 135 */
+		p[n++] = LAB_MD_H;
+		if (tgt == b->mid) p[n++] = LAB_MD_D;
+	} else {
+		return -EINVAL;
+	}
+	if (n && p[0] == LAB_MD_U && READ_ONCE(lab_medion_init)) {
+		u32 a = nvkm_rd32(device, 0x10f440), c = nvkm_rd32(device, 0x10f160);
+
+		nvkm_wr32(device, 0x10f440, 0x22f84f10);
+		nvkm_mask(device, 0x10f160, 0x00000010, 0x00000010);
+		nvkm_info(subdev, "LAB replay GT 630M: NVIDIA init state: 0x10f440 %08x -> %08x, 0x10f160 %08x -> %08x\n",
+			  a, nvkm_rd32(device, 0x10f440), c, nvkm_rd32(device, 0x10f160));
+	}
+	return n;
+}
+
+static const struct lab_board *
+lab_board_find(struct nvkm_subdev *subdev)
+{
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_device_pci *pci = device->func->pci ? device->func->pci(device) : NULL;
+	u16 sv = pci ? pci->pdev->subsystem_vendor : 0, sd = pci ? pci->pdev->subsystem_device : 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(lab_boards); i++) {
+		const struct lab_board *b = &lab_boards[i];
+
+		if (b->chipset != device->chipset || b->subven != sv || b->subdev != sd)
+			continue;
+		if (b->vbios) {		/* 26.11: the subsystem alone does not tell this board from another one */
+			struct nvkm_bios *bios = device->bios;
+			u32 ver = !bios ? 0 : bios->version.major << 24 | bios->version.chip << 16 |
+					      bios->version.minor << 8 | bios->version.micro;
+			u8 patch = bios ? bios->version.patch : 0, strap = (nvkm_rd32(device, 0x101000) & 0x0000003c) >> 2;
+
+			if (ver != b->vbios || patch != b->patch || strap != b->strap) {
+				nvkm_warn(subdev, "LAB: chipset and subsystem are those of the recorded board [%s], but the VBIOS version or the memory strap are not (here %02x.%02x.%02x.%02x.%02x, strap %u) - its memory scripts are not used\n",
+					  b->name, ver >> 24, (ver >> 16) & 0xff, (ver >> 8) & 0xff, ver & 0xff, patch, strap);
+				continue;
+			}
+		}
+		return b;
+	}
+	nvkm_warn(subdev, "LAB: плата не описана (chipset %02x, subsystem %04x:%04x) — повтор скриптов памяти недоступен, ядро можно переключать с lab_mem=0\n",
+		  device->chipset, sv, sd);
+	return NULL;
+}
+
+static u32
+lab_611200_val(u32 nv)
+{
+	if (lab_mem_replay & 32)
+		return nv;
+	return (nv & 0x30) ? lab_rp611 : (lab_rp611 & ~0x00000030);
+}
+
+/* LAB 25.11: цель шага выше порога 750 МГц? По последней записи скрипта в 0x132018: бит 28 снят — выше; бит стоит или записи
+ * нет (скрипты GDDR5, спуск DDR3 на нижний уровень) — не выше. */
+static bool
+lab_step_above750(const struct lab_step *st)
+{
+	u32 i = 0, v = 0x10000000;
+
+	while (i < st->nscr) {
+		u32 h = st->scr[i], n = h >> 16, k;
+
+		if (n == 0 || i + n > st->nscr || (h & 0xffff) == 0x16)
+			break;
+		if ((h & 0xffff) == 0x21)
+			for (k = 0; k + 1 < n - 1; k += 2)
+				if (st->scr[i + 1 + k] == 0x132018)
+					v = st->scr[i + 2 + k];
+		i += n;
+	}
+	return !(v & 0x10000000);
+}
+
+/* правило линий применяется к этому шагу: память платы — DDR3 и шаг поднимает её выше порога */
+static bool
+lab_line750_wanted(struct nvkm_device *device, const struct lab_step *st)
+{
+	struct nvkm_ram *ram = device->fb ? device->fb->ram : NULL;
+
+	return ram && ram->type == NVKM_RAM_TYPE_DDR3 && lab_step_above750(st);
+}
+
+/* Регистры линий, в которых бит 1 какой-нибудь тетрады стоит: адреса и значения со снятым битом; возвращает их число.
+ * Контроллеры памяти: у чипов с одним разделом их число — в 0x02243c (GF108 — 2, GF117 и GF119 — 1; так же читает nouveau);
+ * у остальных 0x02243c читается нулём — тогда по активным разделам (0x022438 без маски 0x022554), как lab_mem_topo. */
+static int
+lab_line750_list(struct nvkm_device *device, u32 *addr, u32 *val)
+{
+	static const u16 off[] = { 0x620, 0x628, 0x630 };
+	u32 fbpa = nvkm_rd32(device, 0x02243c), fbp = nvkm_rd32(device, 0x022438), mask = nvkm_rd32(device, 0x022554);
+	int i, k, n = 0;
+
+	for (i = 0; i < LAB_LINE750_MAX / ARRAY_SIZE(off); i++) {
+		if (fbpa ? i >= fbpa : (i >= fbp || (mask & (1u << i))))
+			continue;
+		for (k = 0; k < ARRAY_SIZE(off); k++) {
+			u32 a = 0x110000 + i * 0x1000 + off[k], v = nvkm_rd32(device, a);
+
+			if (v & 0x22222222) {
+				addr[n] = a;
+				val[n++] = v & ~0x22222222;
+			}
+		}
+	}
+	return n;
+}
+
+/* оценка размера скрипта в словах memx (как memx_cmd склеивает команды) */
+struct lab_est { u32 m, sz, total; };
+static void
+lab_est_cmd(struct lab_est *e, u32 m, u32 size)
+{
+	if (e->sz + size >= 64 || (e->m && e->m != m)) {
+		if (e->m)
+			e->total += 1 + e->sz;
+		e->m = 0;
+		e->sz = 0;
+	}
+	e->sz += size;
+	e->m = m;
+}
+
+/* build=false — только проверить и посчитать; build=true — записать в memx */
+static int
+lab_interp(struct nvkm_subdev *subdev, struct nvkm_memx *memx, const struct lab_step *st,
+	   bool build, u32 *words)
+{
+	struct lab_est e = {};
+	u32 waddr = 0, wval = 0, i = 0, nwr = 0, nwait = 0, ndel = 0, nskip = 0;
+	u32 unit = lab_mem_unit_ns, nsync = 0, sync_ns = 0, nline = 0;
+	bool blocked = false, syncwait = READ_ONCE(lab_mem_syncwait);
+	/* 25.11: lab_mem_line750 = 2 — записи линий DDR3 внутри скрипта, перед первой записью 0x10f830 (место из записей базы) */
+	bool line_in = READ_ONCE(lab_mem_line750) == 2 && !st->gen && lab_line750_wanted(subdev->device, st);
+
+	while (i < st->nscr) {
+		u32 h = st->scr[i], n = h >> 16, op = h & 0xffff, k;
+		const u32 *a = &st->scr[i + 1];
+
+		if (n == 0 || i + n > st->nscr) {
+			nvkm_error(subdev, "LAB replay %s: сбой разбора на слове %u (%08x)\n", st->name, i, h);
+			return -EINVAL;
+		}
+		switch (op) {
+		case 0x21:
+			for (k = 0; k + 1 < n - 1; k += 2) {
+				u32 addr = a[k], data = a[k + 1];
+
+				if (addr == 0x10f830 && line_in) {
+					u32 la[LAB_LINE750_MAX], lv[LAB_LINE750_MAX];
+					int ln = lab_line750_list(subdev->device, la, lv), j;
+
+					for (j = 0; j < ln; j++) {
+						if (build)
+							nvkm_memx_wr32(memx, la[j], lv[j]);
+						lab_est_cmd(&e, 3, 2);
+						nwr++;
+						nline++;
+					}
+					line_in = false;	/* один раз за скрипт */
+				}
+				if (addr == 0x611200)
+					data = lab_611200_val(data);
+				if (build)
+					nvkm_memx_wr32(memx, addr, data);
+				lab_est_cmd(&e, 3, 2);
+				nwr++;
+			}
+			break;
+		case 0x2e:
+			if (build)
+				nvkm_memx_nsec(memx, a[0]);
+			lab_est_cmd(&e, 5, 1);
+			ndel++;
+			break;
+		case 0x13:	/* пауза, нс (сверено с ramgt215.c: те же места и числа); множитель lab_mem_op13 = 1 */
+			if (build)
+				nvkm_memx_nsec(memx, a[0] * lab_mem_op13);
+			lab_est_cmd(&e, 5, 1);
+			ndel++;
+			break;
+		case 0x00:
+			wval = a[0];
+			break;
+		case 0x01:
+			waddr = a[0];
+			break;
+		case 0x15:
+			if (build)
+				nvkm_memx_wait(memx, waddr, a[0], wval, a[1]);
+			lab_est_cmd(&e, 4, 4);
+			nwait++;
+			break;
+		case 0x14:
+			if (a[0] == 0) {	/* одно ожидание кадра на пару NVIDIA (голова 0 + голова 1) */
+				if (build)
+					nvkm_memx_wait_vblank(memx);
+				lab_est_cmd(&e, 6, 1);
+				e.total += 1 + e.sz;
+				e.m = 0;
+				e.sz = 0;
+			}
+			break;
+		case 0x20:
+			if (a[0] == 1 && !blocked) {
+				if (build)
+					nvkm_memx_block(memx);
+				lab_est_cmd(&e, 1, 0);
+				blocked = true;
+			} else if (a[0] == 0 && blocked) {
+				if (build)
+					nvkm_memx_unblock(memx);
+				lab_est_cmd(&e, 2, 0);
+				blocked = false;
+			}
+			break;
+		case 0x16:
+			i = st->nscr;
+			continue;
+		case 0x34:
+			if (lab_mem_op34 && a[0] == 0x0a) {
+				if (build)
+					nvkm_memx_wait(memx, 0x611200, 0x00000003, 0x00000000, 2000000);
+				lab_est_cmd(&e, 4, 4);
+				nwait++;
+				break;
+			}
+			nskip++;
+			break;
+		case 0x3a:	/* ждать N единиц после записи 0x13d8x4 = 0 */
+			if (syncwait && a[0] && unit) {
+				if (build)
+					nvkm_memx_nsec(memx, a[0] * unit);
+				lab_est_cmd(&e, 5, 1);
+				nsync++;
+				sync_ns += a[0] * unit;
+				break;
+			}
+			nskip++;
+			break;
+		case 0x39:	/* единица ожидания, нс */
+			if (syncwait) {
+				unit = a[0];
+				break;
+			}
+			nskip++;
+			break;
+		default:
+			nvkm_error(subdev, "LAB replay %s: неизвестная операция %04x\n", st->name, op);
+			return -EINVAL;
+		}
+		i += n;
+	}
+	if (blocked) {
+		nvkm_error(subdev, "LAB replay %s: скрипт не снимает останов видеопамяти\n", st->name);
+		return -EINVAL;
+	}
+	if (build && line_in)
+		nvkm_warn(subdev, "LAB replay %s: в скрипте нет записи 0x10f830 — линии DDR3 не записаны (lab_mem_line750=2)\n", st->name);
+	if (e.m)
+		e.total += 1 + e.sz;
+	*words = e.total;
+	if (build)
+		nvkm_info(subdev, "LAB replay %s: в memx %u записей, %u ожиданий, %u пауз, ожиданий после 0x13d8x4: %u (всего %u нс), пропущено %u операций, ~%u слов; записей линий DDR3 в скрипте: %u\n",
+			  st->name, nwr, nwait, ndel, nsync, sync_ns, nskip, e.total, nline);
+	return 0;
+}
+
+/* =================== LAB 26.11: DDR3 memory scripts built from the VBIOS and the register state ===================
+ * (docs/2026-11-25/ddr3-generator.md) Instead of replaying a script recorded on one board, the driver builds the script
+ * NVIDIA's driver would build: field values from the VBIOS tables of the target level, order and conditions from the
+ * recordings, and every "write only if it changes" decision from the registers as they are at that moment. No software
+ * copy of the memory state is kept, so a module reload, a suspend/resume or a state left by another driver cannot put
+ * it out of step with the card (the recorded plans below could: a tester's Quadro 600 hung that way).
+ * Checked offline: this C text reproduces 35 of the 37 distinct recorded scripts of five GF108 DDR3 boards word for
+ * word, and the host writes around them (lab/memgen-ddr3-ctest.sh). First run on hardware: after 26.11.
+ * Where it applies is decided from the hardware and the VBIOS, never from a chip list: DDR3; one memory partition with
+ * two controllers (0x022438 = 1, 0x02243c = 2); VBIOS tables rammap/ramcfg/timing 1.0 and level table 4.0; memory PLL
+ * at 0x132000 with a 405 MHz reference. Anything else keeps the recorded scripts of its board, or no memory reclocking.
+ * lab_mem_gen: 2 (default in this first round, until a built script has run on somebody's card): at every memory
+ * transition build the script and print it, but leave the switch itself to the recorded scripts of the board, exactly
+ * as before 26.11 (no recorded scripts: memory untouched); 1: build and run it; 0: recorded scripts only (not after a
+ * built script has run: reload the module for that). The printed script can be compared with NVIDIA's recording of the
+ * same board: lab/memgen-ddr3-logcheck.py.
+ * lab_mem_gen_dump: how many distinct built scripts are still to be printed in full (counts down).
+ * lab_mem_gen_updiv: the recordings hold every kind of transition except one: divider -> divider upwards (it needs two
+ * memory levels on the divider: of the boards seen, only the ASUS GT 630 has that, 135 -> 324 MHz). 0 (default): such a
+ * transition goes through the highest PLL level in two steps, each of a recorded kind (the route the recorded plan of
+ * that board took, tested live there); 1: one direct step, built by the same rules but with no recording behind it. */
+static uint lab_mem_gen = 2;
+module_param(lab_mem_gen, uint, 0644);
+MODULE_PARM_DESC(lab_mem_gen, "LAB: DDR3 memory scripts built from the VBIOS and the register state, where that applies (DDR3, one partition with two controllers): 2 build and print them, the switch itself stays with the recorded scripts of the board as before (default in this first round), 1 build and run them, 0 recorded scripts only");
+static int lab_mem_gen_dump = 8;
+module_param(lab_mem_gen_dump, int, 0644);
+MODULE_PARM_DESC(lab_mem_gen_dump, "LAB: print this many more distinct built memory scripts in full (counts down, default 8)");
+static uint lab_mem_gen_updiv;
+module_param(lab_mem_gen_updiv, uint, 0644);
+MODULE_PARM_DESC(lab_mem_gen_updiv, "LAB: built DDR3 scripts, divider -> divider upwards (no NVIDIA recording of this kind): 0 go through the highest PLL level in two steps (default), 1 one direct step");
+
+/* LAB_G3_CORE_BEGIN — generator core: plain C with no kernel calls. lab/memgen-ddr3-ctest.sh cuts this very text out,
+ * builds it in userspace and compares its output word for word with the recorded NVIDIA scripts. */
+#define LAB_G3_SCR_MAX		640	/* script words, NVIDIA format */
+#define LAB_G3_HOST_MAX		16	/* host writes before or after the script */
+#define LAB_G3_SHADOW_MAX	96
+#define LAB_G3_FBPA		2	/* memory controllers: strobe 0x13d834 and line registers 0x110xxx / 0x111xxx */
+#define LAB_G3_FRAME_TO		0x02b5f070	/* argument of NVIDIA's frame wait (a timeout in ns by its size; unverified) */
+
+struct lab_g3_level {			/* VBIOS bytes of one memory level */
+	u8 T[0x20];			/* timing table entry */
+	u8 R[0x10];			/* ramcfg entry of the board's strap */
+	u8 M[0x10];			/* rammap entry (frequency range) */
+};
+
+struct lab_g3_pll {			/* memory PLL limits from the VBIOS PLL table; frequencies in kHz */
+	u32 refclk, min_freq, max_freq, min_in, max_in;
+	u32 min_m, max_m, min_n, max_n, min_p, max_p;
+};
+
+struct lab_g3 {
+	/* in */
+	struct lab_g3_level cur, tgt, low;	/* level now, target level, first rammap entry (lowest frequencies) */
+	struct lab_g3_pll pll;
+	u32 tgt_mhz;				/* target frequency from the VBIOS level table */
+	bool on_pll, tgt_pll;			/* memory clock source now and after: PLL or divider */
+	bool display;				/* wait for the frame gap and pause scanout */
+	bool f618;				/* the VBIOS uses register 0x10f618: its value is non-zero at some memory level */
+	u32 (*rd)(void *priv, u32 reg);		/* register read */
+	void *priv;
+	/* out */
+	u32 scr[LAB_G3_SCR_MAX];
+	u32 pre[2 * LAB_G3_HOST_MAX], post[2 * LAB_G3_HOST_MAX];	/* address/value pairs */
+	int nscr, npre, npost;
+	u32 got_khz, coef, div;			/* result: frequency; 0x132004 word (PLL target) or divider code */
+	const char *err;
+	/* work */
+	u32 sreg[LAB_G3_SHADOW_MAX], sval[LAB_G3_SHADOW_MAX];	/* register state: values read plus the writes queued so far */
+	int ns, pending, run;
+};
+
+static const u8 lab_g3_cl[]  = { 5, 2, 6, 4, 7, 6, 8, 8, 9, 10, 10, 12, 11, 14, 12, 1, 13, 3, 14, 5 };
+static const u8 lab_g3_wr[]  = { 5, 1, 6, 2, 7, 3, 8, 4, 10, 5, 12, 6, 14, 7, 15, 7, 16, 0 };
+static const u8 lab_g3_cwl[] = { 5, 0, 6, 1, 7, 2, 8, 3, 9, 4, 10, 5 };
+
+static void
+lab_g3_fail(struct lab_g3 *g, const char *why)
+{
+	if (!g->err)
+		g->err = why;
+}
+
+/* clock count from the VBIOS -> DDR3 mode register code (JESD79-3; the same tables as nouveau's fb/sddr3.c) */
+static u32
+lab_g3_xlat(struct lab_g3 *g, const u8 *tab, int n, u8 key, const char *what)
+{
+	int i;
+
+	for (i = 0; i + 1 < n; i += 2)
+		if (tab[i] == key)
+			return tab[i + 1];
+	lab_g3_fail(g, what);
+	return 0;
+}
+
+static u32
+lab_g3_cur(struct lab_g3 *g, u32 reg)
+{
+	int i;
+
+	for (i = 0; i < g->ns; i++)
+		if (g->sreg[i] == reg)
+			return g->sval[i];
+	if (g->ns >= LAB_G3_SHADOW_MAX) {
+		lab_g3_fail(g, "state table full");
+		return 0;
+	}
+	g->sreg[g->ns] = reg;
+	g->sval[g->ns] = g->rd(g->priv, reg);
+	return g->sval[g->ns++];
+}
+
+static void
+lab_g3_set(struct lab_g3 *g, u32 reg, u32 val)
+{
+	int i;
+
+	for (i = 0; i < g->ns; i++) {
+		if (g->sreg[i] == reg) {
+			g->sval[i] = val;
+			return;
+		}
+	}
+	if (g->ns >= LAB_G3_SHADOW_MAX) {
+		lab_g3_fail(g, "state table full");
+		return;
+	}
+	g->sreg[g->ns] = reg;
+	g->sval[g->ns++] = val;
+}
+
+static void
+lab_g3_word(struct lab_g3 *g, u32 w)
+{
+	if (g->nscr >= LAB_G3_SCR_MAX) {
+		lab_g3_fail(g, "script longer than the buffer");
+		return;
+	}
+	g->scr[g->nscr++] = w;
+}
+
+/* a register write; NVIDIA packs consecutive writes into one op 0x21 */
+static void
+lab_g3_emit(struct lab_g3 *g, u32 reg, u32 val)
+{
+	if (g->run < 0) {
+		g->run = g->nscr;
+		lab_g3_word(g, 0x00010021);
+	}
+	lab_g3_word(g, reg);
+	lab_g3_word(g, val);
+	if (!g->err)
+		g->scr[g->run] += 0x00020000;
+}
+
+static void
+lab_g3_op(struct lab_g3 *g, u32 code, int n, u32 a0, u32 a1)
+{
+	g->run = -1;
+	lab_g3_word(g, ((u32)(1 + n) << 16) | code);
+	if (n > 0)
+		lab_g3_word(g, a0);
+	if (n > 1)
+		lab_g3_word(g, a1);
+}
+
+static void
+lab_g3_wait(struct lab_g3 *g, u32 ns)
+{
+	lab_g3_op(g, 0x2e, 1, ns, 0);
+}
+
+/* Strobe: writes to 0x10f600..0x10f8ff are counted; before a write to the clock registers, the memory PLL, 0x100xxx or
+ * the controllers' line registers NVIDIA writes 0x13d834 = 0 and waits one unit per counted write (op 0x3a N). */
+static void
+lab_g3_flush(struct lab_g3 *g)
+{
+	if (g->pending) {
+		lab_g3_emit(g, 0x13d834, 0x00000000);
+		lab_g3_op(g, 0x3a, 1, g->pending, 0);
+		g->pending = 0;
+	}
+}
+
+/* always = false: the write goes into the script only if it changes the register */
+static bool
+lab_g3_w(struct lab_g3 *g, u32 reg, u32 val, bool always)
+{
+	if (!always && lab_g3_cur(g, reg) == val)
+		return false;
+	if ((reg >= 0x137300 && reg < 0x137400) || (reg >= 0x132000 && reg < 0x133000) ||
+	    (reg >= 0x100000 && reg < 0x101000) || (reg >= 0x110000 && reg < 0x118000))
+		lab_g3_flush(g);
+	lab_g3_emit(g, reg, val);
+	lab_g3_set(g, reg, val);
+	if (reg >= 0x10f600 && reg < 0x10f900)
+		g->pending++;
+	return true;
+}
+
+/* wait for the memory PLL lock (0x137390 bit 1, up to 64 us); the lock flags in 0x132000 read as ones from then on */
+static void
+lab_g3_lockwait(struct lab_g3 *g)
+{
+	lab_g3_op(g, 0x00, 1, 0x00000002, 0);
+	lab_g3_op(g, 0x01, 1, 0x00137390, 0);
+	lab_g3_op(g, 0x15, 2, 0x00000002, 0x0000fa00);
+	lab_g3_set(g, 0x132000, lab_g3_cur(g, 0x132000) | 0x00030000);
+}
+
+/* Memory PLL coefficients: P from the largest down (VCO within the VBIOS limits), M while the divided reference stays
+ * within the input limits, N by rounding; a later candidate wins only with a strictly smaller error. */
+static bool
+lab_g3_mem_pll(const struct lab_g3_pll *l, u32 khz, u32 *got, u32 *coef)
+{
+	u32 ref = l->refclk, mlo, mhi, P, M, best = 0;
+	bool have = false;
+
+	if (!ref || !l->max_in || !l->min_in || !khz)
+		return false;
+	mlo = (ref + l->max_in - 1) / l->max_in;
+	if (mlo < l->min_m)
+		mlo = l->min_m;
+	mhi = ref / l->min_in;
+	if (mhi > l->max_m)
+		mhi = l->max_m;
+	for (P = l->max_p; P >= l->min_p && P > 0; P--) {
+		u32 vco;
+
+		if (khz > l->max_freq / P)
+			continue;
+		vco = khz * P;
+		if (vco < l->min_freq)
+			continue;
+		for (M = mlo; M <= mhi; M++) {
+			u32 N, f, err;
+
+			if (!M || vco > (0xffffffffu - ref / 2) / M)
+				continue;
+			N = (vco * M + ref / 2) / ref;
+			if (N < l->min_n || N > l->max_n || N > 0xffffffffu / ref)
+				continue;
+			f = ref * N / M / P;
+			err = khz > f ? khz - f : f - khz;
+			if (!have || err < best) {
+				have = true;
+				best = err;
+				*got = f;
+				*coef = P << 16 | N << 8 | M;
+			}
+		}
+	}
+	return have;
+}
+
+static u32
+lab_g3_f808(const struct lab_g3_level *l)
+{
+	u8 r2 = l->R[2];
+
+	return 0x00020000 | ((r2 & 0x04) ? 0x00000004 : 0x12800000) | ((r2 & 0x10) ? 0x08000000 : 0x04000000) |
+	       ((r2 & 0x08) ? 0 : 0x00100000);
+}
+
+static u32
+lab_g3_f018(const struct lab_g3 *g)
+{
+	u32 lo = g->tgt.M[0] | g->tgt.M[1] << 8;
+
+	return 0x00001000 | (lo > 450 ? 0x00004000 : 0) | (g->tgt_mhz <= 750 ? 0x10000000 : 0) | (g->tgt_pll ? 0 : 0x00008000);
+}
+
+/* what the target needs: PLL coefficients or the divider code (3240 MHz / (code + 2)) */
+static bool
+lab_g3_target(struct lab_g3 *g)
+{
+	if (!g->tgt_mhz) {
+		lab_g3_fail(g, "target frequency is zero");
+		return false;
+	}
+	if (g->tgt_pll) {
+		if (!lab_g3_mem_pll(&g->pll, g->tgt_mhz * 1000, &g->got_khz, &g->coef)) {
+			lab_g3_fail(g, "no memory PLL coefficients within the VBIOS limits");
+			return false;
+		}
+		g->div = 0;
+	} else {
+		u32 q = (6480 + g->tgt_mhz) / (2 * g->tgt_mhz);	/* 3240 / target, rounded */
+
+		if (q < 2 || q > 65) {
+			lab_g3_fail(g, "memory clock divider out of range");
+			return false;
+		}
+		if (3240 % g->tgt_mhz) {	/* every divider target in the recordings is exact; NVIDIA's rounding is unknown */
+			lab_g3_fail(g, "the divider cannot give the target frequency exactly");
+			return false;
+		}
+		g->div = q - 2;
+		g->got_khz = 3240000 / q;
+		g->coef = 0;
+	}
+	return true;
+}
+
+static void
+lab_g3_host(struct lab_g3 *g, u32 *l, int *n, u32 reg, u32 val)
+{
+	if (*n >= LAB_G3_HOST_MAX) {
+		lab_g3_fail(g, "host write list full");
+		return;
+	}
+	l[2 * *n] = reg;
+	l[2 * *n + 1] = val;
+	(*n)++;
+}
+
+/* The six range registers 0x10f4xx from the packed word of the rammap entry (bytes 5-8); the layout is the one nouveau
+ * uses on Kepler (fb/ramgk104.c), checked against the recordings. 0x1700 in 0x10f400 and 0x8800 in 0x10f444: meaning
+ * unknown; absent after POST, always present under NVIDIA. */
+static void
+lab_g3_range(struct lab_g3 *g, u32 *l, int *n, const u8 *M)
+{
+	u32 w = M[5] | M[6] << 8 | M[7] << 16 | (u32)M[8] << 24;
+
+	lab_g3_host(g, l, n, 0x10f468, (lab_g3_cur(g, 0x10f468) & ~0x001ff1ff) | (w & 0x1ff) | ((w >> 9) & 0x1ff) << 12);
+	lab_g3_host(g, l, n, 0x10f420, (lab_g3_cur(g, 0x10f420) & ~0x00000001) | ((w >> 18) & 1));
+	lab_g3_host(g, l, n, 0x10f430, (lab_g3_cur(g, 0x10f430) & ~0x00000001) | ((w >> 19) & 1));
+	lab_g3_host(g, l, n, 0x10f400, (lab_g3_cur(g, 0x10f400) & ~0x0000001f) | 0x00001700 | ((w >> 20) & 0x1f));
+	lab_g3_host(g, l, n, 0x10f410, (lab_g3_cur(g, 0x10f410) & ~0x00000200) | ((w >> 25) & 1) << 9);
+	lab_g3_host(g, l, n, 0x10f444, (lab_g3_cur(g, 0x10f444) & ~0x000000a0) | 0x00008800 | ((w >> 26) & 1) << 5 | ((w >> 27) & 1) << 7);
+}
+
+/* Host writes before the script: 0x10f050 and the six range registers go to the set of the lowest VBIOS range, whatever
+ * the transition; PLL preparation if the PLL starts from scratch (bit 1 of 0x132000 is set only after POST).
+ * The writes also enter the state: the script is built as if they were done (NVIDIA's host does them before building). */
+static bool
+lab_g3_pre(struct lab_g3 *g)
+{
+	int i;
+
+	g->npre = 0;
+	lab_g3_host(g, g->pre, &g->npre, 0x10f050, (lab_g3_cur(g, 0x10f050) & ~0x00001400) | 0x00000400);
+	lab_g3_range(g, g->pre, &g->npre, g->low.M);
+	if (g->tgt_pll && !g->on_pll && (lab_g3_cur(g, 0x132000) & 0x00000002)) {
+		u32 v = lab_g3_cur(g, 0x132000);
+
+		lab_g3_host(g, g->pre, &g->npre, 0x132000, v);
+		lab_g3_host(g, g->pre, &g->npre, 0x132000, v & ~0x00000002);
+	}
+	for (i = 0; i < g->npre; i++)
+		lab_g3_set(g, g->pre[2 * i], g->pre[2 * i + 1]);
+	return !g->err;
+}
+
+/* Host writes after the script (the state is read again, after it ran): the six range registers and 0x10f050 go to the
+ * target's set; a bit pair of 0x10f824 and bit 30 of 0x10f808 by bit 4 of ramcfg byte 2 (nouveau's GT21x code calls
+ * these "post fiddlings"); a divider target clears the PLL enable bit. */
+static bool
+lab_g3_post(struct lab_g3 *g)
+{
+	u32 lo = g->tgt.M[0] | g->tgt.M[1] << 8;
+
+	g->ns = 0;
+	g->npost = 0;
+	if (g->tgt.R[2] & 0x10) {
+		lab_g3_host(g, g->post, &g->npost, 0x132018, lab_g3_f018(g));
+		lab_g3_host(g, g->post, &g->npost, 0x10f824, lab_g3_cur(g, 0x10f824) | 0x00000180);
+		lab_g3_host(g, g->post, &g->npost, 0x10f808, lab_g3_cur(g, 0x10f808) & ~0x40000000);
+	} else {
+		lab_g3_host(g, g->post, &g->npost, 0x10f824, lab_g3_cur(g, 0x10f824) | 0x00000600);
+	}
+	if (!g->tgt_pll)
+		lab_g3_host(g, g->post, &g->npost, 0x132000, lab_g3_cur(g, 0x132000) & ~0x00000001);
+	lab_g3_range(g, g->post, &g->npost, g->tgt.M);
+	lab_g3_host(g, g->post, &g->npost, 0x10f050, (lab_g3_cur(g, 0x10f050) & ~0x00001400) | (lo > 450 ? 0x00001000 : 0x00000400));
+	return !g->err;
+}
+
+/* The memory transition script in NVIDIA's format (words for lab_interp). Order and conditions come from NVIDIA
+ * recordings of five GF108 DDR3 boards (docs/2026-11-25/ddr3-generator.md), field values from the VBIOS bytes of the
+ * target level. Call lab_g3_target() first. */
+static bool
+lab_g3_script(struct lab_g3 *g)
+{
+	const struct lab_g3_level *C = &g->cur, *L = &g->tgt;
+	const u8 *T = L->T, *R = L->R;
+	const u8 r2 = R[2];
+	const bool b4 = r2 & 0x10, dlloff = r2 & 0x40, cdlloff = C->R[2] & 0x40, numeric = L->M[4] & 0x08;
+	const bool on_pll = g->on_pll, tgt_pll = g->tgt_pll;
+	const u32 mhz = g->tgt_mhz, hi = L->M[2] | L->M[3] << 8;
+	const u32 f018 = lab_g3_f018(g), rng824 = hi <= 450 ? 0x00006000 : 0;
+	const u32 odt = (T[0x0e] & 1) << 2 | (T[0x0e] & 2) << 5 | (T[0x0e] & 4) << 7;
+	const u32 t290 = (u32)T[9] << 24 | T[7] << 17 | T[5] << 8 | T[3];
+	const u32 line = mhz <= 750 ? 0x22222222 : 0x00000000;
+	u32 cl, mr0, cwl, v, m1, rfc, built0, old0, div = 0, dllwait;
+	int i, k;
+
+	g->nscr = 0;
+	g->pending = 0;
+	g->run = -1;
+	cl = lab_g3_xlat(g, lab_g3_cl, sizeof(lab_g3_cl), T[2], "CL of the VBIOS is not a DDR3 value");
+	mr0 = 0x00001000 | lab_g3_xlat(g, lab_g3_wr, sizeof(lab_g3_wr), T[0], "WR of the VBIOS is not a DDR3 value") << 9 |
+	      (cl & 0x0e) << 3 | (cl & 0x01) << 2;
+	cwl = lab_g3_xlat(g, lab_g3_cwl, sizeof(lab_g3_cwl), T[0x13], "CWL of the VBIOS is not a DDR3 value");
+	if (!mhz)
+		lab_g3_fail(g, "target frequency is zero");
+	if (g->err)
+		return false;
+	dllwait = (512000 + mhz * 1000 - 1) / (mhz * 1000) * 1000;	/* 512 memory clocks, rounded up to 1 us */
+	if (!tgt_pll)
+		div = (lab_g3_cur(g, 0x137310) & ~0x00003f00) | g->div << 8;
+
+	/* before the memory stops */
+	if (tgt_pll && !on_pll) {		/* memory runs from the divider: set up and lock the PLL in advance */
+		lab_g3_w(g, 0x137320, 0x00000103, true);
+		lab_g3_w(g, 0x137330, 0x81200606, true);
+		lab_g3_w(g, 0x132004, g->coef, true);
+		lab_g3_w(g, 0x132000, lab_g3_cur(g, 0x132000) | 0x00000001, true);
+		lab_g3_lockwait(g);
+		lab_g3_w(g, 0x132018, f018, false);
+	}
+	if (on_pll && !tgt_pll)			/* memory runs from the PLL: set up the divider in advance */
+		lab_g3_w(g, 0x137310, div, false);
+	if (on_pll)
+		lab_g3_w(g, 0x137300, 0x00000103, true);
+	if (on_pll || tgt_pll) {
+		lab_g3_w(g, 0x137370, 0x00000003, true);
+		lab_g3_w(g, 0x137380, 0x00000001, true);
+	}
+	if (!b4)
+		lab_g3_w(g, 0x10f808, lab_g3_f808(C) | 0x40000000, true);
+	v = lab_g3_cur(g, 0x10f824) & ~(b4 ? 0x00000600 : 0x00000180);
+	if (tgt_pll && !on_pll && !rng824)	/* PLL already locked at the target: bits 13-14 are cleared at once (set: later) */
+		v &= ~0x00006000;
+	lab_g3_w(g, 0x10f824, v, false);
+	lab_g3_w(g, 0x100b0c, 0x00080012, true);
+	if (g->display) {
+		lab_g3_op(g, 0x14, 2, 0x00000000, LAB_G3_FRAME_TO);
+		lab_g3_op(g, 0x14, 2, 0x00010000, LAB_G3_FRAME_TO);
+		lab_g3_w(g, 0x611200, 0x00003300, true);
+	}
+	lab_g3_op(g, 0x34, 1, 0x0000000a, 0);
+	lab_g3_op(g, 0x20, 2, 0x00000001, 0x00000000);
+
+	/* memory stopped */
+	lab_g3_w(g, 0x10f200, lab_g3_cur(g, 0x10f200) & ~0x00000800, true);
+	m1 = lab_g3_cur(g, 0x10f304);
+	if ((m1 & 0x244) & ~odt)		/* termination: clear early, set after the clock change */
+		lab_g3_w(g, 0x10f304, (m1 & ~0x00000244) | (m1 & 0x244 & odt), false);
+	if (!b4)
+		lab_g3_w(g, 0x10f808, lab_g3_cur(g, 0x10f808) | 0x04020000, false);
+	if (dlloff && !cdlloff) {
+		lab_g3_w(g, 0x10f314, 0x00000001, true);
+		lab_g3_w(g, 0x10f304, lab_g3_cur(g, 0x10f304) | 0x00000001, true);
+		lab_g3_wait(g, 1000);
+	}
+	if (!b4)
+		lab_g3_w(g, 0x1373ec, lab_g3_cur(g, 0x1373ec) | 0x00020000, false);
+	rfc = t290 & 0x0001ff00;
+	if (rfc > (lab_g3_cur(g, 0x10f290) & 0x0001ff00))	/* refresh takes more clocks: raise it early */
+		lab_g3_w(g, 0x10f290, (lab_g3_cur(g, 0x10f290) & ~0x0001ff00) | rfc, false);
+	lab_g3_w(g, 0x10f314, 0x00000001, true);
+	lab_g3_w(g, 0x10f210, 0x00000000, true);
+	lab_g3_w(g, 0x10f310, 0x00000001, true);
+	lab_g3_w(g, 0x10f310, 0x00000001, true);
+	lab_g3_wait(g, 1000);
+	lab_g3_w(g, 0x10f090, 0x00000060, true);
+	lab_g3_w(g, 0x10f090, 0xc000007e, true);
+	if (on_pll) {				/* leave the PLL for the divider: for good, or while the PLL is retuned */
+		lab_g3_w(g, 0x137360, 0x00000003, true);
+		lab_g3_w(g, 0x10f830, lab_g3_cur(g, 0x10f830) | 0x00000006, false);
+		lab_g3_w(g, 0x137370, 0x00000000, true);
+		lab_g3_w(g, 0x137380, 0x00000000, true);
+		lab_g3_w(g, 0x132018, lab_g3_cur(g, 0x132018) & ~0x00004000, false);
+		lab_g3_w(g, 0x132000, lab_g3_cur(g, 0x132000) & ~0x00000001, true);
+		if (tgt_pll) {
+			lab_g3_w(g, 0x137320, 0x00000103, true);
+			lab_g3_w(g, 0x137330, 0x81200606, true);
+			lab_g3_w(g, 0x132004, g->coef, true);
+			lab_g3_w(g, 0x132000, lab_g3_cur(g, 0x132000) | 0x00000001, true);
+			lab_g3_lockwait(g);
+		}
+	} else if (!tgt_pll) {			/* divider -> divider: the code changes in place */
+		lab_g3_w(g, 0x137310, div, false);
+	}
+	lab_g3_w(g, 0x10f874, (lab_g3_cur(g, 0x10f874) & ~0x04000000) | (mhz <= 750 ? 0x04000000 : 0), false);
+	if (numeric) {
+		lab_g3_w(g, 0x10f658, R[6] << 16 | R[5] << 8 | R[5], false);
+		lab_g3_w(g, 0x132018, f018, false);
+		lab_g3_w(g, 0x10f660, R[8] << 8 | R[7], true);
+		lab_g3_w(g, 0x10f668, 0x80000000 | (R[9] >> 4) << 20 | (R[3] & 0x0f) << 16 | (R[9] & 0x0f), false);
+		lab_g3_w(g, 0x10f910, lab_g3_cur(g, 0x10f910) & ~0x00002000, false);
+		lab_g3_w(g, 0x10f914, lab_g3_cur(g, 0x10f914) & ~0x00002000, false);
+		lab_g3_w(g, 0x10f824, (lab_g3_cur(g, 0x10f824) & ~0x00006000) | rng824, false);
+	} else {
+		lab_g3_w(g, 0x10f824, (lab_g3_cur(g, 0x10f824) & ~0x00006000) | rng824, false);
+		lab_g3_w(g, 0x132018, f018, false);
+		lab_g3_wait(g, 20000);
+		lab_g3_w(g, 0x10f910, lab_g3_cur(g, 0x10f910) | 0x00002000, false);
+		lab_g3_w(g, 0x10f914, lab_g3_cur(g, 0x10f914) | 0x00002000, false);
+		lab_g3_w(g, 0x10f658, 0x00000000, false);
+		for (i = 0; i < LAB_G3_FBPA; i++) {	/* line registers: bit 1 of every nibble = frequency not above 750 MHz */
+			static const u16 off[] = { 0x620, 0x628, 0x630 };
+
+			for (k = 0; k < 3; k++) {
+				u32 reg = 0x110000 + i * 0x1000 + off[k];
+
+				lab_g3_w(g, reg, (lab_g3_cur(g, reg) & ~0x22222222) | line, false);
+			}
+		}
+		if (mhz > 500)
+			lab_g3_w(g, 0x10f830, lab_g3_cur(g, 0x10f830) & ~0x00000006, false);
+	}
+	if (tgt_pll) {
+		lab_g3_w(g, 0x137370, 0x00000003, true);
+		lab_g3_w(g, 0x137380, 0x00000001, true);
+		lab_g3_w(g, 0x137360, 0x00000002, true);
+	}
+	lab_g3_w(g, 0x10f090, 0x4000007f, true);
+	lab_g3_w(g, 0x10f210, 0x80000000, true);
+	lab_g3_wait(g, dllwait);
+
+	/* memory is clocked again: mode registers and timings */
+	built0 = lab_g3_cur(g, 0x10f300);
+	old0 = built0 & ~0x00000100;
+	if (!dlloff) {
+		if (cdlloff) {
+			lab_g3_w(g, 0x10f304, lab_g3_cur(g, 0x10f304) & ~0x00000001, true);
+			lab_g3_wait(g, 1000);
+		}
+		lab_g3_w(g, 0x10f300, old0 | 0x00000100, true);
+		lab_g3_wait(g, 1000);
+		lab_g3_w(g, 0x10f300, old0, true);
+		lab_g3_wait(g, 1000);
+	}
+	if (lab_g3_w(g, 0x10f320, (lab_g3_cur(g, 0x10f320) & ~0x00000038) | cwl << 3, false))
+		lab_g3_wait(g, 1000);
+	lab_g3_w(g, 0x10f300, mr0 | (built0 & 0x00000100), true);
+	lab_g3_wait(g, 1000);
+
+	lab_g3_w(g, 0x10f224, (lab_g3_cur(g, 0x10f224) & ~0x00ff0000) | T[0x12] << 16, false);
+	lab_g3_w(g, 0x10f290, t290, false);
+	lab_g3_w(g, 0x10f294, (lab_g3_cur(g, 0x10f294) & 0xfc000000) | T[0x0b] << 20 | T[0x0a] << 14 | T[0x13] << 7 |
+			      (u32)(T[2] - (dlloff ? 1 : 0)), false);
+	lab_g3_w(g, 0x10f298, (lab_g3_cur(g, 0x10f298) & 0xff000000) | T[0] << 16 | T[1] << 8 | 0x11, false);
+	lab_g3_w(g, 0x10f29c, (lab_g3_cur(g, 0x10f29c) & ~0x0000ffff) | T[0x14] << 9 | T[0x15] << 5 | T[0x0d], false);
+	lab_g3_w(g, 0x10f2a0, (lab_g3_cur(g, 0x10f2a0) & ~0x001f8000) | T[0x0c] << 15, false);
+	lab_g3_w(g, 0x10f200, (lab_g3_cur(g, 0x10f200) & ~0x00001000) | ((r2 & 0x08) ? 0 : 0x00001000), false);
+	lab_g3_w(g, 0x10f604, (lab_g3_cur(g, 0x10f604) & ~0xf1000000) | ((r2 & 0x20) ? 0xf0000000 : 0) |
+			      ((r2 & 0x04) ? 0 : 0x01000000), false);
+	lab_g3_w(g, 0x10f614, (lab_g3_cur(g, 0x10f614) & ~0xf0000100) | (u32)(T[0x18] & 0x0f) << 28 | (r2 & 1) << 8, false);
+	lab_g3_w(g, 0x10f610, (lab_g3_cur(g, 0x10f610) & ~0xf0000100) | (u32)(T[0x18] & 0x0f) << 28 | ((r2 >> 1) & 1) << 8, false);
+	lab_g3_w(g, 0x10f808, lab_g3_f808(L) | (lab_g3_cur(g, 0x10f808) & 0x40000000), false);
+	if (b4)
+		lab_g3_w(g, 0x1373ec, lab_g3_cur(g, 0x1373ec) & ~0x00020000, false);
+	lab_g3_w(g, 0x1373f8, (lab_g3_cur(g, 0x1373f8) & ~0x00000005) | ((r2 & 1) ? 0x00000005 : 0), false);
+	lab_g3_w(g, 0x10f870, (R[0x0d] & 0x0f) * 0x11111111, true);
+	/* 26.11: 0x10f618 only where the VBIOS uses it. On boards whose value for it (low nibble of ramcfg byte 3) is zero
+	 * at every memory level NVIDIA never reads or writes the register (GT 630M, Quadro 600 recordings); it reads it
+	 * before every script and writes it on change only on the board where the value differs between levels (ASUS
+	 * GT 630). Under nouveau the register is not zero on a GT 630M, so the unconditional "write if changed" added a
+	 * write NVIDIA does not make (found by that board's tester in the first build-and-print run). */
+	if (g->f618)
+		lab_g3_w(g, 0x10f618, (R[3] & 0x0f) * 0x11111111, false);
+	m1 = lab_g3_cur(g, 0x10f304);
+	if ((m1 & 0x244) != odt) {
+		lab_g3_w(g, 0x10f304, (m1 & ~0x00000244) | odt, true);
+		lab_g3_wait(g, 1000);
+	}
+	if (!dlloff) {
+		/* bits 16 and 19 of 0x100c00 (0x00090000): meaning unknown, NVIDIA always sets them */
+		lab_g3_w(g, 0x100c00, (lab_g3_cur(g, 0x100c00) & ~0x08000000) | 0x00090000 | (hi <= 450 ? 0x08000000 : 0), false);
+		lab_g3_w(g, 0x10f300, mr0 | 0x00000100, true);
+		lab_g3_wait(g, 1000);
+		lab_g3_w(g, 0x10f300, mr0, true);
+		lab_g3_wait(g, 1000);
+		lab_g3_wait(g, dllwait);
+	} else {
+		lab_g3_wait(g, 5000);		/* DLL off: 5 us instead of the lock wait; origin of the number unknown */
+	}
+	v = lab_g3_cur(g, 0x10f830);
+	lab_g3_w(g, 0x10f830, v | 0x01000000, true);
+	lab_g3_w(g, 0x10f830, v, true);
+	lab_g3_op(g, 0x20, 2, 0x00000000, 0x00000000);
+	lab_g3_op(g, 0x34, 1, 0x0000000b, 0);
+
+	lab_g3_w(g, 0x100b0c, 0x00080028, true);
+	lab_g3_w(g, 0x611200, 0x00003330, true);
+	lab_g3_w(g, 0x10f200, lab_g3_cur(g, 0x10f200) | 0x00000800, true);
+	lab_g3_op(g, 0x16, 1, 0x00000000, 0);
+	return !g->err;
+}
+/* LAB_G3_CORE_END */
+
+#define LAB_GEN_LEVELS 8
+static struct lab_g3 lab_gen;
+static struct lab_step lab_gen_step;
+static char lab_gen_name[48];
+static bool lab_gen_ok;		/* the generator applies to this card (decided at load, lab_gen_probe) */
+static bool lab_gen_cur;	/* the armed step is a built one */
+static bool lab_gen_used;	/* a built script has run since load: the software state of the recorded plans is stale */
+static bool lab_gen_more;	/* the armed step is the first of two (divider -> PLL level -> divider) */
+static bool lab_gen_f618;	/* the VBIOS has a non-zero value for 0x10f618 at some memory level (lab_gen_probe) */
+
+static u32
+lab_gen_rd(void *priv, u32 reg)
+{
+	struct nvkm_device *device = priv;
+
+	return nvkm_rd32(device, reg);
+}
+
+/* memory levels of the VBIOS level table (sub-entry 5, as the clk domain table says): MHz and the clock source flag
+ * (bits 14-15, the same flag the core nodes have: 1 PLL, 2 divider, 0 not given) */
+static int
+lab_gen_levels(struct nvkm_subdev *subdev, u16 *mhz, u8 *flag, int max)
+{
+	struct nvkm_bios *bios = subdev->device->bios;
+	struct nvbios_perfE perfE;
+	u8 ver, hdr, cnt, len, sver, shdr;
+	u32 data, sdata;
+	int i = 0, n = 0;
+
+	while ((data = nvbios_perfEp(bios, i++, &ver, &hdr, &cnt, &len, &perfE))) {
+		u16 v;
+
+		if (ver != 0x40)
+			return -EINVAL;
+		if (perfE.pstate == 0xff)
+			continue;
+		sver = ver;
+		shdr = hdr;
+		sdata = nvbios_perfSe(bios, data, 5, &sver, &shdr, cnt, len);
+		if (!sdata || n >= max)
+			return -EINVAL;
+		v = nvbios_rd16(bios, sdata);
+		mhz[n] = v & 0x3fff;
+		flag[n++] = v >> 14;
+	}
+	return n;
+}
+
+/* no flag in the VBIOS: the divider, if it gives the frequency exactly */
+static bool
+lab_gen_want_pll(u8 flag, u32 mhz)
+{
+	if (flag == 1)
+		return true;
+	if (flag == 2)
+		return false;
+	return !mhz || (3240 % mhz) != 0 || 3240 / mhz < 2 || 3240 / mhz > 65;
+}
+
+/* VBIOS bytes of the level whose rammap range holds mhz (first: the first rammap entry, the lowest frequencies):
+ * rammap entry, ramcfg entry of the board's strap, timing entry. The same lookups as the stock gf100_ram_calc. */
+static int
+lab_gen_level(struct nvkm_subdev *subdev, u32 mhz, bool first, struct lab_g3_level *lv)
+{
+	struct nvkm_bios *bios = subdev->device->bios;
+	struct nvbios_ramcfg cfg;
+	u8 ver, hdr, cnt, len, strap, tver, thdr, tcnt, tlen, tidx;
+	u32 rammap, ramcfg, timing;
+	int i;
+
+	memset(lv, 0, sizeof(*lv));
+	if (first)
+		rammap = nvbios_rammapEp(bios, 0, &ver, &hdr, &cnt, &len, &cfg);
+	else
+		rammap = nvbios_rammapEm(bios, mhz, &ver, &hdr, &cnt, &len, &cfg);
+	if (!rammap || ver != 0x10 || hdr < 0x09 || hdr > sizeof(lv->M))
+		return -EINVAL;
+	strap = nvbios_ramcfg_index(subdev);
+	if (strap >= cnt || len < 0x0e || len > sizeof(lv->R))
+		return -EINVAL;
+	ramcfg = rammap + hdr + strap * len;
+	tidx = nvbios_rd08(bios, ramcfg + 0x01);
+	if (tidx == 0xff)
+		return -EINVAL;
+	timing = nvbios_timingEe(bios, tidx, &tver, &thdr, &tcnt, &tlen);
+	if (!timing || tver != 0x10 || thdr < 0x19 || thdr > sizeof(lv->T))
+		return -EINVAL;
+	for (i = 0; i < hdr; i++)
+		lv->M[i] = nvbios_rd08(bios, rammap + i);
+	for (i = 0; i < len; i++)
+		lv->R[i] = nvbios_rd08(bios, ramcfg + i);
+	for (i = 0; i < thdr; i++)
+		lv->T[i] = nvbios_rd08(bios, timing + i);
+	return 0;
+}
+
+/* memory frequency now, from the registers, kHz; *pll: the clock comes from the PLL (0x137360: 2 PLL, 3 divider).
+ * PLL: reference (3240 MHz over the divider in 0x137330) x N / M / P of 0x132004; divider: 3240 MHz / (code + 2). */
+static u32
+lab_gen_cur_khz(struct nvkm_device *device, bool *pll)
+{
+	if ((nvkm_rd32(device, 0x137360) & 0x00000003) == 0x00000002) {
+		u32 c = nvkm_rd32(device, 0x132004), r = nvkm_rd32(device, 0x137330);
+		u32 P = (c >> 16) & 0x3f, N = (c >> 8) & 0xff, M = c & 0xff, ref = 1620000;
+
+		*pll = true;
+		if (r & 0x80000000) {
+			if (nvkm_rd32(device, 0x137320) & 0x00000100)
+				r >>= 8;
+			ref = 3240000 / ((r & 0x3f) + 2);
+		}
+		return (M && P) ? ref * N / M / P : 0;
+	}
+	*pll = false;
+	return 3240000 / (((nvkm_rd32(device, 0x137310) >> 8) & 0x3f) + 2);
+}
+
+/* the VBIOS level nearest to the measured frequency, if within 1.5 % (the PLL gives 896.8 MHz for the 900 MHz level);
+ * otherwise the frequency itself */
+static u32
+lab_gen_snap(const u16 *mhz, int n, u32 khz)
+{
+	u32 best = 0, bd = ~0u;
+	int i;
+
+	for (i = 0; i < n; i++) {
+		u32 lv = mhz[i] * 1000, d = lv > khz ? lv - khz : khz - lv;
+
+		if (mhz[i] && d < bd) {
+			bd = d;
+			best = mhz[i];
+		}
+	}
+	if (best && bd <= 15 * best)
+		return best;
+	return (khz + 500) / 1000;
+}
+
+/* is the memory clock at the target the generator computed: same source, same coefficients or divider code */
+static bool
+lab_gen_there(struct nvkm_device *device, const struct lab_g3 *g)
+{
+	bool pll = (nvkm_rd32(device, 0x137360) & 0x00000003) == 0x00000002;
+
+	if (g->tgt_pll)
+		return pll && nvkm_rd32(device, 0x132004) == g->coef;
+	return !pll && ((nvkm_rd32(device, 0x137310) >> 8) & 0x3f) == g->div;
+}
+
+/* true the first time a script is seen (a ring of the last eight): each distinct script is printed once */
+static bool
+lab_gen_fresh(const u32 *w, int n)
+{
+	static u32 seen[8];
+	static int nseen;
+	u32 h = 2166136261u;
+	int i;
+
+	for (i = 0; i < n; i++)
+		h = (h ^ w[i]) * 16777619u;
+	for (i = 0; i < ARRAY_SIZE(seen) && i < nseen; i++)
+		if (seen[i] == h)
+			return false;
+	seen[nseen++ % ARRAY_SIZE(seen)] = h;
+	return true;
+}
+
+static void
+lab_gen_dump(struct nvkm_subdev *subdev, const char *what, const u32 *w, int n)
+{
+	char line[8 * 9 + 1];
+	int i, k, p;
+
+	for (i = 0; i < n; i += 8) {
+		for (k = 0, p = 0; k < 8 && i + k < n; k++)
+			p += scnprintf(line + p, sizeof(line) - p, " %08x", w[i + k]);
+		nvkm_info(subdev, "LAB gen %s %03d:%s\n", what, i, line);
+	}
+}
+
+/* Does the generator apply to this card? Decided from the hardware and the VBIOS (see the header above). */
+static bool
+lab_gen_probe(struct gf100_ram *ram)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct lab_g3_level lv;
+	u16 mhz[LAB_GEN_LEVELS];
+	u8 flag[LAB_GEN_LEVELS];
+	const char *why = NULL;
+	char list[128];
+	int n, i, p = 0;
+
+	if (ram->base.type != NVKM_RAM_TYPE_DDR3)
+		return false;
+	n = lab_gen_levels(subdev, mhz, flag, LAB_GEN_LEVELS);
+	if (nvkm_rd32(device, 0x022438) != 1 || nvkm_rd32(device, 0x02243c) != LAB_G3_FBPA)
+		why = "the memory is not one partition with two controllers";
+	else if (n <= 0)
+		why = "no VBIOS level table 4.0 with a memory entry";
+	else if (ram->mempll.reg != 0x132000 || ram->mempll.refclk != 405000)
+		why = "the VBIOS memory PLL is not 0x132000 with a 405 MHz reference";
+	else if (lab_gen_level(subdev, 0, true, &lv))
+		why = "the VBIOS memory tables (rammap, ramcfg, timing) are not version 1.0 of the known size";
+	lab_gen_f618 = false;
+	for (i = 0; !why && i < n; i++) {
+		if (!mhz[i])
+			continue;
+		if (lab_gen_level(subdev, mhz[i], false, &lv))
+			why = "a memory level has no VBIOS memory tables";
+		else if (lv.R[3] & 0x0f)
+			lab_gen_f618 = true;
+	}
+	if (why) {
+		nvkm_info(subdev, "LAB gen: the DDR3 script generator does not apply to this card: %s\n", why);
+		return false;
+	}
+	list[0] = 0;
+	for (i = 0; i < n; i++)
+		p += scnprintf(list + p, sizeof(list) - p, "%s%u (%s)", i ? ", " : "", mhz[i],
+			       lab_gen_want_pll(flag[i], mhz[i]) ? "PLL" : "divider");
+	nvkm_info(subdev, "LAB gen: DDR3 memory scripts can be built from the VBIOS and the register state here; memory levels, MHz: %s; register 0x10f618 is %s by this VBIOS. lab_mem_gen=%u (2 build and print, switch by the recorded scripts as before; 1 build and run; 0 recorded scripts only)\n",
+		  list, lab_gen_f618 ? "used" : "not used", lab_mem_gen);
+	return true;
+}
+
+/* Build the script for the transition "memory as the registers show it now" -> freq, and queue it for the PMU.
+ * One direct step; returns 0 with nothing armed if the memory is already there. dry: build and print only — nothing is
+ * queued and no register is written. */
+static int
+lab_gen_calc(struct gf100_ram *ram, u32 freq, bool dry)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct lab_g3 *g = &lab_gen;
+	u16 mhz[LAB_GEN_LEVELS];
+	u8 flag[LAB_GEN_LEVELS], f = 0;
+	u32 cur_khz, cur_mhz, words, via = 0;
+	bool on_pll, there, fresh;
+	int n, i, ret;
+
+	n = lab_gen_levels(subdev, mhz, flag, LAB_GEN_LEVELS);
+	if (n <= 0)
+		return -EINVAL;
+	memset(g, 0, sizeof(*g));
+	g->rd = lab_gen_rd;
+	g->priv = device;
+	g->run = -1;
+	g->display = true;	/* as NVIDIA at run time; with no active head the frame wait is skipped by the PMU code */
+	g->f618 = lab_gen_f618;
+	g->tgt_mhz = freq / 1000;
+	for (i = 0; i < n; i++)
+		if (mhz[i] == g->tgt_mhz)
+			f = flag[i];
+	g->tgt_pll = lab_gen_want_pll(f, g->tgt_mhz);
+	cur_khz = lab_gen_cur_khz(device, &on_pll);
+	cur_mhz = lab_gen_snap(mhz, n, cur_khz);
+	g->on_pll = on_pll;
+	lab_gen_more = false;
+	if (!on_pll && !g->tgt_pll && g->tgt_mhz > cur_mhz && !READ_ONCE(lab_mem_gen_updiv)) {
+		/* divider -> divider upwards: no recording of this kind; go through the highest PLL level */
+		for (i = 0; i < n; i++)
+			if (mhz[i] > via && lab_gen_want_pll(flag[i], mhz[i]))
+				via = mhz[i];
+		if (!via) {
+			nvkm_error(subdev, "LAB gen: %u -> %u MHz is divider -> divider upwards, not in any recording, and the VBIOS has no PLL level to go through - memory untouched (lab_mem_gen_updiv=1 allows the direct step)\n",
+				   cur_mhz, g->tgt_mhz);
+			return -EINVAL;
+		}
+		nvkm_info(subdev, "LAB gen: %u -> %u MHz is divider -> divider upwards, not in any recording: going through the PLL level %u MHz in two steps (lab_mem_gen_updiv=1 allows the direct step)\n",
+			  cur_mhz, g->tgt_mhz, via);
+		g->tgt_mhz = via;
+		g->tgt_pll = true;
+		lab_gen_more = !dry;
+	}
+	g->pll.refclk = ram->mempll.refclk;
+	g->pll.min_freq = ram->mempll.vco1.min_freq;
+	g->pll.max_freq = ram->mempll.vco1.max_freq;
+	g->pll.min_in = ram->mempll.vco1.min_inputfreq;
+	g->pll.max_in = ram->mempll.vco1.max_inputfreq;
+	g->pll.min_m = ram->mempll.vco1.min_m;
+	g->pll.max_m = ram->mempll.vco1.max_m;
+	g->pll.min_n = ram->mempll.vco1.min_n;
+	g->pll.max_n = ram->mempll.vco1.max_n;
+	g->pll.min_p = ram->mempll.min_p;
+	g->pll.max_p = ram->mempll.max_p;
+	if (lab_gen_level(subdev, cur_mhz, false, &g->cur) || lab_gen_level(subdev, g->tgt_mhz, false, &g->tgt) ||
+	    lab_gen_level(subdev, 0, true, &g->low)) {
+		nvkm_error(subdev, "LAB gen: no VBIOS memory tables for %u MHz (now, %u kHz) or %u MHz (target) - memory untouched\n",
+			   cur_mhz, cur_khz, g->tgt_mhz);
+		return -EINVAL;
+	}
+	if (!lab_g3_target(g)) {
+		nvkm_error(subdev, "LAB gen: target %u MHz: %s - memory untouched\n", g->tgt_mhz, g->err ? g->err : "?");
+		return -EINVAL;
+	}
+	there = lab_gen_there(device, g);
+	nvkm_info(subdev, "LAB gen: memory now %u kHz on the %s (level %u MHz; 0x137360=%08x 0x132000=%08x 0x132004=%08x 0x137310=%08x), target %u MHz on the %s (gives %u kHz)%s\n",
+		  cur_khz, on_pll ? "PLL" : "divider", cur_mhz, nvkm_rd32(device, 0x137360), nvkm_rd32(device, 0x132000),
+		  nvkm_rd32(device, 0x132004), nvkm_rd32(device, 0x137310), g->tgt_mhz, g->tgt_pll ? "PLL" : "divider",
+		  g->got_khz, there ? " - already there, no script" : "");
+	if (there)
+		return 0;
+	if (!lab_g3_pre(g) || !lab_g3_script(g)) {
+		nvkm_error(subdev, "LAB gen: script not built: %s - memory untouched\n", g->err ? g->err : "?");
+		return -EINVAL;
+	}
+	snprintf(lab_gen_name, sizeof(lab_gen_name), "built %u(%s)->%u(%s)", cur_mhz, on_pll ? "PLL" : "div",
+		 g->tgt_mhz, g->tgt_pll ? "PLL" : "div");
+	lab_gen_step = (struct lab_step){ lab_gen_name, g->pre, 2 * g->npre, g->scr, g->nscr, NULL, 0, 0, true };
+	ret = lab_interp(subdev, NULL, &lab_gen_step, false, &words);
+	if (ret || words > 480) {
+		nvkm_error(subdev, "LAB gen %s: script does not fit the PMU (ret %d, %u memx words) - memory untouched\n",
+			   lab_gen_name, ret, words);
+		return ret ? ret : -E2BIG;
+	}
+	fresh = lab_gen_fresh(g->scr, g->nscr);
+	if (fresh && lab_mem_gen_dump > 0) {
+		lab_mem_gen_dump--;
+		nvkm_info(subdev, "LAB gen %s: %d host writes before the script, %d script words (NVIDIA format), about %u memx words\n",
+			  lab_gen_name, g->npre, g->nscr, words);
+		lab_gen_dump(subdev, "pre", g->pre, 2 * g->npre);
+		lab_gen_dump(subdev, "scr", g->scr, g->nscr);
+	}
+	if (dry) {
+		if (fresh)
+			nvkm_info(subdev, "LAB gen %s: built and printed only (lab_mem_gen=2); lab_mem_gen=1 runs built scripts\n",
+				  lab_gen_name);
+		return 0;
+	}
+	/* GT 630M (Medion): two registers NVIDIA sets once at its init and no script writes (see lab_plan_medion). The
+	 * board's tester ran 12 transitions with data checks without them (lab_medion_init=0, 26.11) and all passed; that
+	 * was one run, not a soak, so the write stays under its key (default 1): the first built scripts then run in the
+	 * state his whole series was done in */
+	if (lab_board && lab_board->plan == lab_plan_medion && !on_pll && READ_ONCE(lab_medion_init)) {
+		u32 a = nvkm_rd32(device, 0x10f440), c = nvkm_rd32(device, 0x10f160);
+
+		nvkm_wr32(device, 0x10f440, 0x22f84f10);
+		nvkm_mask(device, 0x10f160, 0x00000010, 0x00000010);
+		nvkm_info(subdev, "LAB gen GT 630M: NVIDIA init state: 0x10f440 %08x -> %08x, 0x10f160 %08x -> %08x\n",
+			  a, nvkm_rd32(device, 0x10f440), c, nvkm_rd32(device, 0x10f160));
+	}
+	lab_rp611 = nvkm_rd32(device, 0x611200);
+	ret = ram_init(&ram->fuc, ram->base.fb);
+	if (ret)
+		return ret;
+	ret = lab_interp(subdev, ram->fuc.base.memx, &lab_gen_step, true, &words);
+	if (ret) {
+		ram_exec(&ram->fuc, false);
+		return ret;
+	}
+	lab_gen_cur = true;
+	lab_armed = true;
+	return 0;
+}
+
+/* After a built script ran: check on the registers that the memory clock is where the script should have left it, and
+ * only then make the host writes that follow the script (they assume it ran: a divider target, for one, gets the PLL
+ * enable bit cleared). */
+static void lab_host_writes(struct nvkm_subdev *subdev, const char *what, const u32 *l, int n);
+static int
+lab_gen_done(struct nvkm_subdev *subdev)
+{
+	struct nvkm_device *device = subdev->device;
+	struct lab_g3 *g = &lab_gen;
+	bool pll;
+	u32 khz;
+
+	bool more = lab_gen_more;
+
+	lab_gen_cur = false;
+	lab_gen_more = false;
+	lab_gen_used = true;
+	khz = lab_gen_cur_khz(device, &pll);
+	if (!lab_gen_there(device, g)) {
+		nvkm_error(subdev, "LAB gen %s: after the script the memory clock is not at the target: %u kHz on the %s (0x137360=%08x 0x132000=%08x 0x132004=%08x 0x137310=%08x; wanted %u kHz on the %s) - host writes after the script skipped\n",
+			   lab_gen_name, khz, pll ? "PLL" : "divider", nvkm_rd32(device, 0x137360), nvkm_rd32(device, 0x132000),
+			   nvkm_rd32(device, 0x132004), nvkm_rd32(device, 0x137310), g->got_khz, g->tgt_pll ? "PLL" : "divider");
+		return -EIO;
+	}
+	if (!lab_g3_post(g)) {
+		nvkm_error(subdev, "LAB gen %s: host writes after the script not built: %s\n", lab_gen_name, g->err ? g->err : "?");
+		return -EINVAL;
+	}
+	lab_host_writes(subdev, "после скрипта", g->post, 2 * g->npost);
+	nvkm_info(subdev, "LAB gen %s: memory at the target, %u kHz on the %s%s\n", lab_gen_name, khz, pll ? "PLL" : "divider",
+		  more ? "; second step follows" : "");
+	return more ? 1 : 0;	/* 1: the caller runs calc and prog again for the level it asked for */
+}
+/* =================== end of LAB: DDR3 memory scripts built from the VBIOS =================== */
+
+static int
+lab_replay_calc(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct lab_step *st;
+	u32 words;
+	int ret, i;
+
+	if (lab_plan_i >= lab_plan_n) {
+		int cur = lab_cur_mhz(device), t = freq / 1000, tgt;
+
+		lab_plan_n = lab_plan_i = 0;
+		lab_gen_cur = false;
+		if (lab_gen_ok) {		/* 26.11: DDR3 — the script can be built instead of replayed */
+			u32 mode = READ_ONCE(lab_mem_gen);
+
+			if (mode == 1)
+				return lab_gen_calc(ram, freq, false);
+			if (mode) {		/* 2: build and print; the switch stays with the recorded scripts, if any */
+				static int failed;
+
+				if (failed < 3 && lab_gen_calc(ram, freq, true) < 0 && ++failed == 3)
+					nvkm_warn(subdev, "LAB gen: three builds failed - no more build attempts until the module is reloaded (lab_mem_gen=2)\n");
+				if (!lab_board)
+					return 0;
+			}
+		}
+		if (lab_gen_used) {
+			nvkm_error(subdev, "LAB replay: recorded scripts are refused after a built script has run (their plans keep their own copy of the memory state) - reload the module with lab_mem_gen=0\n");
+			return -EBUSY;
+		}
+		if (!lab_board) {
+			nvkm_error(subdev, "LAB replay: плата не описана — память не трогаю (lab_mem=0 для ядра без памяти)\n");
+			return -ENODEV;
+		}
+		/* 21.11: ближайший из трёх уровней платы (у DDR3 верх 900 — прежний порог «1000» относил его к среднему) */
+		tgt = lab_board->lo;
+		if (abs(t - lab_board->mid) < abs(t - tgt)) tgt = lab_board->mid;
+		if (abs(t - lab_board->hi) < abs(t - tgt)) tgt = lab_board->hi;
+		if (abs(t - tgt) > 5) {
+			nvkm_error(subdev, "LAB replay: цель %d МГц не из записи (%d/%d/%d)\n", t, lab_board->lo, lab_board->mid, lab_board->hi);
+			return -EINVAL;
+		}
+		ret = lab_board->plan(subdev, lab_board, cur, tgt, lab_plan);
+		if (ret < 0)
+			return ret;
+		lab_plan_n = ret;
+		nvkm_info(subdev, "LAB replay [%s]: память сейчас %d МГц, цель %d МГц, шагов %d (lab_mem_replay=%u)\n",
+			  lab_board->name, cur, tgt, lab_plan_n, lab_mem_replay);
+		for (i = 0; i < lab_plan_n; i++) {
+			const struct lab_step *s = &lab_board->steps[lab_plan[i]];
+
+			if (!(lab_mem_replay & s->need)) {
+				nvkm_error(subdev, "LAB replay: шаг %s не разрешён (нужен бит %u) — память не трогаю\n",
+					   s->name, s->need);
+				lab_plan_n = 0;
+				return -EINVAL;
+			}
+			ret = lab_interp(subdev, NULL, s, false, &words);
+			if (ret || words > 480) {
+				nvkm_error(subdev, "LAB replay: шаг %s не годится (ret %d, %u слов memx)\n",
+					   s->name, ret, words);
+				lab_plan_n = 0;
+				return ret ? ret : -E2BIG;
+			}
+		}
+		if (!lab_plan_n)
+			return 0;	/* уже на месте: prog ничего не делает */
+	}
+
+	st = &lab_board->steps[lab_plan[lab_plan_i]];
+	lab_rp611 = nvkm_rd32(device, 0x611200);
+	ret = ram_init(&ram->fuc, ram->base.fb);
+	if (ret) {
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	ret = lab_interp(subdev, ram->fuc.base.memx, st, true, &words);
+	if (ret) {
+		ram_exec(&ram->fuc, false);
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	lab_armed = true;
+	return 0;
+}
+
+/* какие биты записи в регистр GPIO принадлежат линиям напряжения ядра (их берём из текущего значения регистра).
+ * Раскладка — из открытого кода nouveau: gpio/nv50.c (GF100…GF116: 8 линий на регистр, 4 бита на линию),
+ * gpio/gf119.c (GF117, GF119: регистр на линию, 0x00d610 + 4 · линия). */
+static u32
+lab_vid_keep(struct nvkm_device *device, u32 addr)
+{
+	static const u8 tags[] = { DCB_GPIO_VID0, DCB_GPIO_VID1, DCB_GPIO_VID2, DCB_GPIO_VID3,
+				   DCB_GPIO_VID4, DCB_GPIO_VID5, DCB_GPIO_VID6, DCB_GPIO_VID7 };
+	static const u32 regs[4] = { 0x00e104, 0x00e108, 0x00e280, 0x00e284 };
+	struct nvkm_gpio *gpio = device->gpio;
+	struct dcb_gpio_func func;
+	u32 keep = 0;
+	int i;
+
+	if (!gpio)
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(tags); i++) {
+		if (nvkm_gpio_find(gpio, 0, tags[i], DCB_GPIO_UNUSED, &func))
+			continue;
+		if (device->chipset >= 0xd0) {
+			if (addr == 0x00d610 + func.line * 4)
+				keep = 0xffffffff;
+		} else if (func.line < 32 && addr == regs[func.line >> 3]) {
+			keep |= 0x0000000f << ((func.line & 7) << 2);
+		}
+	}
+	return keep;
+}
+
+static void
+lab_host_writes(struct nvkm_subdev *subdev, const char *what, const u32 *l, int n)
+{
+	struct nvkm_device *device = subdev->device;
+	int i, cnt = 0, kept = 0;
+
+	for (i = 0; i + 1 < n; i += 2) {
+		u32 addr = l[i], data = l[i + 1];
+
+		if (lab_mem_replay & 16) {
+			/* всё как записано, вместе с линиями напряжения (опыт) */
+		} else if (!READ_ONCE(lab_mem_vidmask)) {
+			if (addr == 0x00e104)	/* как до 24.11 */
+				continue;
+		} else {
+			u32 keep = lab_vid_keep(device, addr);
+
+			if (keep) {
+				u32 cur = nvkm_rd32(device, addr);
+
+				data = (data & ~keep) | (cur & keep);
+				kept++;
+				if (data == cur)	/* кроме линий напряжения, запись ничего не меняет */
+					continue;
+			}
+		}
+		nvkm_wr32(device, addr, data);
+		cnt++;
+	}
+	if (n)
+		nvkm_info(subdev, "LAB replay: прямых записей %s: %d (записей GPIO с линиями напряжения ядра: %d — линии не тронуты)\n",
+			  what, cnt, kept);
+}
+
+static int
+lab_replay_prog(struct gf100_ram *ram)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct lab_step *st;
+	ktime_t t0;
+	s64 us;
+	int ret;
+
+	if (!lab_armed)
+		return 0;
+	st = lab_gen_cur ? &lab_gen_step : &lab_board->steps[lab_plan[lab_plan_i]];
+	lab_host_writes(subdev, "до скрипта", st->pre, st->npre);
+	if (!st->gen && READ_ONCE(lab_mem_line750) == 1 && lab_line750_wanted(device, st)) {
+		/* 25.11: линии DDR3 перед подъёмом выше 750 МГц — прямой записью, как в проверенной правке тестировщика */
+		u32 la[LAB_LINE750_MAX], lv[LAB_LINE750_MAX];
+		int ln = lab_line750_list(device, la, lv), i;
+
+		for (i = 0; i < ln; i++) {
+			nvkm_info(subdev, "LAB replay %s: линии памяти DDR3, цель выше 750 МГц: 0x%06x %08x -> %08x (прямая запись перед скриптом)\n",
+				  st->name, la[i], nvkm_rd32(device, la[i]), lv[i]);
+			nvkm_wr32(device, la[i], lv[i]);
+		}
+		if (!ln)
+			nvkm_info(subdev, "LAB replay %s: линии памяти DDR3, цель выше 750 МГц: бит 1 тетрад уже снят\n", st->name);
+	}
+	t0 = ktime_get();
+	ret = ram_exec(&ram->fuc, true);
+	us = ktime_us_delta(ktime_get(), t0);
+	lab_armed = false;
+	nvkm_info(subdev, "LAB replay %s: выполнен за %lld мкс (op13×%u op34=%u syncwait=%u), ret %d; 0x137310=%08x 0x1373f0=%08x 0x137360=%08x 0x132000=%08x 0x132004=%08x 0x10f290=%08x 0x10f300=%08x 0x611200=%08x; память теперь %d МГц\n",
+		  st->name, us, lab_mem_op13, lab_mem_op34, lab_mem_syncwait, ret, nvkm_rd32(device, 0x137310), nvkm_rd32(device, 0x1373f0),
+		  nvkm_rd32(device, 0x137360), nvkm_rd32(device, 0x132000), nvkm_rd32(device, 0x132004), nvkm_rd32(device, 0x10f290),
+		  nvkm_rd32(device, 0x10f300), nvkm_rd32(device, 0x611200), lab_cur_mhz(device));
+	if (st->gen) {		/* 26.11: built script — one step; check the result, then the host writes after it */
+		int r = lab_gen_done(subdev);
+
+		lab_plan_n = lab_plan_i = 0;
+		return ret < 0 ? ret : r;
+	}
+	lab_host_writes(subdev, "после скрипта", st->post, st->npost);
+	if (ret < 0) {
+		if (lab_board && lab_board->after)
+			lab_board->after(-1);		/* шаг не прошёл — где память, не знаем */
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	if (lab_board && lab_board->after)
+		lab_board->after(lab_plan[lab_plan_i]);	/* 29.10 GF106, 21.11 GF108: помнит, какой шаг выполнен */
+	if (++lab_plan_i < lab_plan_n)
+		return 1;	/* ещё шаг: nouveau снова вызовет calc/prog */
+	lab_plan_n = lab_plan_i = 0;
+	return 0;
+}
+/* =================== конец LAB: повтор скриптов памяти NVIDIA =================== */
+
 int
 gf100_ram_calc(struct nvkm_ram *base, u32 freq)
 {
@@ -142,6 +4500,16 @@
