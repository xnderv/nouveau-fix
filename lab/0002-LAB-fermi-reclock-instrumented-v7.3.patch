+/* второе поле уровня: id напряжения (байт 14) и порог, °C (байт 16); false — поля нет или оно не годится */
+static bool
+lab_vc_field(struct nvkm_clk *clk, struct nvkm_pstate *pstate, u8 *id, u8 *thr)
+{
+	struct nvkm_subdev *subdev = &clk->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_bios *bios = device->bios;
+	struct nvkm_volt *volt = device->volt;
+	struct nvbios_perfE perfE;
+	static u32 said;
+	u8 ver, hdr, cnt, len;
+	u32 data;
+	int i, uv2, uv14;
+
+	if (!volt || device->card_type != NV_C0)
+		return false;
+	for (i = 0; (data = nvbios_perfEp(bios, i, &ver, &hdr, &cnt, &len, &perfE)); i++) {
+		if (perfE.pstate != pstate->pstate)
+			continue;
+		if (ver != 0x40 || hdr <= 0x10)
+			return false;
+		*id = nvbios_rd08(bios, data + 0x0e);
+		*thr = nvbios_rd08(bios, data + 0x10);
+		if (!*thr)
+			return false;
+		uv2 = nvkm_volt_map(volt, pstate->base.voltage, clk->temp);
+		uv14 = nvkm_volt_map(volt, *id, clk->temp);
+		if (uv2 <= 0 || uv14 < uv2 || (u32)uv14 < volt->min_uv || (u32)uv14 > volt->max_uv)
+			return false;
+		if (i < 32 && !(said & (1u << i))) {
+			said |= 1u << i;
+			nvkm_info(subdev, "LAB volt_cold: уровень %02x — VBIOS задаёт %d мкВ, пока чип холоднее %u °C, и %d мкВ для нагретого (байты 14, 16 и 2 записи уровня)\n",
+				  pstate->pstate, uv14, *thr, uv2);
+		}
+		return true;
+	}
+	return false;
+}
+
+/* состояние «холодный / нагрет» по датчику, с запасом; true — чип считается нагретым */
+static bool
+lab_vc_hot(struct nvkm_clk *clk, u8 thr)
+{
+	struct nvkm_therm *therm = clk->subdev.device->therm;
+	int temp = therm ? nvkm_therm_temp_get(therm) : -ENODEV;
+	int st = READ_ONCE(lab_volt_cold_state), hyst = READ_ONCE(lab_volt_cold_hyst);
+
+	if (temp < 0)	/* датчик не читается — как до 25.11: основное напряжение; состояние не трогаем */
+		return true;
+	if (st == 0)
+		st = temp >= thr + hyst ? 2 : 1;
+	else if (st == 1 && temp >= thr + hyst)
+		st = 2;
+	else if (st == 2 && temp < thr)
+		st = 1;
+	WRITE_ONCE(lab_volt_cold_state, st);
+	return st == 2;
+}
+
+/* id напряжения уровня с учётом второго поля; чужие id (не основное напряжение уровня) возвращаются как есть */
+static u8
+lab_vc_id(struct nvkm_clk *clk, struct nvkm_pstate *pstate, u8 id)
+{
+	u8 id14, thr;
+
+	if (!READ_ONCE(lab_volt_cold) || id != pstate->base.voltage || !lab_vc_field(clk, pstate, &id14, &thr))
+		return id;
+	return lab_vc_hot(clk, thr) ? id : id14;
+}
+
+/* переставить напряжение текущего уровня, не трогая такты; вызывается из рабочей очереди уровней */
+static void
+lab_vc_apply(struct nvkm_clk *clk)
+{
+	struct nvkm_subdev *subdev = &clk->subdev;
+	struct nvkm_volt *volt = subdev->device->volt;
+	struct nvkm_pstate *pstate;
+	int idx = 0, was, ret;
+	u8 id;
+
+	if (!volt || clk->pstate < 0)
+		return;
+	list_for_each_entry(pstate, &clk->states, head) {
+		if (idx++ != clk->pstate)
+			continue;
+		id = lab_vc_id(clk, pstate, pstate->base.voltage);
+		was = nvkm_volt_get(volt);
+		ret = nvkm_volt_set_id(volt, id, id, clk->temp, 0);
+		nvkm_info(subdev, "LAB volt_cold: уровень %02x, чип %s — напряжение %d -> %d мкВ (id %u, ret %d)\n", pstate->pstate,
+			  READ_ONCE(lab_volt_cold_state) == 2 ? "нагрет" : "холодный", was, nvkm_volt_get(volt), id, ret);
+		return;
+	}
+}
