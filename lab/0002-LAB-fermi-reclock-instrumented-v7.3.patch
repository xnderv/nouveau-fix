+ * уровне, память 135 МГц» вешает графический блок за 12–34 с; то же сочетание с XBAR2CLK на 270 МГц стоит 10 минут.
+ * Значение 1 («шина снаружи памяти», по умолчанию с 22.11) проходит через это сочетание на каждом подъёме 03 -> 0f, примерно
+ * 10 мс; порядок NVIDIA для этого чипа (−1 или 0) через него не проходит. В обычной работе на значении 1 зависаний не было
+ * (3630 подъёмов, опыты 119, 121, 122), так что вред порядка в обычной работе — предположение, а не факт. Идёт прямое
+ * сравнение порядков в обычной работе (опыты 124 и 125); до его итога значение по умолчанию не меняется. */
+static int lab_nv_xbarmem = 1;	/* 22.11: шина снаружи для ВСЕХ чипов; на GF108/GF117 так делает NVIDIA; порядок NVIDIA остальных — 0 */
+module_param(lab_nv_xbarmem, int, 0644);
+MODULE_PARM_DESC(lab_nv_xbarmem, "LAB: XBAR2CLK vs memory order: 1 XBAR outside memory (default, all chips); 0 memory outside XBAR (NVIDIA on GF100-GF116/GF119); -1 by memory topology, as NVIDIA does on each chip");
+/* LAB 23.11: топология памяти из железа; возвращает «шина снаружи памяти по правилу NVIDIA», один раз пишет в журнал */
+static bool
+lab_mem_topo(struct nvkm_subdev *subdev)
+{
+	struct nvkm_device *device = subdev->device;
+	static int cached = -1;
+	u32 fbp, fbpa, mask, slices, act;
+
+	if (cached >= 0)
+		return cached;
+	fbp    = nvkm_rd32(device, 0x022438);
+	fbpa   = nvkm_rd32(device, 0x02243c);
+	mask   = nvkm_rd32(device, 0x022554);
+	slices = nvkm_rd32(device, 0x17e8dc) >> 28;
+	act    = fbp - hweight32(mask & (fbp < 32 ? (1u << fbp) - 1 : ~0u));
+	cached = (act == 1 && slices >= 2);
+	nvkm_info(subdev, "LAB топология памяти: разделов %u (выключены %#x, активных %u), контроллеров %u, "
+		  "подразделов на раздел %u -> по правилу NVIDIA шина XBAR %s памяти; адрес синхронизации 0x%06x\n",
+		  fbp, mask, act, fbpa, slices, cached ? "снаружи" : "внутри", 0x13d834 + 0x40 * (act ? act - 1 : 0));
+	return cached;
+}
