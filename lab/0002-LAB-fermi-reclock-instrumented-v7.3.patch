+module_param(lab_therm_real, uint, 0644);
+MODULE_PARM_DESC(lab_therm_real, "LAB: bracket only when the domain mux bit really changes (0 = every stage-1/3 call, 1 = real changes only)");
+static uint lab_clk_mmu_lock = 0;	/* 19.11: по умолчанию как служба (набор 18.11) */
+module_param(lab_clk_mmu_lock, uint, 0644);
+MODULE_PARM_DESC(lab_clk_mmu_lock, "LAB: hold mmu->mutex (serialises TLB invalidates) across the clock programming stages (0 off, 1 on)");
