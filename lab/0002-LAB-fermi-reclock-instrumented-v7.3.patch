+		   nvkm_rd32(device, 0x020160), nvkm_rd32(device, 0x020164), nvkm_rd32(device, 0x020004),
+		   nvkm_rd32(device, 0x400700), nvkm_rd32(device, 0x400500), nvkm_rd32(device, 0x002640),
+		   nvkm_rd32(device, 0x00e800), nvkm_rd32(device, 0x00e804),	/* опорный генератор ядра и делителей */
+		   nvkm_rd32(device, 0x00e820), nvkm_rd32(device, 0x00e824));
