+/* LAB 24.10 вечер (зависание 16:54, тест 34б): переключатель источника 0x137100 иногда не уходит с PLL на делитель за 2 с
+ * (всегда GPC, спуск с 0f; ~3–4 на 1000 переходов с 23.10). Раньше это маскировала стадия 2 — она выключает PLL; с
+ * lab_pll_keep GPC остался на PLL 1800 МГц при 0,95 В. Снимок состояния в момент тайм-аута пишется всегда (поведение не
+ * меняется), счётчик — lab_mux_timeouts. lab_mux_guard (0 — выкл): до трёх повторов (новая скобка + запись бита, по 20 мс);
+ * если узел так и остался на PLL — стадия 2 его PLL не выключает, а clk/base.c не снижает напряжение в этом переходе. */
+/* LAB 25.10: снимок регистров при каждой инициализации драйвера (загрузка, выход из сна) — только чтение, до выбора
+ * первого уровня. Тайм-ауты переключателя GPC были только в загрузках 24.10 00:43–16:57 и ни в одной другой; снимки
+ * разных загрузок можно сравнить (lab/bootsnap.sh). Блоки, которые всегда под тактом: тактирование, PTHERM, GPIO/ШИМ. */
+static uint lab_boot_snap = 1;
+module_param(lab_boot_snap, uint, 0644);
+MODULE_PARM_DESC(lab_boot_snap, "LAB: log a read-only register snapshot (clocks, PTHERM, GPIO/PWM) at every clk init (0 off, 1 on)");
+/* LAB 27.10 (переоценка, тест 59 / опыт Е10): состояние после загрузки как у NVIDIA. При загрузке модуля и 270.41.06 (2011),
+ * и 390.157 (2022) пишут 0x1371c8 = 0x1371cc = 0x30000 (CLK26/27 по rnndb; назначение неизвестно) и восемь регистров
+ * 0x139060 + k·0x40 = 0x74 (у нас с VBIOS 0x7c); nouveau их не трогает. Значения — из записей (класс А). Пишется при каждой
+ * инициализации тактов, после снимка (снимок — состояние до записи). Это ключ ЗАГРУЗКИ: действует только если задан при
+ * загрузке модуля (nouveau.lab_nv_boot=1 в строке ядра или в /etc/modprobe.d), через sysfs после загрузки — нет. */
+static uint lab_nv_boot;
+module_param(lab_nv_boot, uint, 0644);
+MODULE_PARM_DESC(lab_nv_boot, "LAB: at clk init write 0x1371c8/cc = 0x30000 and 0x139060..0x139220 (step 0x40) = 0x74, as the NVIDIA driver does at load (0 off, 1 on)");
+
+/* LAB 25.11: чтение «на пробу» — есть ли регистр на этом чипе, спрашиваем у самого чипа, без списка чипов.
+ * Списки снимка составлены по нашей карте. На другом чипе части регистров нет, и обычное чтение даёт ошибку шины: прерывание и
+ * строку «MMIO read … FAULT» в журнале (отчёты тестировщиков: счётчик второго GPC на GF108, блок GPIO и регистр PCIe на GF119).
+ * На время чтений снимаем разрешение трёх прерываний ошибок шины (0x001140, биты 1–3 — их ставит gf100_bus_init), после
+ * каждого чтения смотрим признак ошибки (0x001100, те же биты) и снимаем его так же, как обработчик nouveau gf100_bus_intr
+ * (0x009084 = 0, запись этих битов в 0x001100). Регистр, которого нет, печатается как «нет».
+ * Заодно снимается старая отметка адреса ошибки (0x009084): её оставляет ещё инициализация по VBIOS (запись в порты блоков GPC,
+ * которых у чипа нет), и nouveau потом печатал этот чужой адрес при первой же настоящей ошибке шины. */
+static u32
+lab_probe_begin(struct nvkm_subdev *subdev)
+{
+	struct nvkm_device *device = subdev->device;
+	u32 en = nvkm_mask(device, 0x001140, 0x0000000e, 0x00000000);
+	u32 st = nvkm_rd32(device, 0x001100) & 0x0000000e, addr = nvkm_rd32(device, 0x009084);
+
+	if (st || addr) {
+		nvkm_info(subdev, "LAB probe: в чипе уже стояла отметка ошибки шины (%s по адресу %06x, признак %x) — не от этих чтений; снята\n",
+			  (addr & 0x00000002) ? "запись" : "чтение", addr & 0x00fffffc, st);
+		nvkm_wr32(device, 0x009084, 0x00000000);
+		if (st)
+			nvkm_wr32(device, 0x001100, st);
+	}
+	return en;
+}
+
+static void
+lab_probe_end(struct nvkm_device *device, u32 en)
+{
+	nvkm_mask(device, 0x001140, 0x0000000e, en & 0x0000000e);
+}
+
+/* одно чтение между lab_probe_begin и lab_probe_end; false — регистра нет, в *why биты причины (2 !ENGINE, 4 PRIVRING, 8 TIMEOUT) */
+static bool
+lab_probe_rd32(struct nvkm_device *device, u32 addr, u32 *val, u32 *why)
+{
+	u32 st;
+
+	*val = nvkm_rd32(device, addr);
+	st = nvkm_rd32(device, 0x001100) & 0x0000000e;
+	if (why)
+		*why = st;
+	if (!st)
+		return true;
+	nvkm_wr32(device, 0x009084, 0x00000000);
+	nvkm_wr32(device, 0x001100, st);
+	return false;
+}
+
+/* LAB 25.11: lab_probe_addr — прочитать один регистр «на пробу» на ходу: echo 0xАДРЕС > /sys/module/nouveau/parameters/lab_probe_addr,
+ * ответ — в журнале ядра («= значение» или «регистра нет»). Только чтение; у некоторых регистров чтение меняет состояние
+ * (порты с указателем) — такие не трогать. Нужен, чтобы выяснять у тестировщика, есть ли регистр на его чипе, одной командой. */
+static struct nvkm_subdev *lab_probe_subdev;	/* ставится в lab_boot_snapshot */
+static int
+lab_probe_addr_set(const char *val, const struct kernel_param *kp)
+{
+	struct nvkm_subdev *subdev = READ_ONCE(lab_probe_subdev);
+	u32 addr, v, why, en;
+	int ret = kstrtou32(val, 0, &addr);
+
+	if (ret)
+		return ret;
+	if (!subdev)
+		return -ENODEV;
+	if ((addr & 3) || addr >= 0x01000000)
+		return -EINVAL;
+	en = lab_probe_begin(subdev);
+	if (lab_probe_rd32(subdev->device, addr, &v, &why))
+		nvkm_info(subdev, "LAB probe %06x = %08x\n", addr, v);
+	else
+		nvkm_info(subdev, "LAB probe %06x: регистра нет (%s%s%s)\n", addr, (why & 2) ? "!ENGINE " : "",
+			  (why & 4) ? "PRIVRING " : "", (why & 8) ? "TIMEOUT " : "");
+	lab_probe_end(subdev->device, en);
+	return 0;
+}
+static const struct kernel_param_ops lab_probe_addr_ops = { .set = lab_probe_addr_set };
+module_param_cb(lab_probe_addr, &lab_probe_addr_ops, NULL, 0200);
+MODULE_PARM_DESC(lab_probe_addr, "LAB: write a register address to read it once without a bus-fault message; the answer goes to the kernel log (tells whether the register exists on this chip)");
+
+static void
+lab_snap_line(struct nvkm_subdev *subdev, int n, const char *name, const u32 *addr, int cnt)
+{
+	struct nvkm_device *device = subdev->device;
+	char buf[400];
+	int i, o = 0;
+	u32 v;
+
+	for (i = 0; i < cnt; i++) {	/* 25.11: чтение «на пробу» — вызывать между lab_probe_begin и lab_probe_end */
+		if (lab_probe_rd32(device, addr[i], &v, NULL))
+			o += scnprintf(buf + o, sizeof(buf) - o, " %06x=%08x", addr[i], v);
+		else
+			o += scnprintf(buf + o, sizeof(buf) - o, " %06x=нет", addr[i]);
+	}
+	nvkm_info(subdev, "LAB boot snap #%d %s:%s\n", n, name, buf);
+}
