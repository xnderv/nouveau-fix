+		}
+		if (sp & 4) {
+			u32 f3 = nvkm_rd32(device, 0x020180);
+
+			nvkm_wr32(device, 0x020180, 0x2);
+			udelay(20);
+			lab_cntr_sys_pass(clk, mask, "команда замедления GPC /2");
