+static int lab_mux_timeouts;
+module_param(lab_mux_timeouts, int, 0444);
+MODULE_PARM_DESC(lab_mux_timeouts, "LAB: clock source mux switch timeouts since load (read-only counter)");
+/* LAB 25.10: порядок как у NVIDIA (записи t1/t2): мультиплексор записан — замедление FSRM снимается сразу, подтверждение
+ * переключения ждём уже без замедления. Без ключа (как было) ждём до 2 с внутри скобки, и тайм-аут ~0,5–1 %. */
+static uint lab_nv_mux_release;
+module_param(lab_nv_mux_release, uint, 0644);
+/* LAB 27.10 (переоценка, тест 60 / опыт Е13): PLL ядра выключать внутри скобки сразу после переключателя, как 270.41.06
+ * (2011): через ~88 мкс после записи 0x137100 = 0x180 он пишет 0x137000 = 0x30004 (бит 0 снят, бит 2 оставлен), ещё до
+ * снятия замедления. У нас PLL выключает стадия 2, уже после скобки (390 на спуске PLL не выключает вовсе). Только ядро,
+ * только уход с PLL на делитель, только если переключатель реально ушёл; при lab_pll_keep и lab_nv_mux_release не действует. */
+static uint lab_pll_off_in_bracket;
+module_param(lab_pll_off_in_bracket, uint, 0644);
+MODULE_PARM_DESC(lab_pll_off_in_bracket, "LAB: when the GPC leaves its PLL for the divider, disable the PLL (bit 0) inside the bracket right after the mux switch, as NVIDIA 270 (0 off, 1 on)");
+MODULE_PARM_DESC(lab_nv_mux_release, "LAB: release the FSRM slowdown right after the clock mux write and wait for the switch outside it, as NVIDIA (0 off, 1 on)");
+static uint lab_mux_guard = 1;	/* 19.11: по умолчанию как служба (набор 18.11) */
+module_param(lab_mux_guard, uint, 0644);
