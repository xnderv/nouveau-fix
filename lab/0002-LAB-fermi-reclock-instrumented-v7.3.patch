+/* LAB 16.11, этап Б: скобка GPC с переключателем на карте. lab_pmu_bracket_ns = W (0 — выкл.): на смене источника GPC
+ * (подъём делитель -> PLL и спуск PLL -> делитель) процессор только сохраняет состояние замедления и считает значения,
+ * а PMU одним сценарием memx пишет: запрос замедления GPC (те же три записи FSRM) -> пауза W нс по часам карты -> делитель,
+ * если он пишется внутри скобки (спуск: lab_nv_div_late; подъём: lab_gpc_pre405) -> переключатель 0x137100. Дальше всё как
+ * было: процессор ждёт переключатель (тайм-аут, mux_guard) и снимает замедление. Скобка хаба (idx 7) — по-прежнему с
+ * процессора. Если memx недоступен — та же скобка с процессора. W — от последней записи запроса до записи делителя или
+ * переключателя, без задержек PCIe и процессора; нижнего предела нет (0 = сразу). */
+static uint lab_pmu_bracket_ns;
+module_param(lab_pmu_bracket_ns, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_bracket_ns, "LAB: GPC bracket with the clock-source switch executed by the PMU (memx): slowdown request, W ns pause on the card clock, divider, 0x137100 (0 = off, max 20000)");
+
+static uint lab_pmu_ctrl1_first;
+module_param(lab_pmu_ctrl1_first, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_ctrl1_first, "LAB: PMU bracket: the CPU writes CTRL_1 (thermal input bits) BEFORE the slowdown request, as build-1116e did by mistake (0 = PMU writes it right after the request, as the CPU bracket and NVIDIA do)");
+
+static bool
+lab_pmu_br(struct gf100_clk *clk, int idx)
+{
+	return idx == 0 && lab_therm && READ_ONCE(lab_pmu_bracket_ns) && clk->base.subdev.device->pmu;
+}
+
+/* как lab_therm_enter для GPC, но без записей замедления и без ожидания: только сохранить, чтобы lab_therm_leave вернул */
+static void
+lab_therm_enter_pmu(struct gf100_clk *clk, struct lab_therm_save *sv)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+
+	memset(sv, 0, sizeof(*sv));
+	sv->i = 0;
+	sv->ctrl1 = nvkm_rd32(device, 0x020004);
+	sv->f2 = nvkm_rd32(device, 0x020160);
+	sv->f3 = nvkm_rd32(device, 0x020180);
+	sv->f4 = nvkm_rd32(device, 0x0201a0);
+	sv->ns = READ_ONCE(lab_therm_noslow);
+	/* CTRL_1 пишет сценарий PMU — сразу после записей запроса, в том же порядке, что lab_therm_enter (16.11: было с
+	 * процессора ДО запроса — лишнее отличие от скобки с процессора, исправлено). lab_pmu_ctrl1_first=1 возвращает
+	 * ошибочный порядок для сравнения. */
+	if (READ_ONCE(lab_pmu_ctrl1_first))
+		nvkm_wr32(device, 0x020004, sv->ctrl1 & ~READ_ONCE(lab_therm_ctrl1_clr));
+	sv->on = true;
+}
+
+/* LAB 16.11 вечер: подъём и спуск раздельно. lab_pmu_up_ns / lab_pmu_dn_ns: пауза А (запрос -> переключатель) для своего
+ * направления, -1 — как lab_pmu_bracket_ns. lab_pmu_dn_flag=1: на спуске PMU сначала ждёт на карте признак «замедление
+ * действует» (0x0201e0: биты 0–5 = код глубины и бит 17; не дольше 20 мкс), потом пауза lab_pmu_dn_ns (запас после признака,
+ * 0 — без запаса), потом делитель и переключатель. */
+static int lab_pmu_up_ns = -1;
+module_param(lab_pmu_up_ns, int, 0644);
+MODULE_PARM_DESC(lab_pmu_up_ns, "LAB: PMU bracket pause request->switch on the upshift (divider->PLL), ns; -1 = lab_pmu_bracket_ns");
+static int lab_pmu_dn_ns = -1;
+module_param(lab_pmu_dn_ns, int, 0644);
+MODULE_PARM_DESC(lab_pmu_dn_ns, "LAB: PMU bracket pause on the downshift (PLL->divider), ns; with lab_pmu_dn_flag — margin after the engaged flag; -1 = lab_pmu_bracket_ns");
+static uint lab_pmu_up_flag;
+module_param(lab_pmu_up_flag, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_up_flag, "LAB: on the upshift the PMU waits on the card for the slowdown-engaged flag (0x0201e0) before lab_pmu_up_ns (then a margin) and the switch (0 off, 1 on) — 17.11");
+static uint lab_pmu_dn_flag;
+module_param(lab_pmu_dn_flag, uint, 0644);
+MODULE_PARM_DESC(lab_pmu_dn_flag, "LAB: on the downshift the PMU waits on the card for the slowdown-engaged flag (0x0201e0) before the margin and the switch (0 off, 1 on)");
+
+/* сценарий PMU: запрос замедления GPC -> [признак] -> W нс -> (a1 = v1) -> 0x137100 = v100. 0 — выполнен; иначе memx недоступен. */
+static int
+lab_pmu_bracket_run(struct gf100_clk *clk, struct lab_therm_save *sv, u32 a1, u32 v1, u32 v100, const char *what, bool up)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	int wd = up ? READ_ONCE(lab_pmu_up_ns) : READ_ONCE(lab_pmu_dn_ns);
+	u32 code = lab_therm_gpc_code(device);
+	u32 w = min_t(u32, wd >= 0 ? (u32)wd : READ_ONCE(lab_pmu_bracket_ns), 20000);
+	bool flag = (up ? READ_ONCE(lab_pmu_up_flag) : READ_ONCE(lab_pmu_dn_flag)) && !sv->ns;
+	struct nvkm_memx *memx;
+	u64 t0 = ktime_get_ns();
+	int ret = nvkm_memx_init(device->pmu, &memx);
+
+	if (ret) {
+		nvkm_error(&clk->base.subdev, "LAB PMU-скобка GPC %s: memx недоступен (%d) — скобка с процессора\n", what, ret);
+		return ret;
+	}
+	if (!sv->ns) {
+		nvkm_memx_wr32(memx, 0x020160, (code << 16) | 0x80 | code);	/* оба поля, как NVIDIA (17.11) */
+		nvkm_memx_wr32(memx, 0x020180, code);
+		nvkm_memx_wr32(memx, 0x0201a0, 0x00004040);
+	}
+	if (!READ_ONCE(lab_pmu_ctrl1_first))
+		nvkm_memx_wr32(memx, 0x020004, sv->ctrl1 & ~READ_ONCE(lab_therm_ctrl1_clr));	/* как в lab_therm_enter */
+	if (flag)
+		nvkm_memx_wait(memx, 0x0201e0, 0x0002003f, 0x00020000 | (code & 0x3f), 20000);
+	if (w)
+		nvkm_memx_nsec(memx, w);
+	if (a1)
+		nvkm_memx_wr32(memx, a1, v1);
+	nvkm_memx_wr32(memx, 0x137100, v100);
+	nvkm_memx_fini(&memx, true);
+	nvkm_info(&clk->base.subdev, "LAB PMU-скобка GPC %s: замедление /%u.%u, %s%u нс по часам карты, %s%06x = %08x, 0x137100 = %08x; "
+		  "сценарий с ответом %llu нс\n", what, (code + 2) / 2, (code & 1) ? 5 : 0,
+		  flag ? "ждать признак на карте, затем запас " : "пауза ", w,
+		  a1 ? "затем " : "делитель не пишется, ", a1, v1, v100, ktime_get_ns() - t0);
+	return 0;
+}
