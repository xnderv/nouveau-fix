+/* LAB 28.10, опыт Е14: коэффициент замедления в скобке — поле 16–21 FSRM_2 (у NVIDIA для Tegra: therm_clk_slowdown
+ * idle_factor, код = 2·делитель − 2: 1 = /1.5, 2 = /2, 6 = /4, 0xa = /6, 0xe = /8). NVIDIA 390 на GF114 ставит GPC 0xa (/6),
+ * hubk06 0x2 (/2); на GF106 — GPC 0x2. Ключи меняют только код, остальные биты скобки (0x8a / 0x82, FSRM_3, FSRM_4) как были. */
+static uint lab_therm_gpc_factor;	/* 0 = по чипу: GF114 0xa (/6, наша запись), GF106 0x2 (/2, запись rox4d) */
+module_param(lab_therm_gpc_factor, uint, 0644);
+MODULE_PARM_DESC(lab_therm_gpc_factor, "LAB: FSRM slowdown factor code for GPC bracket (bits 16-21): 0 = by chip (GF114 0xa = /6, GF106 2 = /2 as NVIDIA), 0xe = /8");
+/* LAB 02.11: коды замедления в скобке, как их ставит NVIDIA 390, — по чипу, из записей базы (docs/2026-10-29/db-fermi-waits.md,
+ * lab/db-bracket-codes.py). От VBIOS (0x020130, 0x020144) не зависят — проверено подменой 02.11. GF110: 1080/1081 — /2,
+ * остальные — /6. GF108: в записях 2016–2017 GPC /8 (в 2010–2011 было /2). lab_therm_code_nv=0 — прежнее (GF106 /2, иначе /6). */
+/* 25.11: глубина скобки GPC2CLK у NVIDIA задаётся не чипом, а моделью платы (docs/2026-11-25/core-gf108-nvidia.md, раздел 4:
+ * у GF108, GF110 и GF114 по две глубины; в том, что VBIOS пишет в регистры, её нет — перебор по 34 платам), поэтому
+ * таблицу «по чипу» повторить нельзя. lab_therm_code_nv=2 (по умолчанию): одна глубина для всех — GPC2CLK /8 (самая
+ * глубокая из тех, что ставит NVIDIA: ни одна плата не получит замедление слабее, чем у неё), SYS2CLK /2 (как у NVIDIA
