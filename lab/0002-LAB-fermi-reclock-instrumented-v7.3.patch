+			if (g <= 0x3f) {
+				nvkm_wr32(device, 0x137274, (d & ~0x3f) | g);
+				udelay(20);
+				lab_cntr_sys_pass(clk, mask, "copy пост-делитель вдвое глубже");
+				nvkm_wr32(device, 0x137274, d);
+				udelay(20);
+			}
+		}
+		if (sp & 16) {
+			u32 d = nvkm_rd32(device, 0x1371d4), f = d & 0x3f, g = f * 2 + 2;
+
+			if (g <= 0x3f) {
+				nvkm_wr32(device, 0x1371d4, (d & ~0x3f) | g);
+				udelay(20);
+				lab_cntr_sys_pass(clk, mask, "LTC основной делитель вдвое глубже");
+				nvkm_wr32(device, 0x1371d4, d);
+				udelay(20);
+			}
+		}
+		if (sp & 32) {
+			u32 d = nvkm_rd32(device, 0x137184);
+
+			nvkm_wr32(device, 0x137184, (d & ~0xf) | 0x2);
+			udelay(20);
+			lab_cntr_sys_pass(clk, mask, "copy источник делителя = 2");
+			nvkm_wr32(device, 0x137184, d);
+			udelay(20);
+		}
