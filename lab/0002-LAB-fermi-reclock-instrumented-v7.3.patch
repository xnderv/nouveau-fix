+		if ((sp & 1) && !(nvkm_rd32(device, 0x137100) & 0x4)) {
+			u32 d = nvkm_rd32(device, 0x137258), f = d & 0x3f, g = f * 2 + 2;	/* делит (f+2)/2 -> вдвое глубже */
+
+			if (g <= 0x3f) {
+				nvkm_wr32(device, 0x137258, (d & ~0x3f) | g);
