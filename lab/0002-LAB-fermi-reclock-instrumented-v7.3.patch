+MODULE_PARM_DESC(lab_nv_div_same, "LAB: when the GPC leaves its PLL, rewrite its divider with the unchanged value inside the bracket right before the mux (0 off, 1 on)");
+/* LAB 25.10 (тест 53, гипотеза «линии»: делитель при записи выравнивается по черте, длину которой задаёт поле B). Поле B
+ * делителя ядра — заданное значение при каждой записи делителя (0 — выкл., как сейчас: копия поля A). 03 (÷5) — «неправильная»
+ * линия: не делится на 4 и не делит 4; 1e (÷32) — линия NVIDIA. Только ядро (idx 0); у ядра поле B неактивно (0x137160
+ * бит 8 = 0), его такт от поля B не зависит. Важнее lab_nv_divb. */
+static uint lab_divb_force;
+module_param(lab_divb_force, uint, 0644);
+MODULE_PARM_DESC(lab_divb_force, "LAB: write this value into field B of the GPC divider at every divider write (0 off; e.g. 0x03 = /5, 0x1e = /32 as NVIDIA)");
+
+/* LAB: какие узлы программирует gf100_clk_prog (бит = idx); clk/base.c сужает маску для hubk07 вместе с памятью */
+u32 lab_clk_prog_mask = ~0u;
+
+static u32
+lab_override(int idx, u32 freq)
+{
+	uint want = 0, cap = 0;
+	switch (idx) {
+	case 0x00: want = lab_gpc_khz;   cap = 1800000; break;
+	case 0x01: want = lab_rop_khz;   cap = 1907000; break;
+	case 0x02: want = lab_hub07_khz; cap = 1907000; break;
+	case 0x07: want = lab_hub06_khz; cap = 1645000; break;
+	case 0x08: want = lab_hub01_khz; cap = 1645000; break;
+	default: return freq;
+	}
+	/* LAB 23.10: переопределение только для целей выше 500 МГц (уровень 0f); 07/03 (405/50) не трогаем,
+	 * иначе при опыте «подъём до 1000 МГц» уровень 07 тоже стал бы 1000 и переключать было бы нечего. */
+	if (!want || freq <= 500000)
+		return freq;
+	return min(want, cap);
+}
+
+static void
+lab_divb(struct gf100_clk *clk, int idx, int dom)
+{
+	struct gf100_clk_info *info = &clk->eng[idx];
+	struct nvkm_pstate *pstate;
+	u32 low = 0, vco = read_vco(clk, 0x137160 + (idx * 4)), b;
+
+	list_for_each_entry(pstate, &clk->base.states, head) {
+		u32 f = pstate->base.domain[dom];
+
+		if (f && (!low || f < low))
+			low = f;
+	}
+	if (!low || !vco)
+		return;
+	b = clamp_t(u32, DIV_ROUND_CLOSEST(vco * 2, low), 2, 65) - 2;	/* поле f даёт VCO * 2 / (f + 2) */
+	info->ddiv = (info->ddiv & ~0x00003f00) | (b << 8);
+	nvkm_info(&clk->base.subdev, "LAB nv_divb %s: самая низкая частота узла %u кГц -> поле B %02x, ddiv %08x\n",
+		  lab_nn(idx), low, b, info->ddiv);
+}
+
+static void
+lab_divb_force_apply(struct gf100_clk *clk, int idx)
+{
+	struct gf100_clk_info *info = &clk->eng[idx];
+	u32 b = lab_divb_force & 0x3f;
+
+	if (idx != 0 || !b || !(info->ddiv & 0x80000000))
+		return;
+	info->ddiv = (info->ddiv & ~0x00003f00) | (b << 8);
+	nvkm_info(&clk->base.subdev, "LAB divb_force idx 00: поле B -> %02x (÷%u), ddiv %08x\n", b, b + 2, info->ddiv);
+}
+
+/* LAB 30.10 (сверка по базе: 32 платы, 9 чипов Fermi, docs/2026-10-30/db-core-check.md): источник узла — по флагу частоты
+ * в записи уровня VBIOS (биты 14–15 подзаписи; nouveau их отбрасывает): 1 → PLL, 2 → делитель, 0 → делитель, если он в окне
+ * −2…+3 МГц от таблицы (правило nouveau gt215), иначе PLL. Только GPC, ROP, hubk07, hubk06 и hubk01 (он — на PLL hubk06,
+ * если hubk06 на этом уровне на PLL). Основной делитель GPC — на частоту самого высокого уровня на делителях (у нас
+ * 07 = 810, у GF108 405, у GF119 540), ниже — пост-делителем от него; если так не попасть в окно — обычный путь nouveau.
+ * Коэффициенты PLL GPC — из равноценных решений наибольшее M, как NVIDIA 304+ / 390 (у ROP, hubk07, hubk06 — как nouveau).
+ * На нашей плате значения те же, что с lab_gpc_div=1; lab_gpc_div при включённом ключе не действует. */
+static uint lab_vbios_src = 1;	/* 19.11: по умолчанию как служба (набор 18.11) */
+module_param(lab_vbios_src, uint, 0644);
+MODULE_PARM_DESC(lab_vbios_src, "LAB: node source from the VBIOS perf-entry flag (bits 14-15: 1 PLL, 2 divider, 0 divider within -2..+3 MHz else PLL), GPC main divider on the highest divider level (0 off, 1 on)");
+
+static struct nvkm_pstate *
+lab_cstate_pstate(struct gf100_clk *clk, struct nvkm_cstate *cstate)
+{
+	struct nvkm_pstate *pstate;
+	struct nvkm_cstate *c;
+
+	list_for_each_entry(pstate, &clk->base.states, head) {
+		if (&pstate->base == cstate)
+			return pstate;
+		list_for_each_entry(c, &pstate->list, head) {
+			if (c == cstate)
+				return pstate;
+		}
+	}
+	return NULL;
+}
+
+/* флаг частоты узла dom на уровне level (биты 14–15 подзаписи); -1 — нет таблицы, уровня или подзаписи */
+static int
+lab_perf_flag(struct gf100_clk *clk, u8 level, int dom)
+{
+	struct nvkm_bios *bios = clk->base.subdev.device->bios;
+	const struct nvkm_domain *d;
+	struct nvbios_perfE perfE;
+	u8 ver, hdr, cnt, len, sver, shdr;
+	u32 data, sdata;
+	int i = 0;
+
+	for (d = clk->base.domains; d->name != nv_clk_src_max; d++) {
+		if (d->name == dom)
+			break;
+	}
+	if (d->name == nv_clk_src_max || d->bios == 0xff)
+		return -1;
+	while ((data = nvbios_perfEp(bios, i++, &ver, &hdr, &cnt, &len, &perfE))) {
+		if (perfE.pstate != level)
+			continue;
+		sver = ver;
+		shdr = hdr;
+		sdata = nvbios_perfSe(bios, data, d->bios, &sver, &shdr, cnt, len);
+		if (ver != 0x40 || !sdata)
+			return -1;
+		return nvbios_rd16(bios, sdata) >> 14;
+	}
+	return -1;
+}
+
+static bool
+lab_in_window(u32 want, u32 got)
+{
+	int diff = (int)want - (int)got;
+
+	return diff >= -2000 && diff < 3000;
+}
+
+/* частота GPC самого высокого уровня, который идёт на делителе (флаг 2, или 0 и делитель в окне) — на неё ставится
+ * основной делитель GPC; 0 — такого уровня нет */
+static u32
+lab_gpc_base(struct gf100_clk *clk, int dom, u32 vco)
+{
+	struct nvkm_pstate *pstate;
+	u32 base = 0, div;
+
+	list_for_each_entry(pstate, &clk->base.states, head) {
+		u32 f = pstate->base.domain[dom];
+		int flag;
+
+		if (!f || f > vco || f <= base)
+			continue;
+		flag = lab_perf_flag(clk, pstate->pstate, dom);
+		if (flag == 2 || (flag == 0 && lab_in_window(f, calc_div(clk, 0, vco, f, &div))))
+			base = f;
+	}
+	return base;
+}
+
+/* LAB 30.10: как gt215_pll_calc, но из равноценных решений берёт наибольшее M — так PLL GPC считает NVIDIA 304+ / 390
+ * (сверка по базе с эпохой по независимым признакам: 18 из 18 записей 304+; в 270.x и у ROP/hubk07 — наименьшее M, как
+ * nouveau). Частота у обоих вариантов одна. */
+static int
+lab_pll_calc_maxm(struct nvbios_pll *info, u32 freq, int *pN, int *pM, int *pP)
+{
+	u32 best_err = ~0, err;
+	int M, lM, hM, N, P;
+
+	P = info->vco1.max_freq / freq;
+	if (P > info->max_p)
+		P = info->max_p;
+	if (P < info->min_p)
+		P = info->min_p;
+
+	lM = (info->refclk + info->vco1.max_inputfreq) / info->vco1.max_inputfreq;
+	lM = max(lM, (int)info->vco1.min_m);
+	hM = (info->refclk + info->vco1.min_inputfreq) / info->vco1.min_inputfreq;
+	hM = min(hM, (int)info->vco1.max_m);
+	lM = min(lM, hM);
+
+	for (M = lM; M <= hM; M++) {
+		u32 tmp = freq * P * M;
+
+		N = tmp / info->refclk;
+		if (tmp % info->refclk >= info->refclk / 2)
+			N++;
+		if (N < info->vco1.min_n)
+			continue;
+		if (N > info->vco1.max_n)
+			break;
+
+		err = abs(freq - (info->refclk * N / M / P));
+		if (err <= best_err) {		/* <=: из равных остаётся последнее, то есть наибольшее M */
+			best_err = err;
+			*pN = N;
+			*pM = M;
+		}
+	}
+
+	if (best_err == ~0)
+		return -EINVAL;
+	*pP = P;
+	return info->refclk * *pN / *pM / P;
+}
+
+static u32
+lab_calc_pll_gpc(struct gf100_clk *clk, u32 freq, u32 *coef)
+{
+	struct nvkm_bios *bios = clk->base.subdev.device->bios;
+	struct nvbios_pll limits;
+	int N, M, P, ret;
+
+	if (nvbios_pll_parse(bios, 0x137000, &limits))
+		return 0;
+	limits.refclk = read_div(clk, 0, 0x137120, 0x137140);
+	if (!limits.refclk)
+		return 0;
+	ret = lab_pll_calc_maxm(&limits, freq, &N, &M, &P);
+	if (ret <= 0)
+		return 0;
+	*coef = (P << 16) | (N << 8) | M;
+	return ret;
+}
+
+/* идёт ли hubk06 на этом уровне на PLL по тому же правилу (флаг 1, или 0 и делитель не в окне) — тогда hubk01 может ехать
+ * на его PLL (GF117 у4: у hubk06 флаг 0, 1100 делителем не достать — NVIDIA ставит обоих на PLL) */
+static bool
+lab_hub06_pll(struct gf100_clk *clk, struct nvkm_cstate *cstate, u8 level)
+{
+	int flag = lab_perf_flag(clk, level, nv_clk_src_hubk06);
+	u32 f = cstate->domain[nv_clk_src_hubk06], div;
+
+	if (flag == 1)
+		return true;
+	return flag == 0 && f && !lab_in_window(f, calc_div(clk, 7, read_vco(clk, 0x137160 + (7 * 4)), f, &div));
+}
+
+/* LAB 21.11: ОДИН допуск попадания в частоту VBIOS на все узлы, все правила и самопроверку — ±2 %, симметрично. Обоснование
+ * (docs/2026-11-21/vbios-hit.md): перебор всех известных источников и делителей по 470 образам Fermi (12551 пара узел-уровень)
+ * — 99,97 % попадают в ±1 %, ещё 4 — в 1,57 %; дальше разрыв до 3,45 % (2 случая на 470 образов, противоречия в самих VBIOS).
+ * Любой порог в 1,6…3,4 % делит одинаково; 2 % — с запасом над 1,57 %. lab_in_window (−3…+2 МГц) — не допуск, а распознавание
+ * «VBIOS записал частоту делителя целыми МГц» (выбор пути при флаге 0), остаётся. */
+static bool
+lab_hit(u32 want, u32 got)
+{
+	return got && got + want / 50 >= want && got <= want + want / 50;
+}
+
+/* исходный источник HUB2CLK (0x137180) после init-скрипта VBIOS. 24.11: подвыбор 7 в битах 24–26 при загрузке — НЕ признак
+ * провода к PLL XBAR2CLK: из 39 образов GF108 его ставят 32, а у семи остальных (в том числе GT 630M тестировщика) число хаба
+ * тоже равно числу XBAR2CLK и делителем не достижимо, и NVIDIA на GT 630M сама включает этот путь (lab/vbios-hub-alt.py,
+ * docs/2026-11-24/hub-alt.md). Значение остаётся в журнале и для режима lab_hub01_alt=2. */
+static u32 lab_hub_src_boot;
+
+/* LAB 20.11 (docs/2026-11-20/hub2clk-gf108.md): HUB2CLK (idx 8) от PLL XBAR2CLK — «код 2, подвыбор 7» в 0x137180, как NVIDIA
+ * на GF108 (записи 4 из 4). Решение — без списка чипов: по таблице VBIOS (у HUB2CLK флаг «делитель», делитель не даёт частоту,
+ * XBAR2CLK на этом уровне просит ту же частоту и идёт на своей PLL) и по САМОПРОВЕРКЕ: после переключения HUB2CLK меряется
+ * счётчиком 0x1373b0 (источник 1); не совпало в пределах 2 % — откат на делитель (правило «не выше VBIOS») и отказ от
+ * обходного пути до перезагрузки. Без счётчика обходной путь не включается.
+ * lab_hub01_alt: 1 — пробовать всякий раз, когда правило не попадает в число VBIOS, а число XBAR2CLK попадает (по умолчанию,
+ * с 24.11); 2 — только если VBIOS при загрузке поставил подвыбор 7 (как было до 24.11); 0 — выключено.
+ * lab_hub01_alt_force=1 — ОПЫТ: на ближайшем уровне без PLL у HUB2CLK попробовать обходной путь принудительно (цель —
+ * текущая частота HUB2CLK, пост-делитель — чтобы не выше неё). */
+static uint lab_hub01_alt = 1;
+module_param(lab_hub01_alt, uint, 0644);
+MODULE_PARM_DESC(lab_hub01_alt, "LAB: HUB2CLK from the XBAR2CLK PLL (source code 2, sub-select 7) when no other route hits the VBIOS number, with a counter self-check: 1 try (default), 2 only if the VBIOS selected sub-select 7 at boot (as before 24.11), 0 off");
+static uint lab_hub01_alt_force;
+module_param(lab_hub01_alt_force, uint, 0644);
+MODULE_PARM_DESC(lab_hub01_alt_force, "LAB experiment: force one HUB2CLK alternative-source attempt (with self-check and fallback) at the next level where HUB2CLK is not on a PLL; resets to 0");
+static int lab_hub01_alt_bad;		/* самопроверка не прошла — до перезагрузки не пробовать */
+module_param(lab_hub01_alt_bad, int, 0444);
+static u32 lab_hub01_alt_want;		/* цель (кГц), выставляет calc; 0 — не нужно */
+static bool lab_hub01_alt_on;		/* сейчас HUB2CLK на обходном пути */
+static u32 lab_hub01_alt_src0, lab_hub01_alt_post0;	/* что было до переключения */
+
+/* LAB 25.11: HUB2CLK — ведомый узел: своей PLL у него нет, он берёт PLL узла SYS2CLK (бит 8 переключателя) или PLL узла
+ * XBAR2CLK (обходной путь выше). Во всех записях NVIDIA всех чипов Fermi (42 записи базы и пять плат тестировщиков,
+ * docs/2026-11-25/core-gf108-nvidia.md, раздел 2) HUB2CLK переводится после своего ведущего и раньше GPC2CLK. Когда ведущий —
+ * SYS2CLK, обычный порядок (7 8 0 1 2) это уже выполняет. Когда ведущий — XBAR2CLK, до 25.11 HUB2CLK переводился последним,
+ * после GPC2CLK. lab_hub_follow=1: в этом случае подъём идёт SYS2CLK, XBAR2CLK, HUB2CLK, GPC2CLK, спуск — GPC2CLK, HUB2CLK,
+ * XBAR2CLK, SYS2CLK (так у NVIDIA на 7 платах GF108 из 7 с этим путём). Действует, только когда ядро и XBAR2CLK
+ * программируются одним вызовом (lab_nv_xbarmem = 1 или правило топологии «шина снаружи памяти»); иначе — как раньше.
+ * 0 — как до 25.11. На плате без обходного пути ключ ничего не меняет.
+ * 26.11: по умолчанию пока 0 — правило ещё ни разу не исполнялось на железе (на нашей GF114 обходного пути нет), а сборка
+ * 26.11 выходит к тестировщикам с одним изменением — генератором скриптов памяти DDR3. Включается ключом; по умолчанию
+ * станет 1 после первого прогона на плате GF108. */
+static uint lab_hub_follow;
+module_param(lab_hub_follow, uint, 0644);
+MODULE_PARM_DESC(lab_hub_follow, "LAB: HUB2CLK is switched right after the node whose PLL feeds it and before GPC2CLK (1; default 0 until it has run on hardware). Only matters where HUB2CLK runs from the XBAR2CLK PLL: order SYS2CLK, XBAR2CLK, HUB2CLK, GPC2CLK on the way up and the reverse on the way down; 0 = as before 25.11 (HUB2CLK last)");
+
+static u32 lab_meas_khz(struct nvkm_device *device, u32 base, u32 src);
+
+static void
+lab_hub01_alt_apply(struct gf100_clk *clk)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	bool force = READ_ONCE(lab_hub01_alt_force);
+	u32 want = force ? (u32)max(read_clk(clk, 0x08), 0) : lab_hub01_alt_want;
+	u32 src0, post0, xbar, a, expect, got, cnt;
+
+	lab_hub01_alt_want = 0;
+	if (!want || lab_hub01_alt_on || (!force && (!READ_ONCE(lab_hub01_alt) || lab_hub01_alt_bad)))
+		return;
+	if (nvkm_rd32(device, 0x137100) & 0x100)			/* HUB2CLK на PLL — не наш случай */
+		return;
+	if (force)
+		WRITE_ONCE(lab_hub01_alt_force, 0);
+	xbar = read_pll(clk, 0x137040);
+	cnt = nvkm_rd32(device, 0x1373b0);
+	if (!xbar || (cnt & 0xfff00000) == 0xbad00000) {
+		nvkm_info(&clk->base.subdev, "LAB hub01-alt: %s — обходной путь не включаю\n",
+			  !xbar ? "PLL XBAR2CLK не работает" : "счётчика тактов нет — проверить нельзя");
+		return;
+	}
+	for (a = 0; a < 63 && (xbar * 2) / (a + 2) > want + want / 50; a++)
+		;
+	expect = (xbar * 2) / (a + 2);
+	src0 = nvkm_rd32(device, 0x137180);
+	post0 = nvkm_rd32(device, 0x137270);
+	/* туда без выброса вверх: сначала источник (с прежним делителем частота не выше), потом делитель */
+	nvkm_wr32(device, 0x137180, (src0 & ~0x07000103) | 0x07000002);
+	udelay(5);
+	nvkm_wr32(device, 0x137270, (post0 & ~0x3f) | 0x80000000 | a);
+	udelay(20);
+	got = lab_meas_khz(device, 0x1373b0, 1);
+	if (lab_hit(expect, got)) {
+		lab_hub01_alt_on = true;
+		lab_hub01_alt_src0 = src0;
+		lab_hub01_alt_post0 = post0;
+		nvkm_info(&clk->base.subdev, "LAB hub01-alt: HUB2CLK от PLL XBAR2CLK (%u кГц, пост-делитель A %u): ждали %u, счётчик %u — оставляю%s\n",
+			  xbar, a, expect, got, force ? " (опыт: сразу возвращаю)" : "");
+		if (!force)
+			return;
+	} else {
+		lab_hub01_alt_bad = 1;
+		nvkm_info(&clk->base.subdev, "LAB hub01-alt: ждали %u кГц, счётчик %u — пути «код 2/подвыбор 7 → PLL XBAR2CLK» на этом чипе нет; откат, до перезагрузки не пробую\n",
+			  expect, got);
+	}
+	/* обратно без выброса: сначала делитель, потом источник */
+	nvkm_wr32(device, 0x137270, post0);
+	udelay(5);
+	nvkm_wr32(device, 0x137180, src0);
+	lab_hub01_alt_on = false;
+	nvkm_info(&clk->base.subdev, "LAB hub01-alt: вернул 0x137180 %08x, 0x137270 %08x; HUB2CLK %u кГц\n",
+		  nvkm_rd32(device, 0x137180), nvkm_rd32(device, 0x137270), lab_meas_khz(device, 0x1373b0, 1));
+}
+
+/* перед любой сменой уровня — HUB2CLK с обходного пути обратно (без выброса: делитель, потом источник) */
+static void
+lab_hub01_alt_leave(struct gf100_clk *clk)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+
+	if (!lab_hub01_alt_on)
+		return;
+	nvkm_wr32(device, 0x137270, lab_hub01_alt_post0);
+	udelay(5);
+	nvkm_wr32(device, 0x137180, lab_hub01_alt_src0);
+	lab_hub01_alt_on = false;
+	nvkm_info(&clk->base.subdev, "LAB hub01-alt: перед сменой уровня HUB2CLK возвращён на делитель (0x137180 %08x)\n", lab_hub01_alt_src0);
+}
+
+static int
+lab_calc_vbios(struct gf100_clk *clk, struct nvkm_cstate *cstate, int idx, int dom, u32 freq, u8 level, int flag)
