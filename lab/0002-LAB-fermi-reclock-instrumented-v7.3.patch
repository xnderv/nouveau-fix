+static uint lab_therm_code_nv = 1;
+module_param(lab_therm_code_nv, uint, 0644);
+MODULE_PARM_DESC(lab_therm_code_nv, "LAB: slowdown depth in the clock-switch bracket: 2 = one depth for every chip, GPC2CLK /8 and SYS2CLK /2; 1 = per-chip table from NVIDIA traces (default, as before 25.11); 0 = old (GF106 /2, else /6)");
+static u32
+lab_therm_code_tab(struct nvkm_device *device, int gpc)
+{
+	switch (device->chipset) {
+	case 0xc0: return 0xe;					/* GF100: /8 и GPC, и hub */
+	case 0xc1: return gpc ? 0xe : 0x2;			/* GF108: GPC /8, hub /2 */
+	case 0xc3: case 0xc4: case 0xd9: case 0xd7: return 0x2;	/* GF106, GF104, GF119, GF117: /2 */
+	case 0xc8:						/* GF110: 1080/1081 — /2, иначе GPC /6 */
+		if (!gpc)
+			return 0x2;
+		return (device->pci && (device->pci->pdev->device == 0x1080 ||
+					device->pci->pdev->device == 0x1081)) ? 0x2 : 0xa;
+	default: return gpc ? 0xa : 0x2;			/* GF114, GF116: GPC /6, hub /2 */
+	}
+}
+static u32
+lab_therm_gpc_code(struct nvkm_device *device)
+{
+	if (lab_therm_gpc_factor)
+		return lab_therm_gpc_factor & 0x3f;
+	if (READ_ONCE(lab_therm_code_nv) == 2)
+		return 0xe;
+	if (READ_ONCE(lab_therm_code_nv))
+		return lab_therm_code_tab(device, 1);
+	return (device->chipset == 0xc3) ? 0x2 : 0xa;
+}
+static uint lab_therm_hub_factor = 0x2;
+module_param(lab_therm_hub_factor, uint, 0644);
+MODULE_PARM_DESC(lab_therm_hub_factor, "LAB: FSRM slowdown factor code for hubk06 bracket (bits 16-21; 2 = /2 as NVIDIA)");
+static u32
+lab_therm_hub_code(struct nvkm_device *device)
+{
+	if (READ_ONCE(lab_therm_code_nv) == 1 && lab_therm_hub_factor == 0x2)
+		return lab_therm_code_tab(device, 0);
+	return lab_therm_hub_factor & 0x3f;
+}
