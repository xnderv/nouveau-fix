+module_param(lab_therm_ctrl1_clr, uint, 0644);
+MODULE_PARM_DESC(lab_therm_ctrl1_clr, "LAB: bits of PTHERM CTRL_1 (0x020004) cleared during the FSRM bracket (default 0x1ff = every set low bit, as NVIDIA; 0 = leave CTRL_1)");
+static uint lab_therm_noslow;
+module_param(lab_therm_noslow, uint, 0644);
+MODULE_PARM_DESC(lab_therm_noslow, "LAB: bracket without the slowdown itself: do not write FSRM_2/3/4, only the CTRL_1 change (0 off, 1 on)");
+static uint lab_therm_fixed_floor_ns = 2000;
+module_param(lab_therm_fixed_floor_ns, uint, 0644);
+MODULE_PARM_DESC(lab_therm_fixed_floor_ns, "LAB: lower clamp for lab_therm_fixed_ns / lab_therm_fixed_hub_ns, ns (default 2000 = not before the engaged flag; 0 = no floor, risky)");
