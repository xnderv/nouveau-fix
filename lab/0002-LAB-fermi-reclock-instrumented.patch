+static void
+lab_therm_enter(struct gf100_clk *clk, int idx, struct lab_therm_save *sv)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 e2, e3;
+
+	sv->on = false;
+	if (!lab_therm || (idx != 0 && idx != 7))
+		return;
+	sv->i = (idx == 0) ? 0 : 1;
+	e2 = (idx == 0) ? ((lab_therm_gpc_code(device) << 16) | 0x0000008a)
+			: (((lab_therm_hub_factor & 0x3f) << 16) | 0x00000082);
+	e3 = (idx == 0) ? lab_therm_gpc_code(device) : (lab_therm_hub_factor & 0x3f);
+	sv->ctrl1 = nvkm_rd32(device, 0x020004);
+	sv->f2 = nvkm_rd32(device, 0x020160 + sv->i * 4);
+	sv->f3 = nvkm_rd32(device, 0x020180 + sv->i * 4);
+	sv->f4 = nvkm_rd32(device, 0x0201a0 + sv->i * 4);
+	nvkm_wr32(device, 0x020160 + sv->i * 4, e2);
+	nvkm_wr32(device, 0x020180 + sv->i * 4, e3);
+	nvkm_wr32(device, 0x0201a0 + sv->i * 4, 0x00004040);
+	nvkm_wr32(device, 0x020004, sv->ctrl1 & ~0x00000068);
+	sv->on = true;
+	sv->us = (idx == 0 && lab_therm_us_gpc) ? lab_therm_us_gpc :
+		 (idx == 7 && lab_therm_us_hub) ? lab_therm_us_hub : lab_therm_us;
+	sv->np = 0;
+	sv->nrd = 0;
+	sv->w = false;
+	sv->fx = false;
+	if ((idx == 0 && lab_therm_fixed_ns) || (idx == 7 && lab_therm_fixed_hub_ns)) {
+		u32 want = 0x00020000 | (e3 & 0x3f);
+		u32 set = clamp_t(u32, idx == 0 ? READ_ONCE(lab_therm_fixed_ns) : READ_ONCE(lab_therm_fixed_hub_ns),
+				  min_t(u32, READ_ONCE(lab_therm_fixed_floor_ns), 50000), 50000);
+		u64 t0 = ktime_get_ns(), dt;
+		u32 v;
+
+		sv->fx = true;
+		sv->fxok = false;
+		sv->fxset = set;
+		sv->fxflag = 0;
+		do {
+			v = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+			dt = ktime_get_ns() - t0;
+			if (!sv->fxok && (v & 0x0002003f) == want) {
+				sv->fxok = true;
+				sv->fxflag = (u32)dt;
+			}
+		} while (dt < set);
+		sv->fxns = (u32)dt;
+	} else if (lab_therm_wait) {
+		u32 want = 0x00020000 | (e3 & 0x3f);
+		u64 t0 = ktime_get_ns(), dt;
+		u32 v;
+
+		sv->w = true;
+		sv->wok = false;
+		sv->wrd = 0;
+		do {
+			v = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+			sv->wrd++;
+			dt = ktime_get_ns() - t0;
+			if ((v & 0x0002003f) == want) {
+				sv->wok = true;
+				break;
+			}
+		} while (dt < 100000ULL);
+		sv->wns = (u32)dt;
+		sv->wv = v;
+		if (lab_therm_wait_us)
+			udelay(lab_therm_wait_us);
+	} else if (lab_therm_probe) {
+		u64 t0 = ktime_get_ns(), lim = (u64)sv->us * 1000ULL, dt;
+		u32 last, v;
+
+		sv->st0 = last = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+		do {
+			v = nvkm_rd32(device, 0x0201e0 + sv->i * 4);
+			sv->nrd++;
+			dt = ktime_get_ns() - t0;
+			if (v != last && sv->np < 8) {
+				sv->pv[sv->np] = v;
+				sv->pt[sv->np] = (u32)dt;
+				sv->np++;
+				last = v;
+			}
+		} while (dt < lim);
+	} else if (sv->us) {
+		udelay(sv->us);
+	}
+}
