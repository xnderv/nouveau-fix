+struct lab_therm_save {
+	bool on; int i; u32 ctrl1, f2, f3, f4;
+	uint us; int np; u32 st0; u32 pv[8]; u32 pt[8]; u32 nrd;
+	bool w; bool wok; u32 wns, wv, wrd;
+	bool fx; bool fxok; u32 fxset, fxns, fxflag;	/* 29.10: фиксированное ожидание от входа */
+};
