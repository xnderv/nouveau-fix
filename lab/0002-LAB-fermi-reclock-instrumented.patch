+static int
+lab_interp(struct nvkm_subdev *subdev, struct nvkm_memx *memx, const struct lab_step *st,
+	   bool build, u32 *words)
+{
+	struct lab_est e = {};
+	u32 waddr = 0, wval = 0, i = 0, nwr = 0, nwait = 0, ndel = 0, nskip = 0;
+	bool blocked = false;
+
+	while (i < st->nscr) {
+		u32 h = st->scr[i], n = h >> 16, op = h & 0xffff, k;
+		const u32 *a = &st->scr[i + 1];
+
+		if (n == 0 || i + n > st->nscr) {
+			nvkm_error(subdev, "LAB replay %s: сбой разбора на слове %u (%08x)\n", st->name, i, h);
+			return -EINVAL;
+		}
+		switch (op) {
+		case 0x21:
+			for (k = 0; k + 1 < n - 1; k += 2) {
+				u32 addr = a[k], data = a[k + 1];
+
+				if (addr == 0x611200)
+					data = lab_611200_val(data);
+				if (build)
+					nvkm_memx_wr32(memx, addr, data);
+				lab_est_cmd(&e, 3, 2);
+				nwr++;
+			}
+			break;
+		case 0x2e:
+			if (build)
+				nvkm_memx_nsec(memx, a[0]);
+			lab_est_cmd(&e, 5, 1);
+			ndel++;
+			break;
+		case 0x13:	/* только в шаге E, аргумент 1000; смысл не известен — берём ДЛИННУЮ паузу (мкс) */
+			if (build)
+				nvkm_memx_nsec(memx, a[0] * lab_mem_op13);
+			lab_est_cmd(&e, 5, 1);
+			ndel++;
+			break;
+		case 0x00:
+			wval = a[0];
+			break;
+		case 0x01:
+			waddr = a[0];
+			break;
+		case 0x15:
+			if (build)
+				nvkm_memx_wait(memx, waddr, a[0], wval, a[1]);
+			lab_est_cmd(&e, 4, 4);
+			nwait++;
+			break;
+		case 0x14:
+			if (a[0] == 0) {	/* одно ожидание кадра на пару NVIDIA (голова 0 + голова 1) */
+				if (build)
+					nvkm_memx_wait_vblank(memx);
+				lab_est_cmd(&e, 6, 1);
+				e.total += 1 + e.sz;
+				e.m = 0;
+				e.sz = 0;
+			}
+			break;
+		case 0x20:
+			if (a[0] == 1 && !blocked) {
+				if (build)
+					nvkm_memx_block(memx);
+				lab_est_cmd(&e, 1, 0);
+				blocked = true;
+			} else if (a[0] == 0 && blocked) {
+				if (build)
+					nvkm_memx_unblock(memx);
+				lab_est_cmd(&e, 2, 0);
+				blocked = false;
+			}
+			break;
+		case 0x16:
+			i = st->nscr;
+			continue;
+		case 0x34:
+			if (lab_mem_op34 && a[0] == 0x0a) {
+				if (build)
+					nvkm_memx_wait(memx, 0x611200, 0x00000003, 0x00000000, 2000000);
+				lab_est_cmd(&e, 4, 4);
+				nwait++;
+				break;
+			}
+			nskip++;
+			break;
+		case 0x3a:
+			if (lab_mem_op3a) {
+				if (build)
+					nvkm_memx_wait(memx, 0x13d8f4, lab_mem_op3a >= 2 ? 0xffffffff : 0x00000000, 0x00000000, 1000000);
+				lab_est_cmd(&e, 4, 4);
+				nwait++;
+				break;
+			}
+			nskip++;
+			break;
+		case 0x39:
+			nskip++;
+			break;
+		default:
+			nvkm_error(subdev, "LAB replay %s: неизвестная операция %04x\n", st->name, op);
+			return -EINVAL;
+		}
+		i += n;
+	}
+	if (blocked) {
+		nvkm_error(subdev, "LAB replay %s: скрипт не снимает останов видеопамяти\n", st->name);
+		return -EINVAL;
+	}
+	if (e.m)
+		e.total += 1 + e.sz;
+	*words = e.total;
+	if (build)
+		nvkm_info(subdev, "LAB replay %s: в memx %u записей, %u ожиданий, %u пауз, пропущено %u операций, ~%u слов\n",
+			  st->name, nwr, nwait, ndel, nskip, e.total);
+	return 0;
+}
+
+static int
+lab_replay_calc(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct lab_step *st;
+	u32 words;
+	int ret, i;
+
+	if (lab_plan_i >= lab_plan_n) {
+		int cur = lab_cur_mhz(device), t = freq / 1000, tgt;
+
+		lab_plan_n = lab_plan_i = 0;
+		tgt = (t <= 200) ? 135 : (t < 1000) ? 324 : 2004;
+		if (abs(t - tgt) > 5) {
+			nvkm_error(subdev, "LAB replay: цель %d МГц не из записи (135/324/2004)\n", t);
+			return -EINVAL;
+		}
+		if (cur == 135 && tgt == 324) {
+			lab_plan[lab_plan_n++] = LAB_S_A;
+		} else if (cur == 324 && tgt == 2004) {
+			lab_plan[lab_plan_n++] = LAB_S_B;
+		} else if (cur == 135 && tgt == 2004) {
+			lab_plan[lab_plan_n++] = LAB_S_A;
+			lab_plan[lab_plan_n++] = LAB_S_B;
+		} else if (cur == 2004 && tgt == 324) {
+			lab_plan[lab_plan_n++] = LAB_S_C;
+			lab_plan[lab_plan_n++] = LAB_S_DC;
+		} else if (cur == 324 && tgt == 135) {
+			lab_plan[lab_plan_n++] = LAB_S_D;
+			lab_plan[lab_plan_n++] = LAB_S_E;
+		} else if (cur == 2004 && tgt == 135) {
+			lab_plan[lab_plan_n++] = LAB_S_C;
+			lab_plan[lab_plan_n++] = LAB_S_DC;
+			lab_plan[lab_plan_n++] = LAB_S_D;
+			lab_plan[lab_plan_n++] = LAB_S_E;
+		} else if (cur != tgt) {
+			nvkm_error(subdev, "LAB replay: нет пути %d -> %d МГц\n", cur, tgt);
+			return -EINVAL;
+		}
+		nvkm_info(subdev, "LAB replay: память сейчас %d МГц, цель %d МГц, шагов %d (lab_mem_replay=%u)\n",
+			  cur, tgt, lab_plan_n, lab_mem_replay);
+		for (i = 0; i < lab_plan_n; i++) {
+			const struct lab_step *s = &lab_steps[lab_plan[i]];
+
+			if (!(lab_mem_replay & s->need)) {
+				nvkm_error(subdev, "LAB replay: шаг %s не разрешён (нужен бит %u) — память не трогаю\n",
+					   s->name, s->need);
+				lab_plan_n = 0;
+				return -EINVAL;
+			}
+			ret = lab_interp(subdev, NULL, s, false, &words);
+			if (ret || words > 480) {
+				nvkm_error(subdev, "LAB replay: шаг %s не годится (ret %d, %u слов memx)\n",
+					   s->name, ret, words);
+				lab_plan_n = 0;
+				return ret ? ret : -E2BIG;
+			}
+		}
+		if (!lab_plan_n)
+			return 0;	/* уже на месте: prog ничего не делает */
+	}
+
+	st = &lab_steps[lab_plan[lab_plan_i]];
+	lab_rp611 = nvkm_rd32(device, 0x611200);
+	ret = ram_init(&ram->fuc, ram->base.fb);
+	if (ret) {
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	ret = lab_interp(subdev, ram->fuc.base.memx, st, true, &words);
+	if (ret) {
+		ram_exec(&ram->fuc, false);
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	lab_armed = true;
+	return 0;
+}
+
+static void
+lab_host_writes(struct nvkm_subdev *subdev, const char *what, const u32 *l, int n)
+{
+	struct nvkm_device *device = subdev->device;
+	int i, cnt = 0;
+
+	for (i = 0; i + 1 < n; i += 2) {
+		if (l[i] == 0x00e104 && !(lab_mem_replay & 16))
+			continue;
+		nvkm_wr32(device, l[i], l[i + 1]);
+		cnt++;
+	}
+	if (n)
+		nvkm_info(subdev, "LAB replay: прямых записей %s: %d\n", what, cnt);
+}
+
+static int
+lab_replay_prog(struct gf100_ram *ram)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct lab_step *st;
+	ktime_t t0;
+	s64 us;
+	int ret;
+
+	if (!lab_armed)
+		return 0;
+	st = &lab_steps[lab_plan[lab_plan_i]];
+	lab_host_writes(subdev, "до скрипта", st->pre, st->npre);
+	t0 = ktime_get();
+	ret = ram_exec(&ram->fuc, true);
+	us = ktime_us_delta(ktime_get(), t0);
+	lab_armed = false;
+	nvkm_info(subdev, "LAB replay %s: выполнен за %lld мкс (op13×%u op34=%u op3a=%u), ret %d; 0x137310=%08x 0x1373f0=%08x 0x132000=%08x 0x10f290=%08x 0x10f300=%08x 0x611200=%08x\n",
+		  st->name, us, lab_mem_op13, lab_mem_op34, lab_mem_op3a, ret, nvkm_rd32(device, 0x137310), nvkm_rd32(device, 0x1373f0),
+		  nvkm_rd32(device, 0x132000), nvkm_rd32(device, 0x10f290),
+		  nvkm_rd32(device, 0x10f300), nvkm_rd32(device, 0x611200));
+	lab_host_writes(subdev, "после скрипта", st->post, st->npost);
+	if (ret < 0) {
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	if (++lab_plan_i < lab_plan_n)
+		return 1;	/* ещё шаг: nouveau снова вызовет calc/prog */
+	lab_plan_n = lab_plan_i = 0;
+	return 0;
+}
