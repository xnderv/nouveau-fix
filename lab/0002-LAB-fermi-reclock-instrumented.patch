+module_param(lab_therm_hub_factor, uint, 0644);
+MODULE_PARM_DESC(lab_therm_hub_factor, "LAB: FSRM slowdown factor code for hubk06 bracket (bits 16-21; 2 = /2 as NVIDIA)");
