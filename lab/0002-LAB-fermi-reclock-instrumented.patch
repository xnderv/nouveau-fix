+/* LAB: опыт с PLL ядра (idx 0). У ядра, в отличие от ROP/hub, BIOS оставляет два бита,
+ * о которых nouveau не знает: 0x137120 бит 0x1000 (источник опоры PLL) и 0x137008 бит 0x200000.
+ * lab_gpc_fix: бит0 — снять 0x1000 в 0x137120; бит1 — снять 0x200000 в 0x137008;
+ *   бит2 — снять 0x1000 в 0x137120 ПОСЛЕ того, как ядро уже переключено на PLL (prog_3).
+ * 0 — вернуть исходные значения (если меняли). Применяется, пока PLL ядра выключен (prog_2). */
+static uint lab_gpc_fix;
+module_param(lab_gpc_fix, uint, 0644);
+MODULE_PARM_DESC(lab_gpc_fix, "LAB: gpc PLL experiment: bit0 clear 0x137120[12], bit1 clear 0x137008[21], 0 restore");
+static bool lab_gpc_saved;
