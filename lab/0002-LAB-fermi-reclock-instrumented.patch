+{
+	struct nvkm_subdev *subdev = &clk->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_bios *bios = device->bios;
+	struct nvbios_perfE perfE;
+	u8 ver, hdr, cnt, len;
+	u32 data, was;
+	int i;
+
+	for (i = 0; (data = nvbios_perfEp(bios, i, &ver, &hdr, &cnt, &len, &perfE)); i++) {
+		if (perfE.pstate != pstate->pstate)
+			continue;
+		if (ver != 0x40 || hdr <= 0x0c) {
+			nvkm_info(subdev, "LAB nv_22680: таблица VBIOS версии %02x, длина записи %d — пропуск\n", ver, hdr);
+			return;
+		}
+		was = nvkm_rd32(device, 0x022680);
+		nvkm_wr32(device, 0x022680, 0x80000000 | nvbios_rd08(bios, data + 0x0c));
+		nvkm_info(subdev, "LAB nv_22680: уровень %02x: 0x022680 %08x -> %08x (байт 0x0c записи VBIOS)\n",
+			  pstate->pstate, was, nvkm_rd32(device, 0x022680));
+		return;
+	}
