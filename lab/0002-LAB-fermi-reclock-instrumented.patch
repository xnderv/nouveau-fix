+/* оценка размера скрипта в словах memx (как memx_cmd склеивает команды) */
+struct lab_est { u32 m, sz, total; };
+static void
+lab_est_cmd(struct lab_est *e, u32 m, u32 size)
+{
+	if (e->sz + size >= 64 || (e->m && e->m != m)) {
+		if (e->m)
+			e->total += 1 + e->sz;
+		e->m = 0;
+		e->sz = 0;
+	}
+	e->sz += size;
+	e->m = m;
+}
