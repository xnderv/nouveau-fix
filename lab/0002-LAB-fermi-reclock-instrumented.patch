+static uint lab_therm_wait = 1;	/* 24.10: по умолчанию — по признаку (тесты 16, 17) */
+module_param(lab_therm_wait, uint, 0644);
+MODULE_PARM_DESC(lab_therm_wait, "LAB: wait for FSRM_STATUS engaged flag (bit17 + CUR_DIV == code) instead of a fixed delay (0 off, 1 on)");
+static uint lab_therm_wait_us;
+module_param(lab_therm_wait_us, uint, 0644);
+MODULE_PARM_DESC(lab_therm_wait_us, "LAB: extra margin after the FSRM engaged flag, us (0 = none)");
