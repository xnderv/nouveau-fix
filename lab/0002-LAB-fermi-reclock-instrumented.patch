+static uint lab_mem_replay;
+module_param(lab_mem_replay, uint, 0644);
+MODULE_PARM_DESC(lab_mem_replay, "LAB: replay NVIDIA PMU memory scripts: bit0 135->324 (A), bit1 324->2004 (B), bit2 2004->324 (C+D), bit3 324->135 (D+E), bit4 also 0xe104 writes, bit5 raw NVIDIA 0x611200 values");
+
+struct lab_step {
+	const char *name;
+	const u32 *pre; int npre;	/* пары адрес/значение, прямые записи до скрипта */
+	const u32 *scr; int nscr;	/* слова скрипта PMU NVIDIA */
+	const u32 *post; int npost;	/* пары, прямые записи после скрипта */
+	u32 need;			/* бит lab_mem_replay, разрешающий шаг */
+};
+enum { LAB_S_A, LAB_S_B, LAB_S_C, LAB_S_DC, LAB_S_D, LAB_S_E };
+static const struct lab_step lab_steps[] = {
+	[LAB_S_A]  = { "A 135->324", lab_nv_preA, ARRAY_SIZE(lab_nv_preA), lab_nv_scrA, ARRAY_SIZE(lab_nv_scrA), NULL, 0, 1 },
+	[LAB_S_B]  = { "B 324->2004", lab_nv_midAB, ARRAY_SIZE(lab_nv_midAB), lab_nv_scrB, ARRAY_SIZE(lab_nv_scrB), lab_nv_postB, ARRAY_SIZE(lab_nv_postB), 2 },
+	[LAB_S_C]  = { "C 2004->324", lab_nv_preC, ARRAY_SIZE(lab_nv_preC), lab_nv_scrC, ARRAY_SIZE(lab_nv_scrC), NULL, 0, 4 },
+	[LAB_S_DC] = { "D 324 retrain (after C)", lab_nv_midCD, ARRAY_SIZE(lab_nv_midCD), lab_nv_scrD, ARRAY_SIZE(lab_nv_scrD), lab_nv_postD, ARRAY_SIZE(lab_nv_postD), 4 },
+	[LAB_S_D]  = { "D 324 retrain", NULL, 0, lab_nv_scrD, ARRAY_SIZE(lab_nv_scrD), NULL, 0, 8 },
+	[LAB_S_E]  = { "E 324->135", NULL, 0, lab_nv_scrE, ARRAY_SIZE(lab_nv_scrE), NULL, 0, 8 },
+};
+/* операция 0x13 (только в шаге E, аргумент 1000): пауза = аргумент × lab_mem_op13 нс.
+ * 1000 — считать аргумент микросекундами (1 мс, как было в v10), 1 — наносекундами (1 мкс). */
+static uint lab_mem_op13 = 1000;
+module_param(lab_mem_op13, uint, 0644);
+MODULE_PARM_DESC(lab_mem_op13, "LAB: NVIDIA op 0x13 delay multiplier (arg*N ns): 1000 = treat as us (v10), 1 = treat as ns");
+/* LAB 22.10: операция NVIDIA 0x34 (арг. 0x0a — сразу после паузы вывода 0x611200 и ПЕРЕД остановом доступа
+ * к видеопамяти; 0x0b — после снятия останова, перед возвратом 0x611200). Смысл неизвестен; гипотеза: ожидание,
+ * пока вывод изображения остановится. nouveau для предыдущего поколения (gt215) в этом же месте ждёт
+ * «0x611200 & 3 == 0» (биты 0–1 — состояние, биты 4–5 — управление). 0 — пропускать (как было),
+ * 1 — при 0x0a ждать 0x611200 & 3 == 0 (до 2 мс), 0x0b по-прежнему пропускать. */
+static uint lab_mem_op34;
+module_param(lab_mem_op34, uint, 0644);
+MODULE_PARM_DESC(lab_mem_op34, "LAB: NVIDIA op 0x34 0x0a: 0 skip, 1 wait 0x611200&3==0 after display pause (gt215-style)");
+/* LAB 23.10: операция NVIDIA 0x3a N — в скриптах всегда сразу после записи 0x13d8f4 <= 0 (сброс буфера записи
+ * разделов памяти, по twilight0: _nv031754rm, 0x13d7f4 + (раздел << 6)) и ПЕРЕД записями вне 0x10fxxx (делители,
+ * PLL). До 23.10 пропускалась. Три зависания 23.10 (GR встаёт на 100 % сразу после подъёма памяти под нагрузкой,
+ * без ловушек и ошибок) — кандидат: PLL переключается, пока записи в PHY ещё стоят в буферах разделов.
+ * 0 — пропускать; 1 — одно чтение 0x13d8f4 (барьер для отложенных записей); 2 — ждать 0x13d8f4 == 0 (до 1 мс). */
+static uint lab_mem_op3a;
+module_param(lab_mem_op3a, uint, 0644);
+MODULE_PARM_DESC(lab_mem_op3a, "LAB: NVIDIA op 0x3a (partition write-buffer flush wait): 0 skip, 1 read-back 0x13d8f4, 2 wait 0x13d8f4==0");
+static int lab_plan[6], lab_plan_n, lab_plan_i;
+static bool lab_armed;
+static u32 lab_rp611;
+
+static int
+lab_cur_mhz(struct nvkm_device *device)
+{
+	if (nvkm_rd32(device, 0x1373f0) & 0x00000002)
+		return 2004;
+	return 3240 / (((nvkm_rd32(device, 0x137310) >> 8) & 0x3f) + 2);
+}
+
+static u32
+lab_611200_val(u32 nv)
+{
+	if (lab_mem_replay & 32)
+		return nv;
+	return (nv & 0x30) ? lab_rp611 : (lab_rp611 & ~0x00000030);
+}
+
+/* оценка размера скрипта в словах memx (как memx_cmd склеивает команды) */
+struct lab_est { u32 m, sz, total; };
+static void
+lab_est_cmd(struct lab_est *e, u32 m, u32 size)
+{
+	if (e->sz + size >= 64 || (e->m && e->m != m)) {
+		if (e->m)
+			e->total += 1 + e->sz;
+		e->m = 0;
+		e->sz = 0;
+	}
+	e->sz += size;
+	e->m = m;
+}
+
+/* build=false — только проверить и посчитать; build=true — записать в memx */
+static int
+lab_interp(struct nvkm_subdev *subdev, struct nvkm_memx *memx, const struct lab_step *st,
+	   bool build, u32 *words)
+{
+	struct lab_est e = {};
+	u32 waddr = 0, wval = 0, i = 0, nwr = 0, nwait = 0, ndel = 0, nskip = 0;
+	bool blocked = false;
+
+	while (i < st->nscr) {
+		u32 h = st->scr[i], n = h >> 16, op = h & 0xffff, k;
+		const u32 *a = &st->scr[i + 1];
+
+		if (n == 0 || i + n > st->nscr) {
+			nvkm_error(subdev, "LAB replay %s: сбой разбора на слове %u (%08x)\n", st->name, i, h);
+			return -EINVAL;
+		}
+		switch (op) {
+		case 0x21:
+			for (k = 0; k + 1 < n - 1; k += 2) {
+				u32 addr = a[k], data = a[k + 1];
+
+				if (addr == 0x611200)
+					data = lab_611200_val(data);
+				if (build)
+					nvkm_memx_wr32(memx, addr, data);
+				lab_est_cmd(&e, 3, 2);
+				nwr++;
+			}
+			break;
+		case 0x2e:
+			if (build)
+				nvkm_memx_nsec(memx, a[0]);
+			lab_est_cmd(&e, 5, 1);
+			ndel++;
+			break;
+		case 0x13:	/* только в шаге E, аргумент 1000; смысл не известен — берём ДЛИННУЮ паузу (мкс) */
+			if (build)
+				nvkm_memx_nsec(memx, a[0] * lab_mem_op13);
+			lab_est_cmd(&e, 5, 1);
+			ndel++;
+			break;
+		case 0x00:
+			wval = a[0];
+			break;
+		case 0x01:
+			waddr = a[0];
+			break;
+		case 0x15:
+			if (build)
+				nvkm_memx_wait(memx, waddr, a[0], wval, a[1]);
+			lab_est_cmd(&e, 4, 4);
+			nwait++;
+			break;
+		case 0x14:
+			if (a[0] == 0) {	/* одно ожидание кадра на пару NVIDIA (голова 0 + голова 1) */
+				if (build)
+					nvkm_memx_wait_vblank(memx);
+				lab_est_cmd(&e, 6, 1);
+				e.total += 1 + e.sz;
+				e.m = 0;
+				e.sz = 0;
+			}
+			break;
+		case 0x20:
+			if (a[0] == 1 && !blocked) {
+				if (build)
+					nvkm_memx_block(memx);
+				lab_est_cmd(&e, 1, 0);
+				blocked = true;
+			} else if (a[0] == 0 && blocked) {
+				if (build)
+					nvkm_memx_unblock(memx);
+				lab_est_cmd(&e, 2, 0);
+				blocked = false;
+			}
+			break;
+		case 0x16:
+			i = st->nscr;
+			continue;
+		case 0x34:
+			if (lab_mem_op34 && a[0] == 0x0a) {
+				if (build)
+					nvkm_memx_wait(memx, 0x611200, 0x00000003, 0x00000000, 2000000);
+				lab_est_cmd(&e, 4, 4);
+				nwait++;
+				break;
+			}
+			nskip++;
+			break;
+		case 0x3a:
+			if (lab_mem_op3a) {
+				if (build)
+					nvkm_memx_wait(memx, 0x13d8f4, lab_mem_op3a >= 2 ? 0xffffffff : 0x00000000, 0x00000000, 1000000);
+				lab_est_cmd(&e, 4, 4);
+				nwait++;
+				break;
+			}
+			nskip++;
+			break;
+		case 0x39:
+			nskip++;
+			break;
+		default:
+			nvkm_error(subdev, "LAB replay %s: неизвестная операция %04x\n", st->name, op);
+			return -EINVAL;
+		}
+		i += n;
+	}
+	if (blocked) {
+		nvkm_error(subdev, "LAB replay %s: скрипт не снимает останов видеопамяти\n", st->name);
+		return -EINVAL;
+	}
+	if (e.m)
+		e.total += 1 + e.sz;
+	*words = e.total;
+	if (build)
+		nvkm_info(subdev, "LAB replay %s: в memx %u записей, %u ожиданий, %u пауз, пропущено %u операций, ~%u слов\n",
+			  st->name, nwr, nwait, ndel, nskip, e.total);
+	return 0;
+}
+
+static int
+lab_replay_calc(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct lab_step *st;
+	u32 words;
+	int ret, i;
+
+	if (lab_plan_i >= lab_plan_n) {
+		int cur = lab_cur_mhz(device), t = freq / 1000, tgt;
+
+		lab_plan_n = lab_plan_i = 0;
+		tgt = (t <= 200) ? 135 : (t < 1000) ? 324 : 2004;
+		if (abs(t - tgt) > 5) {
+			nvkm_error(subdev, "LAB replay: цель %d МГц не из записи (135/324/2004)\n", t);
+			return -EINVAL;
+		}
+		if (cur == 135 && tgt == 324) {
+			lab_plan[lab_plan_n++] = LAB_S_A;
+		} else if (cur == 324 && tgt == 2004) {
+			lab_plan[lab_plan_n++] = LAB_S_B;
+		} else if (cur == 135 && tgt == 2004) {
+			lab_plan[lab_plan_n++] = LAB_S_A;
+			lab_plan[lab_plan_n++] = LAB_S_B;
+		} else if (cur == 2004 && tgt == 324) {
+			lab_plan[lab_plan_n++] = LAB_S_C;
+			lab_plan[lab_plan_n++] = LAB_S_DC;
+		} else if (cur == 324 && tgt == 135) {
+			lab_plan[lab_plan_n++] = LAB_S_D;
+			lab_plan[lab_plan_n++] = LAB_S_E;
+		} else if (cur == 2004 && tgt == 135) {
+			lab_plan[lab_plan_n++] = LAB_S_C;
+			lab_plan[lab_plan_n++] = LAB_S_DC;
+			lab_plan[lab_plan_n++] = LAB_S_D;
+			lab_plan[lab_plan_n++] = LAB_S_E;
+		} else if (cur != tgt) {
+			nvkm_error(subdev, "LAB replay: нет пути %d -> %d МГц\n", cur, tgt);
+			return -EINVAL;
+		}
+		nvkm_info(subdev, "LAB replay: память сейчас %d МГц, цель %d МГц, шагов %d (lab_mem_replay=%u)\n",
+			  cur, tgt, lab_plan_n, lab_mem_replay);
+		for (i = 0; i < lab_plan_n; i++) {
+			const struct lab_step *s = &lab_steps[lab_plan[i]];
+
+			if (!(lab_mem_replay & s->need)) {
+				nvkm_error(subdev, "LAB replay: шаг %s не разрешён (нужен бит %u) — память не трогаю\n",
+					   s->name, s->need);
+				lab_plan_n = 0;
+				return -EINVAL;
+			}
+			ret = lab_interp(subdev, NULL, s, false, &words);
+			if (ret || words > 480) {
+				nvkm_error(subdev, "LAB replay: шаг %s не годится (ret %d, %u слов memx)\n",
+					   s->name, ret, words);
+				lab_plan_n = 0;
+				return ret ? ret : -E2BIG;
+			}
+		}
+		if (!lab_plan_n)
+			return 0;	/* уже на месте: prog ничего не делает */
+	}
+
+	st = &lab_steps[lab_plan[lab_plan_i]];
+	lab_rp611 = nvkm_rd32(device, 0x611200);
+	ret = ram_init(&ram->fuc, ram->base.fb);
+	if (ret) {
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	ret = lab_interp(subdev, ram->fuc.base.memx, st, true, &words);
+	if (ret) {
+		ram_exec(&ram->fuc, false);
+		lab_plan_n = lab_plan_i = 0;
+		return ret;
+	}
+	lab_armed = true;
+	return 0;
+}
+
+static void
+lab_host_writes(struct nvkm_subdev *subdev, const char *what, const u32 *l, int n)
+{
+	struct nvkm_device *device = subdev->device;
+	int i, cnt = 0;
+
+	for (i = 0; i + 1 < n; i += 2) {
+		if (l[i] == 0x00e104 && !(lab_mem_replay & 16))
+			continue;
+		nvkm_wr32(device, l[i], l[i + 1]);
+		cnt++;
+	}
+	if (n)
+		nvkm_info(subdev, "LAB replay: прямых записей %s: %d\n", what, cnt);
+}
+
+static int
+lab_replay_prog(struct gf100_ram *ram)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	const struct lab_step *st;
+	ktime_t t0;
+	s64 us;
+	int ret;
+
+	if (!lab_armed)
+		return 0;
+	st = &lab_steps[lab_plan[lab_plan_i]];
+	lab_host_writes(subdev, "до скрипта", st->pre, st->npre);
+	t0 = ktime_get();
+	ret = ram_exec(&ram->fuc, true);
+	us = ktime_us_delta(ktime_get(), t0);
+	lab_armed = false;
