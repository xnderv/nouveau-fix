+MODULE_PARM_DESC(lab_rop_khz, "LAB: override rop target kHz, max 1907000");
+
+/* LAB: если не 0 — PLL ядра получает ровно эти коэффициенты (P<<16 | N<<8 | M), ядро на PLL.
+ * Проверяются пределы из BIOS: M 4-16, N 8-95, P 1-63, опора/M 25-100 МГц, VCO 1000-2000 МГц. */
+static uint lab_gpc_coef;
+module_param(lab_gpc_coef, uint, 0644);
+/* LAB: опора PLL ядра «по гипотезе» для проверки пределов (0 = 405000 из BIOS). При опоре не 405 МГц
+ * разрешено M от 1, остальные пределы те же: вход 25-100 МГц, VCO 1000-2000 МГц. */
+static uint lab_gpc_ref_khz;
+module_param(lab_gpc_ref_khz, uint, 0644);
+MODULE_PARM_DESC(lab_gpc_coef, "LAB: force gpc PLL coefficients (P<<16|N<<8|M), 0 = normal");
+
+static u32
+lab_override(int idx, u32 freq)
+{
+	uint want = 0, cap = 0;
+	switch (idx) {
+	case 0x00: want = lab_gpc_khz;   cap = 1800000; break;
+	case 0x01: want = lab_rop_khz;   cap = 1907000; break;
+	case 0x02: want = lab_hub07_khz; cap = 1907000; break;
+	case 0x07: want = lab_hub06_khz; cap = 1645000; break;
+	case 0x08: want = lab_hub01_khz; cap = 1645000; break;
+	default: return freq;
+	}
+	if (!want)
+		return freq;
+	return min(want, cap);
+}
