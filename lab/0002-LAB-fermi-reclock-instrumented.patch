+static int
+lab_cur_mhz(struct nvkm_device *device)
+{
+	if (nvkm_rd32(device, 0x1373f0) & 0x00000002)
+		return 2004;
+	return 3240 / (((nvkm_rd32(device, 0x137310) >> 8) & 0x3f) + 2);
+}
+
+static u32
+lab_611200_val(u32 nv)
+{
+	if (lab_mem_replay & 32)
+		return nv;
+	return (nv & 0x30) ? lab_rp611 : (lab_rp611 & ~0x00000030);
+}
