--- a/nvkm/subdev/clk/base.c
+++ b/nvkm/subdev/clk/base.c
@@ -280,20 +280,31 @@ nvkm_pstate_prog(struct nvkm_clk *clk, int pstatei)
 	nvkm_debug(subdev, "setting performance state %d\n", pstatei);
 	clk->pstate = pstatei;
 
+	nvkm_info(subdev, "LAB pstate %d: pcie speed %d width %d\n", pstatei, pstate->pcie_speed, pstate->pcie_width);
 	nvkm_pcie_set_link(pci, pstate->pcie_speed, pstate->pcie_width);
+	nvkm_info(subdev, "LAB pstate %d: pcie done\n", pstatei);
 
 	if (fb && fb->ram && fb->ram->func->calc) {
 		struct nvkm_ram *ram = fb->ram;
 		int khz = pstate->base.domain[nv_clk_src_mem];
+		nvkm_info(subdev, "LAB pstate %d: memory -> %d kHz\n", pstatei, khz);
 		do {
 			ret = ram->func->calc(ram, khz);
-			if (ret == 0)
+			nvkm_info(subdev, "LAB ram calc ret %d\n", ret);
+			if (ret == 0) {
 				ret = ram->func->prog(ram);
+				nvkm_info(subdev, "LAB ram prog ret %d\n", ret);
+			}
 		} while (ret > 0);
 		ram->func->tidy(ram);
+	} else {
+		nvkm_info(subdev, "LAB pstate %d: no memory reclock support\n", pstatei);
 	}
 
-	return nvkm_cstate_prog(clk, pstate, NVKM_CLK_CSTATE_HIGHEST);
+	nvkm_info(subdev, "LAB pstate %d: programming core clocks/voltage\n", pstatei);
+	ret = nvkm_cstate_prog(clk, pstate, NVKM_CLK_CSTATE_HIGHEST);
+	nvkm_info(subdev, "LAB pstate %d: done ret %d\n", pstatei, ret);
+	return ret;
 }
 
