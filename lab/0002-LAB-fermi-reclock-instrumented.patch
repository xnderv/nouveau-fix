+static void
+lab_therm_leave(struct gf100_clk *clk, int idx, struct lab_therm_save *sv)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 x2 = (idx == 0) ? 0x00000000 : 0x00000082;
+
+	if (!sv->on)
+		return;
+	nvkm_wr32(device, 0x020160 + sv->i * 4, lab_therm >= 2 ? sv->f2 : x2);
+	nvkm_wr32(device, 0x020180 + sv->i * 4, lab_therm >= 2 ? sv->f3 : 0);
+	nvkm_wr32(device, 0x0201a0 + sv->i * 4, lab_therm >= 2 ? sv->f4 : 0x00004040);
+	nvkm_wr32(device, 0x020004, sv->ctrl1);
+	nvkm_info(&clk->base.subdev, "LAB therm idx %02x (FSRM %d): %s%u мкс; до FSRM2 %08x FSRM3 %08x FSRM4 %08x CTRL1 %08x; после %08x %08x %08x %08x; статус %08x\n",
+		  idx, sv->i, sv->w ? "по признаку, запас " : "выдержка ", sv->w ? lab_therm_wait_us : sv->us,
+		  sv->f2, sv->f3, sv->f4, sv->ctrl1,
+		  nvkm_rd32(device, 0x020160 + sv->i * 4), nvkm_rd32(device, 0x020180 + sv->i * 4),
+		  nvkm_rd32(device, 0x0201a0 + sv->i * 4), nvkm_rd32(device, 0x020004), nvkm_rd32(device, 0x0201e0 + sv->i * 4));
+	if (sv->w)
+		nvkm_info(&clk->base.subdev, "LAB therm wait idx %02x: %s через %u нс (чтений %u, статус %08x), запас %u мкс\n",
+			  idx, sv->wok ? "признак" : "ТАЙМАУТ 100 мкс, признака нет,", sv->wns, sv->wrd, sv->wv, lab_therm_wait_us);
+	if (sv->fx)
+		nvkm_info(&clk->base.subdev, "LAB therm fixed idx %02x: ждал %u нс от входа (задано %u), признак %s%u нс\n",
+			  idx, sv->fxns, sv->fxset, sv->fxok ? "через " : "НЕ поднялся до переключения, ждали ", sv->fxok ? sv->fxflag : sv->fxns);
+	if (lab_therm_probe && !sv->w) {
+		char buf[200];
+		int k, o = 0;
+
+		for (k = 0; k < sv->np && o < (int)sizeof(buf) - 24; k++)
+			o += scnprintf(buf + o, sizeof(buf) - o, " %u нс:%08x", sv->pt[k], sv->pv[k]);
+		nvkm_info(&clk->base.subdev, "LAB therm probe idx %02x: статус сразу после записи %08x, чтений %u, изменений %d:%s\n",
+			  idx, sv->st0, sv->nrd, sv->np, sv->np ? buf : " нет");
+	}
+	sv->on = false;
+}
