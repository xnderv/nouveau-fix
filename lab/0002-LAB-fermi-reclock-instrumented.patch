+MODULE_PARM_DESC(lab_nv_boot, "LAB: at clk init write 0x1371c8/cc = 0x30000 and 0x139060..0x139220 (step 0x40) = 0x74, as the NVIDIA driver does at load (0 off, 1 on)");
+
+static void
+lab_snap_line(struct nvkm_subdev *subdev, int n, const char *name, const u32 *addr, int cnt)
+{
+	char buf[400];
+	int i, o = 0;
+
+	for (i = 0; i < cnt; i++)
+		o += scnprintf(buf + o, sizeof(buf) - o, " %06x=%08x", addr[i], nvkm_rd32(subdev->device, addr[i]));
+	nvkm_info(subdev, "LAB boot snap #%d %s:%s\n", n, name, buf);
+}
