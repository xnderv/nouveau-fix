+/* LAB бит3: опора PLL узлов 3..7 с учётом делителя опоры (nouveau учитывает его только для 0..2) */
+static u32
+lab_pll_ref(struct gf100_clk *clk, int idx)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	u32 ssrc = nvkm_rd32(device, 0x137120 + idx * 4);
+	u32 sctl, sdiv = 2;
+
+	if ((ssrc & 0x00000003) != 3)
+		return 0;
+	sctl = nvkm_rd32(device, 0x137140 + idx * 4);
+	if (sctl & 0x80000000) {
+		if (ssrc & 0x100)
+			sctl >>= 8;
+		sdiv = (sctl & 0x3f) + 2;
+	}
+	return (read_vco(clk, 0x137120 + idx * 4) * 2) / sdiv;
+}
