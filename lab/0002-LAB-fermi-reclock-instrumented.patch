+/* LAB: manual target frequencies (kHz) for any pstate switch; 0 = take from VBIOS table.
+ * Capped at the card's own pstate 0f values, so this can never overclock. */
+static uint lab_gpc_khz, lab_rop_khz, lab_hub07_khz, lab_hub06_khz, lab_hub01_khz;
+module_param(lab_gpc_khz, uint, 0644);
+module_param(lab_rop_khz, uint, 0644);
+module_param(lab_hub07_khz, uint, 0644);
+module_param(lab_hub06_khz, uint, 0644);
