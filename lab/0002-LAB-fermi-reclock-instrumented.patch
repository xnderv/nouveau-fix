+/* операция 0x13 (только в шаге E, аргумент 1000): пауза = аргумент × lab_mem_op13 нс.
+ * 1000 — считать аргумент микросекундами (1 мс, как было в v10), 1 — наносекундами (1 мкс). */
+static uint lab_mem_op13 = 1000;
+module_param(lab_mem_op13, uint, 0644);
+MODULE_PARM_DESC(lab_mem_op13, "LAB: NVIDIA op 0x13 delay multiplier (arg*N ns): 1000 = treat as us (v10), 1 = treat as ns");
+/* LAB 22.10: операция NVIDIA 0x34 (арг. 0x0a — сразу после паузы вывода 0x611200 и ПЕРЕД остановом доступа
+ * к видеопамяти; 0x0b — после снятия останова, перед возвратом 0x611200). Смысл неизвестен; гипотеза: ожидание,
+ * пока вывод изображения остановится. nouveau для предыдущего поколения (gt215) в этом же месте ждёт
+ * «0x611200 & 3 == 0» (биты 0–1 — состояние, биты 4–5 — управление). 0 — пропускать (как было),
+ * 1 — при 0x0a ждать 0x611200 & 3 == 0 (до 2 мс), 0x0b по-прежнему пропускать. */
+static uint lab_mem_op34;
+module_param(lab_mem_op34, uint, 0644);
+MODULE_PARM_DESC(lab_mem_op34, "LAB: NVIDIA op 0x34 0x0a: 0 skip, 1 wait 0x611200&3==0 after display pause (gt215-style)");
+/* LAB 23.10: операция NVIDIA 0x3a N — в скриптах всегда сразу после записи 0x13d8f4 <= 0 (сброс буфера записи
+ * разделов памяти, по twilight0: _nv031754rm, 0x13d7f4 + (раздел << 6)) и ПЕРЕД записями вне 0x10fxxx (делители,
+ * PLL). До 23.10 пропускалась. Три зависания 23.10 (GR встаёт на 100 % сразу после подъёма памяти под нагрузкой,
+ * без ловушек и ошибок) — кандидат: PLL переключается, пока записи в PHY ещё стоят в буферах разделов.
+ * 0 — пропускать; 1 — одно чтение 0x13d8f4 (барьер для отложенных записей); 2 — ждать 0x13d8f4 == 0 (до 1 мс). */
+static uint lab_mem_op3a;
+module_param(lab_mem_op3a, uint, 0644);
+MODULE_PARM_DESC(lab_mem_op3a, "LAB: NVIDIA op 0x3a (partition write-buffer flush wait): 0 skip, 1 read-back 0x13d8f4, 2 wait 0x13d8f4==0");
