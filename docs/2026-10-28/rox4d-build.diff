+	} else if (cur == 324 && tgt == 2004) {
+		p[n++] = LAB_S_B;
+	} else if (cur == 135 && tgt == 2004) {
+		p[n++] = LAB_S_A;
+		p[n++] = LAB_S_B;
+	} else if (cur == 2004 && tgt == 324) {
+		p[n++] = LAB_S_C;
+		p[n++] = LAB_S_DC;
+	} else if (cur == 324 && tgt == 135) {
+		p[n++] = LAB_S_D;
+		p[n++] = LAB_S_E;
+	} else if (cur == 2004 && tgt == 135) {
+		p[n++] = LAB_S_C;
+		p[n++] = LAB_S_DC;
+		p[n++] = LAB_S_D;
+		p[n++] = LAB_S_E;
