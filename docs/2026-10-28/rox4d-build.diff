+	struct nvkm_device *device = subdev->device;
+	struct nvkm_device_pci *pci = device->func->pci ? device->func->pci(device) : NULL;
+	u16 sv = pci ? pci->pdev->subsystem_vendor : 0, sd = pci ? pci->pdev->subsystem_device : 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(lab_boards); i++)
+		if (lab_boards[i].chipset == device->chipset && lab_boards[i].subven == sv && lab_boards[i].subdev == sd)
+			return &lab_boards[i];
+	nvkm_warn(subdev, "LAB: плата не описана (chipset %02x, subsystem %04x:%04x) — повтор скриптов памяти недоступен, ядро можно переключать с lab_mem=0\n",
+		  device->chipset, sv, sd);
+	return NULL;
+}
