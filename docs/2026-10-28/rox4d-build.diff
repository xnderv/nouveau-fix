+/* план шагов GF106 (запись rox4d): состояние памяти различаем по 0x132000 — значения из записи:
+ *   18010002 после POST (324 МГц; в записи отсюда только подъём Bboot на 1804),
+ *   18000101 после Bboot и 18010101 после B (1804; первый спуск после Bboot — C1, иначе C),
+ *   18030000 после C/C1 (324; дальше в записи только E1+E2 на 135), 18010000 после E2 (135; дальше B).
+ * Переходов 324 -> 1804 (кроме Bboot) и 135 -> 324 в записи нет: идём известными шагами через 135 / через 1804. */
+static int
+lab_plan_gf106(struct nvkm_subdev *subdev, const struct lab_board *b, int cur, int tgt, int *p)
+{
+	u32 st = nvkm_rd32(subdev->device, 0x132000);
+	int n = 0;
+
+	if (cur == tgt)
+		return 0;
+	if (cur == b->hi) {
+		if (st == 0x18000101)
+			p[n++] = LAB_G6_C1;
+		else if (st == 0x18010101)
+			p[n++] = LAB_G6_C;
+		else
+			goto unknown;
+		if (tgt == b->lo) {
+			p[n++] = LAB_G6_E1;
+			p[n++] = LAB_G6_E2;
+		}
+	} else if (cur == b->mid) {
+		if (st == 0x18010002) {
+			if (tgt != b->hi) {
+				nvkm_error(subdev, "LAB replay: из состояния после POST (0x132000=%08x) в записи есть только переход на 0f\n", st);
+				return -EINVAL;
+			}
+			p[n++] = LAB_G6_BBOOT;
+		} else if (st == 0x18030000) {
+			p[n++] = LAB_G6_E1;
+			p[n++] = LAB_G6_E2;
+			if (tgt == b->hi)
+				p[n++] = LAB_G6_B;
+		} else {
+			goto unknown;
+		}
+	} else {
+		if (st != 0x18010000)
+			goto unknown;
+		p[n++] = LAB_G6_B;
+		if (tgt == b->mid)
+			p[n++] = LAB_G6_C;
+	}
+	return n;
+unknown:
+	nvkm_error(subdev, "LAB replay: память %d МГц при 0x132000=%08x — состояние не из записи, память не трогаю\n", cur, st);
+	return -EINVAL;
+}
