+/* LAB 30.10 (сверка по базе: 32 платы, 9 чипов Fermi, docs/2026-10-30/db-core-check.md): источник узла — по флагу частоты
+ * в записи уровня VBIOS (биты 14–15 подзаписи; nouveau их отбрасывает): 1 → PLL, 2 → делитель, 0 → делитель, если он в окне
+ * −2…+3 МГц от таблицы (правило nouveau gt215), иначе PLL. Только GPC, ROP, hubk07, hubk06 и hubk01 (он — на PLL hubk06,
+ * если hubk06 на этом уровне на PLL). Основной делитель GPC — на частоту самого высокого уровня на делителях (у нас
+ * 07 = 810, у GF108 405, у GF119 540), ниже — пост-делителем от него; если так не попасть в окно — обычный путь nouveau.
+ * Коэффициенты PLL GPC — из равноценных решений наибольшее M, как NVIDIA 304+ / 390 (у ROP, hubk07, hubk06 — как nouveau).
+ * На нашей плате значения те же, что с lab_gpc_div=1; lab_gpc_div при включённом ключе не действует. */
+static uint lab_vbios_src;
+module_param(lab_vbios_src, uint, 0644);
+MODULE_PARM_DESC(lab_vbios_src, "LAB: node source from the VBIOS perf-entry flag (bits 14-15: 1 PLL, 2 divider, 0 divider within -2..+3 MHz else PLL), GPC main divider on the highest divider level (0 off, 1 on)");
+
+static struct nvkm_pstate *
+lab_cstate_pstate(struct gf100_clk *clk, struct nvkm_cstate *cstate)
+{
+	struct nvkm_pstate *pstate;
+	struct nvkm_cstate *c;
+
+	list_for_each_entry(pstate, &clk->base.states, head) {
+		if (&pstate->base == cstate)
+			return pstate;
+		list_for_each_entry(c, &pstate->list, head) {
+			if (c == cstate)
+				return pstate;
+		}
+	}
+	return NULL;
+}
+
+/* флаг частоты узла dom на уровне level (биты 14–15 подзаписи); -1 — нет таблицы, уровня или подзаписи */
+static int
+lab_perf_flag(struct gf100_clk *clk, u8 level, int dom)
+{
+	struct nvkm_bios *bios = clk->base.subdev.device->bios;
+	const struct nvkm_domain *d;
+	struct nvbios_perfE perfE;
+	u8 ver, hdr, cnt, len, sver, shdr;
+	u32 data, sdata;
+	int i = 0;
+
+	for (d = clk->base.domains; d->name != nv_clk_src_max; d++) {
+		if (d->name == dom)
+			break;
+	}
+	if (d->name == nv_clk_src_max || d->bios == 0xff)
+		return -1;
+	while ((data = nvbios_perfEp(bios, i++, &ver, &hdr, &cnt, &len, &perfE))) {
+		if (perfE.pstate != level)
+			continue;
+		sver = ver;
+		shdr = hdr;
+		sdata = nvbios_perfSe(bios, data, d->bios, &sver, &shdr, cnt, len);
+		if (ver != 0x40 || !sdata)
+			return -1;
+		return nvbios_rd16(bios, sdata) >> 14;
+	}
+	return -1;
+}
+
+static bool
+lab_in_window(u32 want, u32 got)
+{
+	int diff = (int)want - (int)got;
+
+	return diff >= -2000 && diff < 3000;
+}
+
+/* частота GPC самого высокого уровня, который идёт на делителе (флаг 2, или 0 и делитель в окне) — на неё ставится
+ * основной делитель GPC; 0 — такого уровня нет */
+static u32
+lab_gpc_base(struct gf100_clk *clk, int dom, u32 vco)
+{
+	struct nvkm_pstate *pstate;
+	u32 base = 0, div;
+
+	list_for_each_entry(pstate, &clk->base.states, head) {
+		u32 f = pstate->base.domain[dom];
+		int flag;
+
+		if (!f || f > vco || f <= base)
+			continue;
+		flag = lab_perf_flag(clk, pstate->pstate, dom);
+		if (flag == 2 || (flag == 0 && lab_in_window(f, calc_div(clk, 0, vco, f, &div))))
+			base = f;
+	}
+	return base;
+}
+
+/* LAB 30.10: как gt215_pll_calc, но из равноценных решений берёт наибольшее M — так PLL GPC считает NVIDIA 304+ / 390
+ * (сверка по базе с эпохой по независимым признакам: 18 из 18 записей 304+; в 270.x и у ROP/hubk07 — наименьшее M, как
+ * nouveau). Частота у обоих вариантов одна. */
+static int
+lab_pll_calc_maxm(struct nvbios_pll *info, u32 freq, int *pN, int *pM, int *pP)
+{
+	u32 best_err = ~0, err;
+	int M, lM, hM, N, P;
+
+	P = info->vco1.max_freq / freq;
+	if (P > info->max_p)
+		P = info->max_p;
+	if (P < info->min_p)
+		P = info->min_p;
+
+	lM = (info->refclk + info->vco1.max_inputfreq) / info->vco1.max_inputfreq;
+	lM = max(lM, (int)info->vco1.min_m);
+	hM = (info->refclk + info->vco1.min_inputfreq) / info->vco1.min_inputfreq;
+	hM = min(hM, (int)info->vco1.max_m);
+	lM = min(lM, hM);
+
+	for (M = lM; M <= hM; M++) {
+		u32 tmp = freq * P * M;
+
+		N = tmp / info->refclk;
+		if (tmp % info->refclk >= info->refclk / 2)
+			N++;
+		if (N < info->vco1.min_n)
+			continue;
+		if (N > info->vco1.max_n)
+			break;
+
+		err = abs(freq - (info->refclk * N / M / P));
+		if (err <= best_err) {		/* <=: из равных остаётся последнее, то есть наибольшее M */
+			best_err = err;
+			*pN = N;
+			*pM = M;
+		}
+	}
+
+	if (best_err == ~0)
+		return -EINVAL;
+	*pP = P;
+	return info->refclk * *pN / *pM / P;
+}
+
+static u32
+lab_calc_pll_gpc(struct gf100_clk *clk, u32 freq, u32 *coef)
+{
+	struct nvkm_bios *bios = clk->base.subdev.device->bios;
+	struct nvbios_pll limits;
+	int N, M, P, ret;
+
+	if (nvbios_pll_parse(bios, 0x137000, &limits))
+		return 0;
+	limits.refclk = read_div(clk, 0, 0x137120, 0x137140);
+	if (!limits.refclk)
+		return 0;
+	ret = lab_pll_calc_maxm(&limits, freq, &N, &M, &P);
+	if (ret <= 0)
+		return 0;
+	*coef = (P << 16) | (N << 8) | M;
+	return ret;
+}
+
+/* идёт ли hubk06 на этом уровне на PLL по тому же правилу (флаг 1, или 0 и делитель не в окне) — тогда hubk01 может ехать
+ * на его PLL (GF117 у4: у hubk06 флаг 0, 1100 делителем не достать — NVIDIA ставит обоих на PLL) */
+static bool
+lab_hub06_pll(struct gf100_clk *clk, struct nvkm_cstate *cstate, u8 level)
+{
+	int flag = lab_perf_flag(clk, level, nv_clk_src_hubk06);
+	u32 f = cstate->domain[nv_clk_src_hubk06], div;
+
+	if (flag == 1)
+		return true;
+	return flag == 0 && f && !lab_in_window(f, calc_div(clk, 7, read_vco(clk, 0x137160 + (7 * 4)), f, &div));
+}
+
+static int
+lab_calc_vbios(struct gf100_clk *clk, struct nvkm_cstate *cstate, int idx, int dom, u32 freq, u8 level, int flag)
+{
+	struct gf100_clk_info *info = &clk->eng[idx];
+	u32 vco = read_vco(clk, 0x137160 + (idx * 4));
+	u32 src0 = 0, div0 = 0, div1D = 0, div1P = 0, clk0 = 0, clk1 = 0, coef = 0, base = 0;
+	bool pll, use_pll;
+
+	/* путь делителя: у GPC основной делитель — на частоту самого высокого уровня на делителях, остаток — пост-делителем */
+	if (idx == 0x00 && vco)
+		base = lab_gpc_base(clk, dom, vco);
+	if (base) {
+		src0 = 0x00000003;
+		clk0 = calc_div(clk, idx, vco, base, &div0);
+		clk0 = calc_div(clk, idx, clk0, freq, &div1D);
+		if (!lab_in_window(freq, clk0))
+			base = 0;
+	}
+	if (!base) {
+		div0 = div1D = 0;
+		clk0 = calc_src(clk, idx, freq, &src0, &div0);
+		clk0 = calc_div(clk, idx, clk0, freq, &div1D);
+	}
+
+	/* путь PLL: свой PLL у GPC, ROP, hubk07, hubk06; hubk01 — на PLL hubk06, только если hubk06 на этом уровне на PLL */
+	pll = idx <= 0x02 || idx == 0x07 || (idx == 0x08 && lab_hub06_pll(clk, cstate, level));
+	if (pll) {
+		if (idx == 0x00)
+			clk1 = lab_calc_pll_gpc(clk, freq, &coef);	/* GPC: наибольшее M, как NVIDIA 304+ / 390 */
+		else if (idx <= 0x07)
+			clk1 = calc_pll(clk, idx, freq, &coef);
+		else
+			clk1 = (lab_eng_mask & (1u << 0x07)) ?
+			       lab_override(0x07, cstate->domain[nv_clk_src_hubk06]) :
+			       read_clk(clk, 0x07);
+		if (clk1)
+			clk1 = calc_div(clk, idx, clk1, freq, &div1P);
+	}
+
+	switch (flag) {
+	case 1:
+		use_pll = clk1 != 0;
+		break;
+	case 2:
+		use_pll = false;
+		break;
+	default:
+		use_pll = clk1 && !lab_in_window(freq, clk0);
+		break;
+	}
+
+	if (use_pll) {
+		info->dsrc = info->ddiv = 0;
+		info->mdiv = div1P ? (0x80000000 | (div1P << 8)) : 0;
+		info->coef = coef;
+		info->ssel = 1 << idx;
+		info->freq = clk1;
+	} else {
+		info->dsrc = src0;
+		info->ddiv = div0 ? (0x80000000 | (div0 << 8) | div0) : 0;
+		info->mdiv = div1D ? (0x80000000 | div1D) : 0;
+		info->ssel = info->coef = 0;
+		info->freq = clk0;
+	}
+
+	if (lab_nv_divb && idx <= 0x02 && (info->ddiv & 0x80000000))
+		lab_divb(clk, idx, dom);
+	lab_divb_force_apply(clk, idx);
+	nvkm_info(&clk->base.subdev, "LAB calc idx %02x dom %d: want %u got %u ssel %08x coef %08x dsrc %08x ddiv %08x mdiv %08x (lab_vbios_src: уровень %02x, флаг %d%s%s)\n",
+		  idx, dom, freq, info->freq, info->ssel, info->coef, info->dsrc, info->ddiv, info->mdiv, level, flag,
+		  base ? ", основной делитель от уровня на делителях" : "", (flag == 1 && !use_pll) ? ", PLL не рассчитан — делитель" : "");
+	return 0;
+}
